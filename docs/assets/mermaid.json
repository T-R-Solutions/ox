{
  "startOnLoad": false,
  "securityLevel": "strict",
  "theme": "base",
  "fontFamily": "Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#eef2ff",
    "primaryTextColor": "#172554",
    "primaryBorderColor": "#4f46e5",
    "lineColor": "#475569",
    "secondaryColor": "#f0fdfa",
    "secondaryTextColor": "#134e4a",
    "secondaryBorderColor": "#0f766e",
    "tertiaryColor": "#f8fafc",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#64748b",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#eef2ff",
    "actorBorder": "#4f46e5",
    "actorTextColor": "#172554",
    "signalColor": "#334155",
    "signalTextColor": "#172554",
    "noteBkgColor": "#f0fdfa",
    "noteTextColor": "#134e4a",
    "noteBorderColor": "#0f766e"
  },
  "flowchart": {"htmlLabels": false, "curve": "linear", "nodeSpacing": 32, "rankSpacing": 40, "padding": 20},
  "sequence": {"useMaxWidth": true, "wrap": true, "actorMargin": 36, "width": 150, "messageMargin": 36}
}
