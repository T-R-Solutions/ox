{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shared-toolbox:consumer:1",
  "title": "Shared Toolbox consumer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "tools"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "root": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "secrets",
          "python",
          "shell",
          "filesystem",
          "sbom",
          "sast",
          "dependencies",
          "content",
          "web-api",
          "web-ui"
        ]
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bandit": {
          "$ref": "#/$defs/tool"
        },
        "gitleaks": {
          "$ref": "#/$defs/tool"
        },
        "grype": {
          "$ref": "#/$defs/tool"
        },
        "opengrep": {
          "$ref": "#/$defs/tool"
        },
        "osv-scanner": {
          "$ref": "#/$defs/tool"
        },
        "playwright": {
          "$ref": "#/$defs/tool"
        },
        "ruff": {
          "$ref": "#/$defs/tool"
        },
        "shellcheck": {
          "$ref": "#/$defs/tool"
        },
        "syft": {
          "$ref": "#/$defs/tool"
        },
        "trivy": {
          "$ref": "#/$defs/tool"
        },
        "yara-x": {
          "$ref": "#/$defs/tool"
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "variant": {
          "enum": [
            "api",
            "chromium",
            "firefox",
            "webkit"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "enum": [
            "files",
            "history",
            "scan",
            "test"
          ]
        },
        "network": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "database": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_database_age_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "BASE_URL": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$comment": "toolbox validate also checks catalog versions, filesystem paths, profile completeness and tool-specific constraints."
}
