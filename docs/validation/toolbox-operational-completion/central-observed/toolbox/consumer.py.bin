"""Public consumer entry; shell contains discovery only, never scanner logic."""
import argparse
import hashlib
import re
from pathlib import Path

from .config import ConfigError, REPO, load, object_keys, read_json


WRAPPER = REPO / 'templates/consumer/scripts/toolbox.sh'
COMMANDS = ('doctor', 'catalog', 'validate', 'plan', 'versions', 'prepare',
            'update-db', 'run', 'results')


def capabilities():
    return {
        'contract': 'stic', 'version': '1.0', 'status': 'partial-implementation',
        'capabilities': ['consumer-cli-v1', *COMMANDS],
        'config_schemas': [1], 'result_schemas': [1], 'layout_versions': [1],
        'wrapper': {'version': '1.0.0',
                    'sha256': hashlib.sha256(WRAPPER.read_bytes()).hexdigest()},
        'unavailable': ['config-v2', 'suppression-policy-v2', 'layout-v2',
                        'export', 'staging-manifest-v1'],
    }


def integration_config(path):
    path = Path(path)
    if path.is_symlink():
        raise ConfigError('integration: symlink not allowed')
    path = path.resolve()
    data = read_json(path)
    object_keys(data, ['contract', 'version', 'stacks', 'required_capabilities',
                       'toolbox_config'], 'integration')
    if data.get('contract') != 'stic' or data.get('version') != '1.0':
        raise ConfigError('integration: supported contract is stic 1.0')
    for field in ('stacks', 'required_capabilities'):
        values = data.get(field)
        if not isinstance(values, list) or not values or any(
                not isinstance(value, str) or not re.fullmatch(r'[a-z0-9][a-z0-9_-]*', value)
                for value in values):
            raise ConfigError(f'integration.{field}: expected nonempty identifier array')
        if len(set(values)) != len(values):
            raise ConfigError(f'integration.{field}: duplicate identifier')
    missing = set(data['required_capabilities']) - set(capabilities()['capabilities'])
    if missing:
        raise ConfigError(f'integration: unavailable capabilities: {sorted(missing)}')
    # The canonical adjacent file prevents accidentally selecting another consumer.
    if data.get('toolbox_config') != 'toolbox.json':
        raise ConfigError('integration.toolbox_config: expected toolbox.json')
    config = path.parent / 'toolbox.json'
    if config.is_symlink() or not config.is_file():
        raise ConfigError('integration: adjacent toolbox.json must be a regular file')
    return config


def consumer_arguments(integration, arguments):
    """Return validated public CLI argv; never perform maintenance here."""
    parser = argparse.ArgumentParser(
        prog='scripts/toolbox.sh',
        description='Shared Toolbox consumer entry. Bash 4.4+. No implicit installation. '
                    'prepare/update-db are explicit maintenance; layout 2/export unavailable.',
        allow_abbrev=False)
    sub = parser.add_subparsers(dest='command', required=True)
    for command in COMMANDS:
        command_parser = sub.add_parser(command, allow_abbrev=False)
        if command in ('plan', 'versions', 'run', 'prepare', 'update-db'):
            group = command_parser.add_mutually_exclusive_group(
                required=command in ('prepare', 'update-db'))
            group.add_argument('--only', help='explicit configured tool/profile')
            if command == 'prepare':
                group.add_argument('--all', action='store_true', help='all configured tools only')
        if command == 'results':
            command_parser.add_argument('--project', help='must match configured project')
            command_parser.add_argument('--run')
    if arguments and arguments[0] == '--':
        arguments = arguments[1:]
    if not arguments or arguments == ['help']:
        arguments = ['--help']
    args = parser.parse_args(arguments)
    config = integration_config(integration)
    # All commands verify the handshake; doctor/catalog do not need scanner inputs.
    if args.command in ('doctor', 'catalog'):
        return [args.command]
    data = load(config)
    if args.command == 'results':
        if args.project and args.project != data['project']:
            raise ConfigError('results: project differs from consumer config')
        return ['results', '--project', data['project'], *(['--run', args.run] if args.run else [])]
    return [args.command, '--config', str(config),
            *(['--only', args.only] if getattr(args, 'only', None) else [])]
