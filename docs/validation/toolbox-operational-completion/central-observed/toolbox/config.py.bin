"""Strict consumer contract, requiring only Python's standard library."""
import json
import math
import re
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
ID = re.compile(r"[a-z0-9][a-z0-9_-]{0,63}\Z")

class ConfigError(ValueError):
    pass


def object_keys(value, allowed, where):
    if not isinstance(value, dict):
        raise ConfigError(f"{where}: expected object")
    extra = set(value) - set(allowed)
    if extra:
        raise ConfigError(f"{where}: unknown field(s): {', '.join(sorted(extra))}")


def read_json(path):
    def unique(pairs):
        out = {}
        for key, value in pairs:
            if key in out:
                raise ConfigError(f"duplicate JSON field: {key}")
            out[key] = value
        return out
    return json.loads(Path(path).read_text(), object_pairs_hook=unique,
                      parse_constant=lambda v: (_ for _ in ()).throw(ConfigError(f"invalid JSON number: {v}")))


def catalog():
    return {p.parent.name: read_json(p) for p in sorted((REPO / 'tools').glob('*/tool.json'))}


def tool_folder(name, version):
    base = REPO / 'tools' / name
    if read_json(base / 'tool.json')['version'] == version:
        return base
    if not isinstance(version, str) or not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', version):
        raise ConfigError(f'tools.{name}.version: expected exact numeric version')
    alternative = base / 'versions' / version
    if not (alternative / 'tool.json').is_file():
        raise ConfigError(f'tools.{name}.version: {version} not in audited catalog; add a separate versions/{version}/ module')
    meta = read_json(alternative / 'tool.json')
    if meta.get('version') != version or meta.get('name') != name:
        raise ConfigError(f'invalid version catalog entry: {alternative}')
    return alternative


def tool_info(name, version):
    return read_json(tool_folder(name, version) / 'tool.json')


def relative_path(value, where):
    if not isinstance(value, str) or not value or '\x00' in value:
        raise ConfigError(f"{where}: expected nonempty relative path")
    p = Path(value)
    if p.is_absolute() or '..' in p.parts:
        raise ConfigError(f"{where}: must stay inside consumer root")
    return value


def load(path):
    path = Path(path).resolve()
    data = read_json(path)
    object_keys(data, ['schema', 'project', 'root', 'profiles', 'tools'], 'config')
    if type(data.get('schema')) is not int or data['schema'] != 1:
        raise ConfigError('schema: expected integer 1')
    if not isinstance(data.get('project'), str) or not ID.fullmatch(data['project']):
        raise ConfigError('project: use 1–64 lowercase letters, digits, _ or -')
    if not isinstance(data.get('root', '.'), str) or '\x00' in data.get('root', '.'):
        raise ConfigError('root: expected path string')
    root = (path.parent / data.get('root', '.')).resolve()
    if not root.is_dir():
        raise ConfigError(f'root: directory absent: {root}')
    # Docker --mount CSV accepts spaces, but commas/newlines are deliberately rejected.
    if any(c in str(root) for c in ',\n\r\x00'):
        raise ConfigError('root: commas and line breaks are unsupported in mount paths')
    profiles = data.get('profiles', [])
    known_profiles = read_json(REPO / 'profiles.json')
    if not isinstance(profiles, list) or any(not isinstance(p, str) or p not in known_profiles for p in profiles):
        raise ConfigError(f'profiles: choose from {list(known_profiles)}')
    tools = data.get('tools')
    object_keys(tools, catalog(), 'tools')
    for profile in profiles:
        for name in known_profiles[profile]:
            if name not in tools:
                raise ConfigError(f'profile {profile}: tools.{name} must explicitly select version or mark omitted')
    for name, spec in tools.items():
        where = f'tools.{name}'
        object_keys(spec, ['version', 'variant', 'enabled', 'applicable', 'reason', 'config', 'paths', 'mode',
                           'network', 'timeout', 'database', 'max_database_age_hours', 'env'], where)
        tool_info(name, spec.get('version'))
        for field in ['enabled', 'applicable']:
            if field in spec and type(spec[field]) is not bool:
                raise ConfigError(f'{where}.{field}: expected boolean')
        if (not spec.get('enabled', True) or not spec.get('applicable', True)) and not spec.get('reason'):
            raise ConfigError(f'{where}.reason: required for omitted/inapplicable tools')
        if 'reason' in spec and not isinstance(spec['reason'], str):
            raise ConfigError(f'{where}.reason: expected string')
        if 'config' in spec:
            relative_path(spec['config'], where + '.config')
        paths = spec.get('paths', ['.'])
        if not isinstance(paths, list) or not paths:
            raise ConfigError(f'{where}.paths: expected nonempty array')
        for p in paths:
            relative_path(p, where + '.paths')
        if name == 'shellcheck' and 'paths' not in spec:
            raise ConfigError(f'{where}.paths: explicitly list shell script files; globs are not expanded')
        if spec.get('network', 'none') not in ['none', 'bridge', 'host'] and not (
            isinstance(spec.get('network'), str) and re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}', spec['network'])):
            raise ConfigError(f'{where}.network: invalid Docker network name')
        if name in ('trivy', 'osv-scanner', 'grype', 'syft') and spec.get('network', 'none') != 'none':
            raise ConfigError(f'{where}.network: offline integration requires none')
        for field, default in [('timeout', 600), ('max_database_age_hours', 1)]:
            val = spec.get(field, default)
            if type(val) not in [int, float] or not math.isfinite(val) or val <= 0:
                raise ConfigError(f'{where}.{field}: expected positive finite number')
        if name == 'gitleaks' and spec.get('mode', 'files') not in ['files', 'history']:
            raise ConfigError(f'{where}.mode: files or history')
        if name == 'opengrep' and spec.get('mode', 'scan') not in ('scan', 'test'):
            raise ConfigError('opengrep mode: scan or test')
        if name not in ('gitleaks', 'opengrep') and 'mode' in spec:
            raise ConfigError(f'{where}.mode: unsupported for this tool')
        if 'variant' in spec and (name != 'playwright' or spec['variant'] not in ['api', 'chromium', 'firefox', 'webkit']):
            raise ConfigError(f'{where}.variant: Playwright accepts api, chromium, firefox, webkit')
        if name == 'playwright' and 'config' not in spec:
            raise ConfigError(f'{where}.config: explicit consumer Playwright config required')
        if name not in ('trivy', 'grype', 'osv-scanner') and any(k in spec for k in ('database', 'max_database_age_hours')):
            raise ConfigError(f'{where}: database options unsupported for this tool')
        if name != 'playwright' and spec.get('env'):
            raise ConfigError(f'{where}.env: supported only for Playwright')
        if name == 'playwright' and 'paths' in spec:
            raise ConfigError(f'{where}.paths: select tests in the native Playwright configuration')
        if 'database' in spec and (not isinstance(spec['database'], str) or not re.fullmatch('[0-9a-f]{64}', spec['database'])):
            raise ConfigError(f'{where}.database: expected SHA256 snapshot id')
        env = spec.get('env', {})
        object_keys(env, ['BASE_URL'], where + '.env')
        if any(not isinstance(v, str) or '\x00' in v for v in env.values()):
            raise ConfigError(f'{where}.env: values must be strings without NUL')
        if spec.get('enabled', True) and spec.get('applicable', True):
            from .adapters import adapter
            module = adapter(name, spec['version'])
            if module:
                validate_inputs(root, spec)
                try:
                    module.invocation(spec)
                except (ValueError, KeyError) as error:
                    raise ConfigError(f'{where}: {error}') from error
    data['_root'], data['_path'] = root, path
    return data


def validate_inputs(root, spec):
    for value in [*spec.get('paths', ['.']), *([spec['config']] if 'config' in spec else [])]:
        candidate = (root / value).resolve()
        if not candidate.is_relative_to(root) or not candidate.exists():
            raise ConfigError(f'input is missing or escapes consumer root: {value}')


def selection(data, only=None):
    if only:
        profiles = read_json(REPO / 'profiles.json')
        names = profiles.get(only, [only])
        absent = set(names) - set(data['tools'])
        if absent:
            raise ConfigError(f'selection: tools not configured: {sorted(absent)}')
        return {n: data['tools'][n] for n in names}
    return data['tools']
