"""Native contract tests; Docker calls are mocked, not scanner evidence."""
import argparse
from contextlib import redirect_stderr
import io
import json
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest.mock import Mock, patch
from toolbox import native
from toolbox.storage import Store, atomic_json, digest


class NativeTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.project = self.root / 'project with spaces'
        self.project.mkdir()
        self.store = Store(self.root / 'state', self.root / 'tools')
        self.record = {'tool': 'ruff', 'id': 'sha256:' + 'a' * 64, 'version': '0.11.13'}
        self.publish(self.record)

    def publish(self, record):
        root = native.home(self.store, 'ruff')
        revision = digest(record)
        atomic_json(root / 'revisions' / (revision + '.json'), record)
        atomic_json(root / 'active.json', {'revision': revision})
        return revision

    def args(self, *flags, argv=None):
        parser = argparse.ArgumentParser()
        native.parser(parser.add_subparsers(dest='command'))
        return parser.parse_args(['exec', '--tool', 'ruff', '--project-root', str(self.project),
                                  *flags, '--', *(argv or ['--version'])])

    def metadata(self):
        return json.loads(next((native.home(self.store, 'ruff') / 'executions').glob('*.json')).read_text())

    def test_argv_mounts_workdir_environment_without_shell(self):
        config = self.root / 'config file'
        config.write_text('x')
        argv = ['check', '--config', '/config/ruff.toml', 'a b.py', '$(touch hacked)', ';', '', '--']
        args = self.args('--project-write', '--workdir', '/project/sub', '--mount',
                         f'{config}:/config/ruff.toml:ro', '--env', 'SECRET=never log this', argv=argv)
        cmd, env = native.create_command(args, self.record, 'unique', self.root, self.root)
        self.assertEqual(cmd[-len(argv):], argv)
        self.assertNotIn('SECRET=never log this', cmd)
        self.assertEqual(env['SECRET'], 'never log this')
        self.assertIn('type=bind,src=' + str(config) + ',dst=/config/ruff.toml,readonly', cmd)
        self.assertIn('type=bind,src=' + str(self.project) + ',dst=/project', cmd)
        self.assertIn('/project/sub', cmd)
        self.assertIn('--pull=never', cmd)

    def test_environment_file_and_override(self):
        config = self.root / 'secret.env'
        config.write_text('# comment\nSECRET=abc $def\nHOME=/chosen\n')
        env = native.environment(self.args('--env-file', str(config), '--env', 'SECRET=override'), 'ruff')
        self.assertEqual(env['HOME'], '/chosen')
        self.assertEqual(env['SECRET'], 'override')

    def test_reject_reserved_mounts_invalid_modes_and_paths(self):
        for target, mode in [('/project', 'rw'), ('relative', 'ro'), ('/a/../b', 'ro'), ('/config', 'bad')]:
            with self.subTest(target=target, mode=mode), self.assertRaises(ValueError):
                native.mount(self.project, target, mode)

    def test_missing_active_is_infrastructure(self):
        (native.home(self.store, 'ruff') / 'active.json').unlink()
        stderr = io.StringIO()
        with redirect_stderr(stderr), patch.object(native.docker, 'inspect') as inspect:
            self.assertEqual(native.execute(self.args(), self.store), 125)
            inspect.assert_not_called()
        self.assertEqual(self.metadata()['outcome'], 'infrastructure')
        self.assertIsNone(self.metadata()['native_exit_code'])
        self.assertEqual(self.metadata()['phase'], 'resolve_active')
        self.assertEqual(self.metadata()['reason'], 'active_revision_missing')
        self.assertIn('no active central revision', stderr.getvalue())

    def test_invalid_active_records_fail_without_traceback_or_secret_disclosure(self):
        root = native.home(self.store, 'ruff')
        for pointer in (None, [], {'revision': 17}, {'revision': 'synthetic-secret'}):
            with self.subTest(pointer=pointer):
                atomic_json(root / 'active.json', pointer)
                diagnostic = self.root / 'diagnostic.json'
                stderr = io.StringIO()
                with redirect_stderr(stderr), patch.object(native.docker, 'inspect') as inspect:
                    self.assertEqual(native.execute(self.args('--diagnostic-file', str(diagnostic)), self.store), 125)
                    inspect.assert_not_called()
                metadata = json.loads(diagnostic.read_text())
                self.assertIn(metadata['reason'], ('active_revision_invalid', 'revision_invalid'))
                self.assertNotIn('synthetic-secret', diagnostic.read_text() + stderr.getvalue())

    def test_missing_revision_has_specific_reason(self):
        root = native.home(self.store, 'ruff')
        for path in (root / 'revisions').glob('*.json'):
            path.unlink()
        with self.assertRaises(native.CentralStateError) as error:
            native.active(self.store, 'ruff')
        self.assertEqual(error.exception.reason, 'revision_missing')

    def test_cross_tool_active_record_is_rejected(self):
        self.publish({**self.record, 'tool': 'bandit'})
        with self.assertRaises(native.CentralStateError) as error:
            native.active(self.store, 'ruff')
        self.assertEqual(error.exception.reason, 'revision_invalid')

    def test_status_inventories_legacy_records_without_activation_or_docker(self):
        root = native.home(self.store, 'ruff')
        (root / 'active.json').unlink()
        candidate = root.parent / 'images/0.11.13/recipe/image.json'
        atomic_json(candidate, {**self.record, 'private': 'synthetic-secret'})
        atomic_json(candidate.parent.parent / 'broken/image.json', [])
        with patch.object(native.docker, 'inspect') as inspect, patch.object(native.docker, 'capture') as capture:
            status = native.central(argparse.Namespace(operation='status', tool='ruff'), self.store)['ruff']
            inspect.assert_not_called()
            capture.assert_not_called()
        self.assertEqual(status['status'], 'active_revision_missing')
        self.assertFalse(status['docker_verified'])
        self.assertEqual({r['status'] for r in status['prepared_records']}, {'invalid_record', 'requires_docker_verification'})
        self.assertFalse((root / 'active.json').exists())
        self.assertNotIn('synthetic-secret', json.dumps(status))

    def test_status_does_not_create_missing_tool_volume(self):
        result = native.central_status(self.store, 'absent')
        self.assertEqual(result['status'], 'active_revision_missing')
        self.assertFalse((self.store.tools_root / 'absent').exists())

    def test_register_failure_does_not_publish_or_activate(self):
        root = native.home(self.store, 'ruff')
        (root / 'active.json').unlink()
        before = sorted((root / 'revisions').glob('*.json'))
        candidate = self.root / 'image.json'
        atomic_json(candidate, self.record)
        args = argparse.Namespace(operation='register', tool='ruff', record=candidate)
        with patch.object(native.docker, 'inspect', side_effect=native.docker.DockerError('denied')):
            with self.assertRaises(native.docker.DockerError):
                native.central(args, self.store)
        self.assertFalse((root / 'active.json').exists())
        self.assertEqual(sorted((root / 'revisions').glob('*.json')), before)

    def test_register_verifies_but_does_not_activate(self):
        root = native.home(self.store, 'ruff')
        (root / 'active.json').unlink()
        candidate = self.root / 'image.json'
        atomic_json(candidate, self.record)
        args = argparse.Namespace(operation='register', tool='ruff', record=candidate)
        with patch.object(native, 'verify_record', return_value='ruff 0.11.13'):
            result = native.central(args, self.store)
        self.assertFalse(result['activated'])
        self.assertFalse((root / 'active.json').exists())
        self.assertEqual(native.revision_record(root, result['revision'])['id'], self.record['id'])

    def boundary(self, args, code=7, process=None, on_start=None):
        real_popen = subprocess.Popen
        def popen(command, **kwargs):
            if on_start:
                on_start(command)
            script = f'import sys; sys.stdout.buffer.write(b"out\\x00"); sys.stderr.buffer.write(b"err\\xff"); sys.exit({code})'
            return process or real_popen(['python3', '-c', script], **kwargs)
        def capture(command, **kwargs):
            return json.dumps({'Status':'exited','ExitCode':code}) if command[0]=='inspect' else ''
        with patch.object(native.docker, 'inspect', return_value={'Id': self.record['id']}), \
             patch.object(native.subprocess, 'run', return_value=subprocess.CompletedProcess([], 0)), \
             patch.object(native.subprocess, 'Popen', side_effect=popen), \
             patch.object(native.docker, 'capture', side_effect=capture) as captured:
            result = native.execute(args, self.store)
        return result, captured

    def test_native_code_bytes_and_redaction(self):
        out, err = self.root / 'stdout', self.root / 'stderr'
        result, calls = self.boundary(self.args('--stdout-file', str(out), '--stderr-file', str(err),
                                               '--env', 'TOKEN=synthetic-secret', argv=['check', 'synthetic-secret']))
        self.assertEqual(result, 7)
        self.assertEqual(out.read_bytes(), b'out\x00')
        self.assertEqual(err.read_bytes(), b'err\xff')
        self.assertNotIn('synthetic-secret', json.dumps(self.metadata()))
        self.assertEqual(self.metadata()['outcome'], 'native')
        self.assertEqual(self.metadata()['cleanup'], 'removed')
        self.assertTrue(any(c.args[0][0] == 'rm' for c in calls.call_args_list))

    def test_timeout_is_distinct_from_native_code(self):
        process = Mock(returncode=-15)
        process.poll.return_value = None
        result, calls = self.boundary(self.args('--timeout', '0.001'), code=143, process=process)
        self.assertEqual(result, 124)
        self.assertEqual(self.metadata()['outcome'], 'timeout')
        self.assertEqual(self.metadata()['native_exit_code'], 143)
        self.assertTrue(any(c.args[0][0] == 'stop' for c in calls.call_args_list))

    def test_activation_does_not_change_selected_record(self):
        selected = native.active(self.store, 'ruff')
        replacement = {**self.record, 'id': 'sha256:' + 'b' * 64}
        revision = self.publish(replacement)
        args = argparse.Namespace(operation='activate', tool='ruff', revision=revision)
        with patch.object(native, 'verify_record', return_value='0.11.13'):
            native.central(args, self.store)
        self.assertEqual(selected['id'], self.record['id'])
        self.assertEqual(native.active(self.store, 'ruff')['id'], replacement['id'])
        self.assertTrue(list((native.home(self.store, 'ruff') / 'history').glob('*.json')))

    def test_integrity_tamper_rejected(self):
        root = native.home(self.store, 'ruff')
        revision = json.loads((root / 'active.json').read_text())['revision']
        atomic_json(root / 'revisions' / (revision + '.json'), {**self.record, 'version': 'other'})
        with self.assertRaises(ValueError):
            native.active(self.store, 'ruff')

    def test_invalid_timeout_and_tty_fail_before_docker(self):
        for flags in [('--timeout', '-1'), ('--tty',)]:
            with self.subTest(flags=flags), redirect_stderr(io.StringIO()), patch.object(native.docker, 'inspect') as inspect:
                self.assertEqual(native.execute(self.args(*flags), self.store), 125)
                inspect.assert_not_called()

    def test_cancellation_forwards_signal_and_cleans_only_own_container(self):
        import os
        import signal
        process = Mock(returncode=-15)
        process.poll.return_value = None
        result, calls = self.boundary(self.args(), code=143, process=process,
                                     on_start=lambda command: os.kill(os.getpid(), signal.SIGTERM))
        self.assertEqual(result, 143)
        self.assertEqual(self.metadata()['outcome'], 'cancelled')
        kill = [c.args[0] for c in calls.call_args_list if c.args[0][0]=='kill']
        self.assertEqual(kill[0][1:3], ['--signal', 'SIGTERM'])
        self.assertTrue(kill[0][-1].startswith('toolbox-native-'))
        self.assertEqual(self.metadata()['cleanup'], 'removed')

    def test_native_124_is_not_timeout(self):
        result, calls = self.boundary(self.args('--stdout-file', str(self.root/'o'), '--stderr-file', str(self.root/'e')), code=124)
        self.assertEqual(result, 124)
        self.assertEqual(self.metadata()['outcome'], 'native')

    def test_reader_concurrency_and_writer_exclusion_with_real_flock(self):
        import sys
        code = '''
import fcntl, sys
with open(sys.argv[1], 'a') as handle:
    try:
        fcntl.flock(handle, int(sys.argv[2]) | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(19)
'''
        import fcntl
        path = native.home(self.store, 'ruff') / 'data.lock'
        with native.data_lock(self.store, 'ruff'):
            reader = subprocess.run([sys.executable, '-c', code, str(path), str(fcntl.LOCK_SH)])
            writer = subprocess.run([sys.executable, '-c', code, str(path), str(fcntl.LOCK_EX)])
        self.assertEqual(reader.returncode, 0)
        self.assertEqual(writer.returncode, 19)
        self.assertEqual(subprocess.run([sys.executable, '-c', code, str(path), str(fcntl.LOCK_EX)]).returncode, 0)

    def test_cache_lock_wait_has_timeout(self):
        import time
        with native.cache_lock(self.store, 'ruff', 'fixture', None):
            with self.assertRaises(TimeoutError):
                with native.cache_lock(self.store, 'ruff', 'fixture', time.monotonic()+0.01):
                    self.fail('concurrent writer entered')

    def test_image_activation_during_execution_keeps_selected_identity(self):
        old = self.record['id']
        replacement = {**self.record, 'id': 'sha256:' + 'b'*64}
        result, calls = self.boundary(self.args('--stdout-file', str(self.root/'o'), '--stderr-file', str(self.root/'e')),
                                     on_start=lambda command: self.publish(replacement))
        self.assertEqual(result, 7)
        self.assertEqual(self.metadata()['image'], old)
        self.assertEqual(native.active(self.store, 'ruff')['id'], replacement['id'])

    def test_missing_delimiter_has_no_docker_side_effect(self):
        args = self.args()
        args.native = ['check']
        with redirect_stderr(io.StringIO()), patch.object(native.docker, 'inspect') as inspect:
            self.assertEqual(native.execute(args, self.store), 125)
            inspect.assert_not_called()

    def test_native_maintenance_publishes_only_successful_staging(self):
        from toolbox.databases import publish_database
        record = {**self.record, 'tool':'trivy', 'version':'0.76.2'}
        root = native.home(self.store, 'trivy')
        revision = digest(record)
        atomic_json(root/'revisions'/(revision+'.json'), record)
        atomic_json(root/'active.json', {'revision':revision})
        stage = self.store.preparation_dir('trivy')
        (stage/'data').mkdir()
        (stage/'data'/'fixture.db').write_text('original')
        old = publish_database(self.store, 'trivy', {'version':'0.76.2'}, record, stage, {})['database']
        pointer = self.store.volume('trivy')/'databases/0.76.2/current.json'
        for code in (7,0):
            args = self.args('--maintenance','--stdout-file',str(self.root/f'o{code}'), '--stderr-file',str(self.root/f'e{code}'))
            args.tool = 'trivy'
            # Ignore previous failed staging when locating this attempt's private writable copy.
            def newest(command):
                stages=list(self.store.volume('trivy').glob('preparation/*/data/fixture.db'))
                max(stages,key=lambda p:p.stat().st_ctime_ns).write_text('updated')
            result, calls = self.boundary(args,code=code,on_start=newest)
            selected=json.loads(pointer.read_text())['database']
            self.assertEqual(result,code)
            self.assertEqual(selected==old,code!=0)
        self.assertEqual((self.store.database('trivy','0.76.2',old)/'fixture.db').read_text(),'original')

    def test_gzip_tar_release_without_tar_extension(self):
        import hashlib
        import tarfile
        from toolbox import prepare
        archive = self.root/'official.gz'
        content = self.root/'yr'
        content.write_bytes(b'fixture executable bytes')
        with tarfile.open(archive,'w:gz') as bundle:
            bundle.add(content,arcname='yr')
        payload = self.root/'payload'
        payload.mkdir()
        checksum = hashlib.sha256(archive.read_bytes()).hexdigest()
        release = {'assets':[{'name':'official.gz','digest':'sha256:'+checksum,'browser_download_url':'https://official.invalid/official.gz'}],
                   'html_url':'https://official.invalid/release','tag_name':'v1'}
        def fetch(url):
            return json.dumps(release).encode() if 'api.github.com' in url else archive.read_bytes()
        with patch.object(prepare,'fetch',side_effect=fetch):
            prepare.release_payload({'repository':'fixture/tool','tag':'v1','asset_pattern':r'official\.gz'},payload)
        self.assertTrue((payload/'tool.tar').is_file())
        self.assertFalse((payload/'tool').exists())
        with tarfile.open(payload/'tool.tar') as bundle:
            self.assertEqual(bundle.extractfile('yr').read(),content.read_bytes())
