import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

from toolbox.config import ConfigError, REPO
from toolbox.consumer import capabilities, consumer_arguments, integration_config


class ConsumerTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='consumer with spaces ')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        shutil.copytree(REPO / 'templates/consumer/scripts', self.root / 'scripts')
        self.integration = self.root / 'scripts/config/integration.json'
        self.config = self.integration.with_name('toolbox.json')
        self.wrapper = self.root / 'scripts/toolbox.sh'
        self.env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1',
                        TOOLBOX_BIN=str(REPO / 'bin/toolbox'))

    def execute(self, *args, env=None):
        return subprocess.run(['bash', str(self.wrapper), *args], cwd='/tmp',
                              env=env or self.env, capture_output=True, text=True,
                              timeout=10)

    def change_integration(self, **values):
        data = json.loads(self.integration.read_text())
        data.update(values)
        self.integration.write_text(json.dumps(data))

    def test_actual_wrapper_validates_from_unrelated_cwd(self):
        result = self.execute('validate')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(json.loads(result.stdout)['root'], str(self.root))

    def test_missing_and_invalid_executable_never_fall_back(self):
        for value in ('', '/missing/toolbox', str(self.root)):
            result = self.execute('validate', env=dict(self.env, TOOLBOX_BIN=value))
            self.assertEqual(result.returncode, 2)
        result = self.execute('validate', env={**self.env, 'PATH': '/usr/bin:/bin',
                                              'TOOLBOX_BIN': '/missing/toolbox'})
        self.assertEqual(result.returncode, 2)

    def test_path_discovery(self):
        env = dict(self.env)
        del env['TOOLBOX_BIN']
        env['PATH'] = str(REPO / 'bin') + ':' + env['PATH']
        self.assertEqual(self.execute('validate', env=env).returncode, 0)

    def test_handshake_rejects_major_unknown_and_unimplemented_capability(self):
        for changes in ({'version': '2.0'}, {'contract': 'other'},
                        {'required_capabilities': ['export']}, {'extra': True},
                        {'stacks': ['rust', 'rust']}, {'stacks': []}):
            with self.subTest(changes=changes):
                original = self.integration.read_text()
                self.change_integration(**changes)
                self.assertEqual(self.execute('validate').returncode, 2)
                self.integration.write_text(original)
        self.assertEqual(capabilities()['layout_versions'], [1])
        self.assertNotIn('export', capabilities()['capabilities'])
        self.change_integration(required_capabilities=['export'])
        state = self.root / 'must not be created'
        result = self.execute('prepare', '--all',
                              env=dict(self.env, TOOLBOX_STATE=str(state)))
        self.assertEqual(result.returncode, 2)
        self.assertFalse(state.exists())

    def test_config_escape_and_symlink_rejected(self):
        for value in ('../toolbox.json', '/tmp/toolbox.json'):
            self.change_integration(toolbox_config=value)
            with self.assertRaises(ConfigError):
                integration_config(self.integration)
        self.change_integration(toolbox_config='toolbox.json')
        external = self.root / 'other.json'
        self.config.rename(external)
        self.config.symlink_to(external)
        with self.assertRaises(ConfigError):
            integration_config(self.integration)

    def test_maintenance_requires_explicit_selection(self):
        for args in (['prepare'], ['update-db'], ['prepare', '--all', '--only', 'ruff'],
                     ['update-db', '--all'], ['run', '--all']):
            result = self.execute(*args)
            self.assertEqual(result.returncode, 2, result.stderr)
        expected = ['prepare', '--config', str(self.config)]
        self.assertEqual(consumer_arguments(self.integration, ['prepare', '--all']), expected)
        self.assertEqual(consumer_arguments(self.integration, ['prepare', '--only', 'ruff']),
                         expected + ['--only', 'ruff'])
        self.assertFalse((self.root / 'tools').exists())

    def test_results_project_bound_to_consumer(self):
        self.assertEqual(consumer_arguments(self.integration, ['results']),
                         ['results', '--project', 'example'])
        with self.assertRaises(ConfigError):
            consumer_arguments(self.integration, ['results', '--project', 'other'])

    def test_help_and_unsupported_commands_have_no_side_effect(self):
        self.assertEqual(self.execute('help').returncode, 0)
        for command in ('export', 'prune', 'lock-base', 'unknown'):
            self.assertEqual(self.execute(command).returncode, 2)
        self.assertFalse((self.root / '.local').exists())

    def test_wrapper_preserves_arguments_codes_and_signal(self):
        fake = self.root / 'fake toolbox'
        fake.write_text('#!/usr/bin/env python3\nimport json, os, sys, signal\n'
                        'print(json.dumps(sys.argv[1:]), flush=True)\n'
                        'code = int(os.environ["FAKE_CODE"])\n'
                        'if code < 0: os.kill(os.getpid(), signal.SIGTERM)\n'
                        'sys.exit(code)\n')
        fake.chmod(0o700)
        token = '$(touch SHOULD_NOT_EXIST); * spaces'
        for code in (0, 1, 2, 3, 42, 130, -15):
            result = self.execute('run', '--only', token,
                                  env=dict(self.env, TOOLBOX_BIN=str(fake), FAKE_CODE=str(code)))
            self.assertEqual(result.returncode, code)
            self.assertEqual(json.loads(result.stdout),
                             ['consumer', '--integration', str(self.integration),
                              '--', 'run', '--only', token])

    def test_stack_metadata_never_populates_tools(self):
        for stacks in (['kotlin'], ['rust'], ['python'], ['frontend'], ['rust', 'frontend']):
            self.change_integration(stacks=stacks)
            result = self.execute('plan')
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(json.loads(result.stdout), [])
            self.assertEqual(json.loads(self.config.read_text())['tools'], {})


if __name__ == '__main__':
    unittest.main()
