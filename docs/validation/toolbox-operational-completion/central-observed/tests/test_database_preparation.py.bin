"""Regression coverage for persistent snapshots, not simulated scanner acceptance."""
import json
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

from toolbox.adapters import adapter, classify
from toolbox.databases import effective_spec, ensure_database, inspect_database, publish_database
from toolbox.storage import Store
from toolbox.config import ConfigError, load


class DatabasePreparationTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        self.store = Store(self.root / 'state', tools_root=self.root / 'tools')
        self.store.tools_root.mkdir()
        self.spec = {'version': '0.76.2', 'max_database_age_hours': 168}
        self.image = {'id': 'sha256:' + '1' * 64, 'version': '0.76.2'}

    def tearDown(self):
        self.tmp.cleanup()

    def snapshot(self, content='native database bytes'):
        staging = self.store.preparation_dir('trivy')
        (staging / 'data').mkdir()
        (staging / 'data' / 'native.db').write_text(content)
        return publish_database(self.store, 'trivy', self.spec, self.image, staging, {})

    def test_two_consumers_reuse_prepared_snapshot_without_network(self):
        snapshot = self.snapshot()
        with patch('toolbox.prepare.update_database', side_effect=AssertionError('unexpected download')):
            for _ in range(2):
                result = ensure_database(self.store, 'trivy', self.spec, {'tools': {'trivy': self.image}})
                self.assertEqual(result['database'], snapshot['database'])

    def test_explicit_update_does_not_replace_consumer_pin(self):
        old = self.snapshot('old')
        new = self.snapshot('new')
        image = dict(self.image, database=old['database'])
        spec = effective_spec('trivy', self.spec, image)
        self.assertEqual(spec['database'], old['database'])
        self.assertEqual(effective_spec('trivy', dict(spec, database=new['database']), image)['database'], new['database'])
        with patch('toolbox.prepare.update_database', side_effect=AssertionError('unexpected download')):
            result = ensure_database(self.store, 'trivy', self.spec, {'tools': {'trivy': image}}, spec['database'])
            self.assertEqual(result['database'], old['database'])

    def test_corrupt_or_missing_snapshot_never_downloads_silently(self):
        snapshot = self.snapshot()
        (Path(snapshot['path']) / 'native.db').write_text('tampered')
        with patch('toolbox.prepare.update_database', side_effect=AssertionError('unexpected download')):
            with self.assertRaisesRegex(ValueError, 'integrity'):
                ensure_database(self.store, 'trivy', self.spec, {'tools': {'trivy': self.image}}, snapshot['database'])
            with self.assertRaises(OSError):
                ensure_database(self.store, 'trivy', self.spec, {'tools': {'trivy': self.image}}, 'f' * 64)
        with self.assertRaisesRegex(ValueError, 'identity'):
            inspect_database(self.store, 'trivy', self.spec['version'], '../escape')

    def test_first_prepare_downloads_once(self):
        with patch('toolbox.prepare.update_database', side_effect=lambda *args: self.snapshot()) as update:
            first = ensure_database(self.store, 'trivy', self.spec, {'tools': {'trivy': self.image}})
            second = ensure_database(self.store, 'trivy', self.spec, {'tools': {'trivy': self.image}})
        self.assertEqual(update.call_count, 1)
        self.assertEqual(first['database'], second['database'])

    def test_version_change_does_not_inherit_incompatible_pin(self):
        self.assertNotIn('database', effective_spec('trivy', self.spec, {'version': '0.61.1', 'database': 'a' * 64}))

    def test_offline_network_cannot_be_overridden(self):
        for name, version in [('trivy', '0.76.2'), ('grype', '0.119.0'), ('osv-scanner', '2.7.0'), ('syft', '1.23.1')]:
            path = self.root / 'toolbox.json'
            path.write_text(json.dumps({'schema': 1, 'project': 'test', 'tools': {name: {'version': version, 'network': 'bridge'}}}))
            with self.assertRaisesRegex(ConfigError, 'requires none'):
                load(path)

    def test_trivy_and_syft_offline_contract_and_failure_classification(self):
        trivy = adapter('trivy', '0.76.2')
        args, _ = trivy.invocation(self.spec)
        for flag in ['--skip-db-update', '--skip-java-db-update', '--offline-scan', '--disable-telemetry', '--skip-version-check']:
            self.assertIn(flag, args)
        syft = adapter('syft', '1.23.1')
        _, env = syft.invocation({})
        self.assertTrue(all(value == 'false' for value in env.values()))
        output = self.root / 'stdout.log'
        output.write_text(json.dumps({'descriptor': {'name': 'syft'}, 'source': {}, 'artifacts': []}))
        self.assertEqual(classify(syft, {'tool_exit_code': 0}, self.root)[0], 'measurement')
        self.assertEqual(classify(syft, {'tool_exit_code': 1}, self.root)[0], 'operational_failure')
        output.write_text('{}')
        self.assertEqual(classify(trivy, {'tool_exit_code': 0}, self.root)[0], 'operational_failure')
