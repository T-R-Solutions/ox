#!/usr/bin/env python3
"""Real Docker acceptance; missing images are failures, never simulated passes.
Run from repository root: python3 tests/acceptance.py --state /absolute/state.
Preparation is explicit and separate; this script never downloads or builds.
"""
import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))
from toolbox.config import load
from toolbox.runner import image_lock
from toolbox.storage import atomic_json, now


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--state', required=True)
    parser.add_argument('--output', type=Path, default=REPO / 'evidence/acceptance.json')
    args = parser.parse_args()
    observations = []

    def invoke(config, name, expected):
        proc = subprocess.run([str(REPO / 'bin/toolbox'), '--state', args.state, 'run', '--config', str(config), '--only', name], capture_output=True, text=True)
        try:
            report = json.loads(proc.stdout)
        except ValueError:
            report = {'error': proc.stderr}
        record = {'consumer': str(config), 'tool': name, 'expected_cli_exit': expected,
                  'actual_cli_exit': proc.returncode, 'observed': report}
        executed = report.get('tools', [{}])[0].get('tool_exit_code') is not None
        record['accepted'] = proc.returncode == expected and executed and report.get('sources_unchanged') is True
        return record

    cases = [('consumer-a', 'ruff', 1), ('consumer-b', 'ruff', 0),
             ('consumer-a', 'gitleaks', 1), ('consumer-b', 'gitleaks', 0),
             ('playwright-api', 'playwright', 0), ('playwright-ui', 'playwright', 0),
             ('static-analysis', 'bandit', 1), ('static-analysis', 'shellcheck', 1),
             ('static-analysis', 'opengrep', 1),
             ('offline-security', 'grype', 1), ('offline-security', 'trivy', 1),
             ('offline-security', 'osv-scanner', 1), ('offline-security', 'syft', 3)]
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = [pool.submit(invoke, REPO / 'examples' / c / 'toolbox.json', t, code) for c, t, code in cases]
        observations = [f.result() for f in futures]
    # Clean controls use separate configs and the explicitly prepared image lock.
    # No consumer source or pre-existing lock is modified.
    source = REPO / 'examples/static-analysis'
    config_data = json.loads((source / 'toolbox.json').read_text())
    with tempfile.TemporaryDirectory(prefix='toolbox-acceptance-') as temporary:
        for name in ('bandit', 'shellcheck', 'opengrep'):
            spec = dict(config_data['tools'][name], paths=['good.sh' if name == 'shellcheck' else 'good.py'])
            path = Path(temporary) / (name + '.json')
            atomic_json(path, {'schema': 1, 'project': 'static-clean-' + name,
                               'root': str(source), 'tools': {name: spec}})
            atomic_json(path.with_name(name + '.images.lock.json'), image_lock(load(source / 'toolbox.json')))
            observations.append(invoke(path, name, 0))
    reuse = {}
    for name in ['ruff', 'gitleaks']:
        a = image_lock(load(REPO / 'examples/consumer-a/toolbox.json'))['tools'].get(name, {}).get('id')
        b = image_lock(load(REPO / 'examples/consumer-b/toolbox.json'))['tools'].get(name, {}).get('id')
        reuse[name] = {'image_a': a, 'image_b': b, 'accepted': bool(a) and a == b}
    paths = [r['observed'].get('directory') for r in observations if r['observed'].get('directory')]
    separated = len(paths) == len(observations) and len(set(paths)) == len(paths)
    outputs = [tool['output'] for case in observations for tool in case['observed'].get('tools', []) if tool.get('output')]
    owners = all(p.stat().st_uid == os.getuid() for directory in paths + outputs for p in Path(directory).rglob('*') if not p.is_symlink())
    installs_absent = all(not (p.parent / 'node_modules').exists() for p in (REPO / 'examples').glob('*/toolbox.json'))
    passed = all(o['accepted'] for o in observations) and all(r['accepted'] for r in reuse.values()) and separated and owners and installs_absent
    result = {'at': now(), 'accepted': passed, 'cases': observations, 'reuse': reuse,
              'separate_run_directories': separated, 'artifact_uid_matches_host': owners,
              'no_consumer_node_modules': installs_absent,
              'not_covered': ['ShellCheck 0.10.0', 'research-blocked integrations',
                              'Gitleaks history fixture', 'Playwright Firefox/WebKit',
                              'image archive targets', 'second-machine portability', 'cancellation of real tools']}
    atomic_json(args.output, result)
    print(json.dumps({'accepted': passed, 'evidence': str(args.output)}, indent=2))
    return 0 if passed else 2


if __name__ == '__main__':
    raise SystemExit(main())
