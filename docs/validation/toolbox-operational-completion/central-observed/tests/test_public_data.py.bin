import unittest,tempfile,json,hashlib
from pathlib import Path
from toolbox.databases import public_data_metadata
class PublicData(unittest.TestCase):
 def test_trivy_data_time_not_download_time(self):
  with tempfile.TemporaryDirectory() as f:
   root=Path(f)
   for folder in ('db','java-db'):
    (root/folder).mkdir();(root/folder/'metadata.json').write_text(json.dumps({'UpdatedAt':'2026-11-07T00:00:00Z','NextUpdate':'2026-11-08T00:00:00Z','DownloadedAt':'2099-01-01T00:00:00Z'}))
   value=public_data_metadata('trivy',{'path':f,'database':'a'*64})
   self.assertEqual(value['data_timestamp'],'2026-11-07T00:00:00+00:00')
   (root/'db/metadata.json').write_text('{"UpdatedAt":"2099-01-01T00:00:00Z","NextUpdate":"2100-01-01T00:00:00Z"}')
   with self.assertRaises(ValueError):public_data_metadata('trivy',{'path':f,'database':'a'*64})
 def test_osv_missing_and_substituted_receipt(self):
  with tempfile.TemporaryDirectory() as f:
   root=Path(f);db={'path':f,'database':'a'*64}
   with self.assertRaises(OSError):public_data_metadata('osv-scanner',db)
   sources=[]
   for ecosystem in ('crates.io','npm'):
    for layout in ('osv-scanner','osv-scalibr'):
     p=root/layout/ecosystem/'all.zip';p.parent.mkdir(parents=True);p.write_bytes(b'fixture')
    sources.append({'url':'https://osv-vulnerabilities.storage.googleapis.com/'+ecosystem+'/all.zip','sha256':hashlib.sha256(b'fixture').hexdigest(),'generation':'123','data_timestamp':'2026-11-07T00:00:00Z','timestamp_semantics':'upstream_object_generation_created'})
   (root/'toolbox-osv-sources.json').write_text(json.dumps(sources))
   self.assertEqual(public_data_metadata('osv-scanner',db)['snapshot'],'a'*64)
   (root/'osv-scanner/npm/all.zip').write_bytes(b'substitution')
   with self.assertRaises(ValueError):public_data_metadata('osv-scanner',db)
