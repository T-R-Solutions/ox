"""Persistent native snapshots; preparation can download, execution never does."""
import re
from .config import read_json
from .storage import atomic_json, digest, now, tree_manifest


DATABASE_TOOLS = ('trivy', 'osv-scanner', 'grype')


def inspect_database(store, name, version, identity):
    if not isinstance(identity, str) or not re.fullmatch('[0-9a-f]{64}', identity):
        raise ValueError('invalid database snapshot identity')
    path = store.database(name, version, identity)
    metadata = read_json(path.parent / (identity + '.json'))
    if (metadata.get('tool') != name or metadata.get('version') != version
            or metadata.get('id') != identity or not path.is_dir()
            or digest(tree_manifest(path)) != identity):
        raise ValueError('database snapshot integrity/version mismatch')
    return {'database': identity, 'path': str(path), 'metadata': metadata}


def publish_database(store, name, spec, record, staging, extra):
    database = staging / 'data'
    manifest = tree_manifest(database)
    if not manifest:
        raise ValueError(f'database updater produced no files: {staging}')
    identity = digest(manifest)
    target = store.database(name, spec['version'], identity)
    with store.lock(['database', name]):
        target.parent.mkdir(parents=True, exist_ok=True)
        if not target.exists():
            database.rename(target)
            atomic_json(target.parent / (identity + '.json'),
                        {'schema': 1, 'tool': name, 'version': spec['version'],
                         'image': record['id'], 'id': identity, 'prepared_at': now(),
                         'files': manifest, **extra})
        inspect_database(store, name, spec['version'], identity)
        atomic_json(target.parent / 'current.json', {'database': identity})
    atomic_json(staging / 'summary.json', {'status': 'database_prepared', 'snapshot': identity, 'tool_exit_code': 0})
    return {'database': identity, 'path': str(target), 'configuration_change_required': True}


def ensure_database(store, name, spec, lock, snapshot=None):
    # Serialize first preparation across consumers; never replace a pinned snapshot.
    with store.lock(['database', name, 'ensure', spec['version']]):
        if snapshot:
            return inspect_database(store, name, spec['version'], snapshot)
        pointer = store.volume(name) / 'databases' / spec['version'] / 'current.json'
        if pointer.exists():
            return inspect_database(store, name, spec['version'], read_json(pointer)['database'])
        from .prepare import update_database
        return update_database(store, name, spec, lock)


def effective_spec(name, spec, image):
    result = dict(spec)
    if name in DATABASE_TOOLS and not result.get('database') and image.get('version') == spec['version']:
        if image.get('database'):
            result['database'] = image['database']
    return result
