"""Native execution and central activation. No consumer configuration or adapter."""
import argparse
import contextlib
import fcntl
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import signal
import subprocess
import sys
import time
import uuid
from . import docker
from .config import ID, REPO, read_json
from .storage import Store, atomic_json, digest, now

IMAGE_ID = re.compile(r'sha256:[0-9a-f]{64}\Z')


def parser(sub):
    p = sub.add_parser('exec', allow_abbrev=False, help='execute arbitrary native arguments after --')
    p.add_argument('--tool', required=True)
    p.add_argument('--project-root', type=Path, required=True)
    p.add_argument('--workdir', default='/project')
    p.add_argument('--project-write', action='store_true')
    p.add_argument('--mount', action='append', default=[], metavar='HOST:CONTAINER:ro|rw')
    p.add_argument('--results', type=Path)
    p.add_argument('--network', default='none')
    for flag in ('add-host', 'publish', 'device', 'env', 'env-file'):
        p.add_argument('--' + flag, action='append', default=[])
    p.add_argument('--stdin', action='store_true')
    p.add_argument('--tty', action='store_true')
    p.add_argument('--timeout', type=float)
    p.add_argument('--maintenance', action='store_true', help='exclusive persistent-data writer; publish DB only on success')
    p.add_argument('--stdout-file', type=Path)
    p.add_argument('--stderr-file', type=Path)
    p.add_argument('--diagnostic-file', type=Path)
    p.add_argument('native', nargs=argparse.REMAINDER)
    p = sub.add_parser('central', help='operator-only central image lifecycle')
    commands = p.add_subparsers(dest='operation', required=True)
    commands.add_parser('list')
    p = commands.add_parser('prepare')
    p.add_argument('--tool', required=True)
    p.add_argument('--version', required=True)
    p.add_argument('--browsers', choices=['chromium', 'firefox', 'webkit'], default='chromium')
    p = commands.add_parser('register', help='verify a previously prepared image record')
    p.add_argument('--tool', required=True)
    p.add_argument('--record', type=Path, required=True)
    for name in ('activate', 'rollback'):
        p = commands.add_parser(name)
        p.add_argument('--tool', required=True)
        p.add_argument('--revision', required=True)


def home(store, name):
    if not ID.fullmatch(name):
        raise ValueError('invalid tool identifier')
    return store.volume(name) / 'central'


def active(store, name):
    root = home(store, name)
    revision = read_json(root / 'active.json')['revision']
    return revision_record(root, revision)


def revision_record(root, revision):
    if not re.fullmatch('[0-9a-f]{64}', revision):
        raise ValueError('invalid central revision')
    record = read_json(root / 'revisions' / (revision + '.json'))
    if digest(record) != revision or not IMAGE_ID.fullmatch(record['id']):
        raise ValueError('central revision integrity failure')
    return record


def entrypoint(name):
    # Legacy Playwright images retain their adapter entrypoint.
    if name == 'playwright':
        return ['--entrypoint', 'node'], ['/opt/pw/node_modules/@playwright/test/cli.js']
    return [], []


def verify_record(name, record):
    if record.get('tool') != name or not IMAGE_ID.fullmatch(record.get('id', '')):
        raise ValueError('prepared record must identify tool and immutable local image ID')
    if docker.inspect(record['id'])['Id'] != record['id']:
        raise ValueError('image identity mismatch')
    flags, prefix = (entrypoint(name) if name == 'playwright' else ([], []))
    version_args = ['version'] if name in ('gitleaks', 'grype', 'syft', 'codeql') else ['--version']
    observed = docker.capture(['run', '--rm', '--pull=never', '--network=none', *flags,
                               record['id'], *prefix, *version_args])
    if record['version'] not in observed:
        raise ValueError('native version does not match prepared record')
    return observed.strip()


def central(args, store):
    if args.operation == 'list':
        return {p.parents[2].name: read_json(p) for p in store.tools_root.glob('*/volume/central/active.json')}
    root = home(store, args.tool)
    if args.operation == 'prepare':
        from .prepare import prepare
        # Operator configuration belongs to the central tool volume, never a consumer.
        config = root / 'preparation.json'
        with central_lock(store, args.tool, 'prepare'):
            spec = {'version': args.version}
            if args.tool == 'playwright':
                spec['variant'] = args.browsers
            atomic_json(config, {'schema': 1, 'project': 'central', 'tools': {args.tool: spec}})
            result = prepare(store, {'_path': config, '_root': REPO}, {args.tool: spec})
            if any(r['status'] != 'prepared' for r in result['tools']):
                raise ValueError('central preparation blocked; inspect tool documentation')
            record = read_json(config.with_name('preparation.images.lock.json'))['tools'][args.tool]
    elif args.operation == 'register':
        record = read_json(args.record)
    else:
        record = revision_record(root, args.revision)
    observed = verify_record(args.tool, record)
    if args.operation in ('prepare', 'register'):
        record = {**record, 'native_version': observed, 'native_verified_at': now()}
        revision = digest(record)
        atomic_json(root / 'revisions' / (revision + '.json'), record)
        return {'tool': args.tool, 'revision': revision, 'activated': False,
                'qualification': 'version verified; representative operations still required'}
    with central_lock(store, args.tool, 'activation'):
        previous = read_json(root / 'active.json') if (root / 'active.json').exists() else None
        pointer = {'revision': args.revision, 'image': record['id'], 'version': record['version'], 'activated_at': now()}
        atomic_json(root / 'history' / (uuid.uuid4().hex + '.json'), {'previous': previous, 'active': pointer})
        atomic_json(root / 'active.json', pointer)
    return pointer


@contextlib.contextmanager
def central_lock(store, name, purpose):
    # Operator locks must not move when TOOLBOX_STATE changes.
    path = home(store, name) / 'locks' / (purpose + '.lock')
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


@contextlib.contextmanager
def data_lock(store, name, write=False, deadline=None):
    path = home(store, name) / 'data.lock'
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as handle:
        operation = fcntl.LOCK_EX if write else fcntl.LOCK_SH
        while True:
            try:
                fcntl.flock(handle, operation | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if deadline and time.monotonic() >= deadline:
                    raise TimeoutError('data lock timeout')
                time.sleep(0.05)
        yield


@contextlib.contextmanager
def cache_lock(store, name, project_key, deadline):
    # Same tool may run concurrently for distinct projects; one project's native cache is serialized.
    path = home(store, name) / 'cache-locks' / project_key
    path.mkdir(parents=True, exist_ok=True)
    with path.joinpath('data.lock').open('a') as handle:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if deadline and time.monotonic() >= deadline:
                    raise TimeoutError('cache lock timeout')
                time.sleep(0.05)
        yield


def mount(source, target, mode):
    source = Path(source).expanduser().resolve(strict=True)
    if mode not in ('ro', 'rw') or not target.startswith('/') or '..' in PurePosixPath(target).parts:
        raise ValueError('mount requires an absolute container path and ro/rw')
    if any(c in str(source) + target for c in ',:\n\r\x00'):
        raise ValueError('mount paths cannot contain comma, colon or line break')
    if target in ('/', '/project', '/out', '/data', '/cache', '/db', '/tmp'):
        raise ValueError('reserved mount destination')
    return docker.bind_mount(source, target, readonly=mode == 'ro')


def environment(args, name):
    defaults = {'HOME': '/tmp', 'XDG_CACHE_HOME': '/cache', 'RUFF_CACHE_DIR': '/cache/ruff',
                'TRIVY_CACHE_DIR': '/cache', 'TRIVY_SKIP_DB_UPDATE': 'true',
                'TRIVY_SKIP_JAVA_DB_UPDATE': 'true', 'TRIVY_SKIP_CHECK_UPDATE': 'true',
                'TRIVY_SKIP_VERSION_CHECK': 'true', 'GRYPE_DB_CACHE_DIR': '/db',
                'GRYPE_DB_AUTO_UPDATE': 'false', 'GRYPE_CHECK_FOR_APP_UPDATE': 'false',
                'SYFT_CHECK_FOR_APP_UPDATE': 'false', 'PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD': '1',
                'NODE_PATH': '/opt/pw/node_modules',
                'OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY': '/db',
                'OSV_SCALIBR_LOCAL_DB_CACHE_DIRECTORY': '/db'}
    if name == 'opengrep':
        defaults['XDG_CACHE_HOME'] = '/opt/opengrep-cache'
    if args.maintenance:
        defaults['TRIVY_CACHE_DIR'] = '/db'
    selected = {}
    for filename in args.env_file:
        for line in Path(filename).read_text().splitlines():
            if not line or line.startswith('#'):
                continue
            key, sep, value = line.partition('=')
            if not re.fullmatch('[A-Za-z_][A-Za-z0-9_]*', key):
                raise ValueError('invalid environment file')
            if sep:
                selected[key] = value
            elif key in os.environ:
                selected[key] = os.environ[key]
    for item in args.env:
        key, sep, value = item.partition('=')
        if not re.fullmatch('[A-Za-z_][A-Za-z0-9_]*', key):
            raise ValueError('invalid environment variable name')
        if not sep and key not in os.environ:
            raise ValueError('selected environment variable is absent')
        selected[key] = value if sep else os.environ[key]
    return {**defaults, **selected}


def create_command(args, record, name, cache, data, database=None):
    root = args.project_root.expanduser().resolve(strict=True)
    if not root.is_dir() or any(c in str(root) for c in ',\n\r\x00'):
        raise ValueError('invalid project root')
    if not args.workdir.startswith('/') or '..' in PurePosixPath(args.workdir).parts:
        raise ValueError('workdir must be an absolute container path without ..')
    cmd = ['docker', 'create', '--pull=never', '--name', name, '--init', '--read-only',
           '--user', f'{os.getuid()}:{os.getgid()}', '--cap-drop=ALL',
           '--security-opt=no-new-privileges:true', '--network', args.network,
           '--tmpfs', '/tmp:rw,nosuid,nodev,mode=1777', '--shm-size=1g',
           *docker.bind_mount(root, '/project', readonly=not args.project_write),
           *docker.bind_mount(cache, '/cache'),
           *docker.bind_mount(data, '/data', readonly=not args.maintenance),
           '--workdir', args.workdir]
    if database:
        cmd += docker.bind_mount(database, '/db', readonly=not args.maintenance)
        if args.tool == 'trivy' and not args.maintenance:
            for folder in ('db', 'java-db'):
                if (database / folder).is_dir():
                    cmd += docker.bind_mount(database / folder, '/cache/' + folder, readonly=True)
    if args.results:
        output = args.results.expanduser().resolve()
        output.mkdir(parents=True, exist_ok=True)
        if any(c in str(output) for c in ',\n\r\x00'):
            raise ValueError('invalid results mount path')
        cmd += docker.bind_mount(output, '/out')
    targets = set()
    for item in args.mount:
        try:
            source, target, mode = item.rsplit(':', 2)
        except ValueError:
            raise ValueError('mount syntax: HOST:CONTAINER:ro|rw') from None
        if target in targets:
            raise ValueError('duplicate mount destination')
        targets.add(target)
        cmd += mount(source, target, mode)
    for flag in ('add_host', 'publish', 'device'):
        for value in getattr(args, flag):
            cmd += ['--' + flag.replace('_', '-'), value]
    # Values are sent via Docker CLI environment, never persisted in executor metadata.
    env = environment(args, args.tool)
    for key in env:
        cmd += ['--env', key]
    if args.stdin:
        cmd += ['--interactive']
    if args.tty:
        cmd += ['--tty']
    flags, prefix = entrypoint(args.tool) if args.tool == 'playwright' else ([], [])
    return [*cmd, *flags, record['id'], *prefix, *args.native[1:]], {**os.environ, **env}


def execute(args, store):
    run_id = uuid.uuid4().hex
    metadata = {'run': run_id, 'tool': args.tool, 'started_at': now(), 'outcome': 'infrastructure', 'native_exit_code': None}
    destination = None
    name = 'toolbox-native-' + run_id
    created = False
    previous_handlers = {}
    interrupted = [None]
    running = [False]
    def receive(signum, frame):
        interrupted[0] = signum
        if not running[0]:
            raise KeyboardInterrupt
    try:
        if not args.native or args.native[0] != '--':
            raise ValueError('native arguments must follow --')
        if args.timeout is not None and (not math.isfinite(args.timeout) or args.timeout <= 0):
            raise ValueError('timeout must be positive and finite')
        if args.tty and (not sys.stdin.isatty() or not sys.stdout.isatty()):
            raise ValueError('TTY requires terminal stdin and stdout')
        if args.tty and (args.stdout_file or args.stderr_file):
            raise ValueError('TTY merges streams; additional stream files require non-TTY mode')
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            previous_handlers[sig] = signal.signal(sig, receive)
        deadline = time.monotonic() + args.timeout if args.timeout else None
        root = home(store, args.tool)
        destination = root / 'executions' / (run_id + '.json')
        metadata['phase'] = 'resolve_active'
        record = active(store, args.tool)  # resolve exactly once, before container creation
        metadata['phase'] = 'inspect_image'
        info = docker.inspect(record['id'], timeout=max(0.001, deadline-time.monotonic()) if deadline else 30)
        if info['Id'] != record['id']:
            raise ValueError('active image identity mismatch')
        metadata.update(version=record['version'], image=record['id'], repo_digests=info.get('RepoDigests', []))
        with data_lock(store, args.tool, args.maintenance, deadline), contextlib.ExitStack() as stack:
            project_key = digest(str(args.project_root.resolve()))
            stack.enter_context(cache_lock(store, args.tool, project_key, deadline))
            cache = store.volume(args.tool) / 'native-cache' / project_key
            data = store.volume(args.tool) / 'native-data'
            cache.mkdir(parents=True, exist_ok=True)
            data.mkdir(parents=True, exist_ok=True)
            database = None
            if args.tool in ('trivy', 'grype', 'osv-scanner'):
                metadata['phase'] = 'inspect_database'
                from .databases import inspect_database
                pointer = store.volume(args.tool) / 'databases' / record['version'] / 'current.json'
                if pointer.exists():
                    db = inspect_database(store, args.tool, record['version'], read_json(pointer)['database'])
                    database = Path(db['path'])
                    metadata['database'] = db['database']
                if args.maintenance:
                    staging = store.preparation_dir(args.tool)
                    writable = staging / 'data'
                    if database:
                        shutil.copytree(database, writable)
                    else:
                        writable.mkdir()
                    database = writable
            metadata['phase'] = 'configure_container'
            command, env = create_command(args, record, name, cache, data, database)
            if interrupted[0]:
                raise KeyboardInterrupt
            # Do not expose Docker errors: they can include native argv or secret values.
            metadata['phase'] = 'create_container'
            running[0] = True
            created = True  # also clean up a partially completed create
            result = subprocess.run(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    timeout=max(0.001, deadline - time.monotonic()) if deadline else None)
            if result.returncode:
                raise ValueError('Docker create failed; check image, mounts, network and Docker daemon')
            stdout = stack.enter_context(args.stdout_file.open('xb')) if args.stdout_file else None
            stderr = stack.enter_context(args.stderr_file.open('xb')) if args.stderr_file else None
            # Explicit files replace their stream (like shell redirection); no decoding.
            metadata['phase'] = 'execute_native'
            process = subprocess.Popen(['docker', 'start', '--attach', *(['--interactive'] if args.stdin else []), name],
                                       stdin=None if args.stdin else subprocess.DEVNULL, stdout=stdout, stderr=stderr,
                                       start_new_session=not args.tty)
            cause = None
            while process.poll() is None:
                if interrupted[0] or (deadline and time.monotonic() >= deadline):
                    cause = 'cancelled' if interrupted[0] else 'timeout'
                    sig = signal.Signals(interrupted[0]).name if interrupted[0] else 'SIGTERM'
                    try:
                        docker.capture(['kill', '--signal', sig, name], timeout=10)
                        docker.capture(['stop', '--time', '3', name], timeout=10)
                    except docker.DockerError:
                        pass
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
                    break
                time.sleep(0.05)
            if interrupted[0] and cause is None:
                cause = 'cancelled'
                docker.capture(['stop', '--time', '3', name], timeout=10)
            state = json.loads(docker.capture(['inspect', '--format', '{{json .State}}', name]))
            if state.get('Running') or state.get('Status') != 'exited' or state.get('Error'):
                raise ValueError('container did not complete native execution')
            metadata.update(outcome=cause or 'native', native_exit_code=state['ExitCode'],
                            runtime_exit_code=process.returncode, oom_killed=state.get('OOMKilled', False))
            if cause is None and state['ExitCode'] == 0 and args.maintenance and database:
                from .databases import publish_database
                published = publish_database(store, args.tool, {'version': record['version']}, record, staging,
                                             {'maintenance_run': run_id})
                metadata['published_database'] = published['database']
            return 124 if cause == 'timeout' else 128 + interrupted[0] if cause else state['ExitCode']
    except (TimeoutError, subprocess.TimeoutExpired):
        metadata['outcome'] = 'timeout'
        return 124
    except KeyboardInterrupt:
        metadata['outcome'] = 'cancelled'
        return 128 + (interrupted[0] or signal.SIGINT)
    except (OSError, ValueError, KeyError, docker.DockerError):
        # Never persist exception text: third-party diagnostics may contain secrets.
        metadata['outcome'] = 'infrastructure'
        metadata['diagnostic'] = 'execution prerequisite or Docker operation failed; use doctor and central list'
        return metadata['native_exit_code'] if metadata['native_exit_code'] is not None else 125
    finally:
        if created:
            try:
                docker.capture(['rm', '--force', name])
                metadata['cleanup'] = 'removed'
            except docker.DockerError:
                metadata['cleanup'] = 'failed'
        for sig, handler in previous_handlers.items():
            signal.signal(sig, handler)
        metadata['finished_at'] = now()
        if destination:
            atomic_json(destination, metadata)
            destination.chmod(0o600)
        if args.diagnostic_file:
            atomic_json(args.diagnostic_file, metadata)
            args.diagnostic_file.chmod(0o600)
        if metadata['outcome'] == 'infrastructure':
            print('toolbox: infrastructure failure; inspect central execution metadata and toolbox doctor', file=sys.stderr)
