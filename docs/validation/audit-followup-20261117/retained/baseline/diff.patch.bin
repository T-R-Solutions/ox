diff --git a/scripts/lib/backends.sh b/scripts/lib/backends.sh
index a15bae1..3f5e7f0 100644
--- a/scripts/lib/backends.sh
+++ b/scripts/lib/backends.sh
@@ -98,7 +98,7 @@ run_toolbox() {
     ' "${output}/backend_record.json" >/dev/null || fail_check 'Executor infrastructure, timeout, cancellation, cleanup or identity failure; inspect diagnostic'
     case ${name} in
         osv|trivy)
-            validate_database_age "${output}/backend_record.json" "${name}" || fail_check 'Invalid, inconsistent or expired central database metadata';;
+            validate_database_metadata "${output}/backend_record.json" "${name}" || fail_check 'Invalid, inconsistent or expired central database metadata';;
         grype)
             jq -e '.database|type=="string" and test("^[0-9a-f]{64}$")' "${output}/backend_record.json" >/dev/null || fail_check 'Missing central database identity';;
         *) :;; # Other validated classifications require no action.
@@ -135,11 +135,17 @@ run_toolbox() {
     [[ ${wrapper_sha} == "${tool_sha}" ]] || fail_check 'Wrapper changed during check'
 }
 
-# Consumer age policy; timestamps identify upstream data, never local preparation.
-validate_database_age() {
-    local record=$1 age_policy=$2 limit=86400 oldest=9223372036854775807 value epoch effective current
-    catalog_load
-    limit=$(jq -er --arg policy "${age_policy}" '.databases[$policy].maximum_age_seconds' <<<"${AUTOMATION_JSON}") || return 1
+# OSV acquisition freshness belongs to Toolbox; upstream dates are provenance only.
+# Trivy retains the consumer age policy on its native database timestamps.
+validate_database_metadata() {
+    local record=$1 age_policy=$2 limit oldest=9223372036854775807 value epoch effective current
+    case ${age_policy} in
+        osv) :;;
+        trivy)
+            catalog_load
+            limit=$(jq -er '.databases.trivy.maximum_age_seconds | select(type=="number" and floor==. and .>0)' <<<"${AUTOMATION_JSON}") || return 1;;
+        *) return 1;;
+    esac
     jq -e '
       (.database|type=="string" and test("^[0-9a-f]{64}$")) and
       (.database_metadata as $m | $m.schema==1 and $m.snapshot==.database and
@@ -158,7 +164,9 @@ validate_database_age() {
     for value in "${timestamps[@]}"; do
         [[ ${value} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$ ]] || return 1
         epoch=$(date -ud "${value}" +%s) || return 1
-        ((epoch<=current && current-epoch<=limit)) || return 1
+        if [[ ${age_policy} == trivy ]]; then
+            ((epoch<=current && current-epoch<=limit)) || return 1
+        fi
         ((epoch>=oldest)) || oldest=${epoch}
     done
     value=$(jq -r '.database_metadata.data_timestamp' "${record}") || return 1
diff --git a/scripts/lib/process.sh b/scripts/lib/process.sh
index cd85bae..03ec2c9 100644
--- a/scripts/lib/process.sh
+++ b/scripts/lib/process.sh
@@ -7,12 +7,17 @@ execute() {
     shift 2
     mkdir -- "${directory}"
     local rc=0 state=passed
-    local child signal_received=false
-    (cd -- "${cwd}" && exec "$@") </dev/null >"${directory}/stdout.log" 2>"${directory}/stderr.log" &
+    local child signal_received=false cancelled=false received_signal='' saved_traps depth=${OX_EXECUTE_DEPTH:-0}
+    saved_traps=$(trap -p INT TERM HUP)
+    PROCESS_CANCELLED=false
+    (export OX_EXECUTE_DEPTH=$((depth+1)); cd -- "${cwd}" && exec "$@") </dev/null >"${directory}/stdout.log" 2>"${directory}/stderr.log" &
     child=$!
     # Forward cancellation; wait through the executor's own cleanup, without a
     # competing outer timeout. Never signal other executions or process groups.
-    trap 'signal_received=true; kill -TERM "$child" 2>/dev/null || true' INT TERM HUP
+    trap 'signal_received=true; cancelled=true; received_signal=INT; kill -TERM "$child" 2>/dev/null || true' INT
+    trap 'signal_received=true; cancelled=true; received_signal=TERM; kill -TERM "$child" 2>/dev/null || true' TERM
+    trap 'signal_received=true; cancelled=true; received_signal=HUP; kill -TERM "$child" 2>/dev/null || true' HUP
+    if [[ ${OX_HUMAN_PROGRESS:-false} == true && ${depth} == 0 ]]; then progress_watch_start "${child}"; fi
     while true; do
         rc=0
         wait "${child}" || rc=$?
@@ -23,13 +28,18 @@ execute() {
         break
     done
     trap - INT TERM HUP
-    cat -- "${directory}/stdout.log"
-    cat -- "${directory}/stderr.log" >&2
+    [[ -z ${saved_traps} ]] || eval "${saved_traps}"
+    if [[ ${OX_HUMAN_PROGRESS:-false} == true && ${depth} == 0 ]]; then progress_watch_stop
+    else
+        cat -- "${directory}/stdout.log"
+        cat -- "${directory}/stderr.log" >&2
+    fi
     if ((rc==126 || rc==127)); then state=blocked
     elif ((rc)); then state=failed; fi
-    jq -n --arg cwd "${cwd}" --arg state "${state}" --argjson code "${rc}" \
-       '{argv_recorded:false,cwd:$cwd,exit_code:$code,state:$state}' >"${directory}/process.json"
+    jq -n --arg cwd "${cwd}" --arg state "${state}" --argjson code "${rc}" --argjson cancelled "${cancelled}" --arg signal "${received_signal}" \
+       '{argv_recorded:false,cwd:$cwd,exit_code:$code,state:$state} + (if $cancelled then {cancelled:true,signal:$signal} else {} end)' >"${directory}/process.json"
     PROCESS_CODE=${rc}
+    PROCESS_CANCELLED=${cancelled}
 }
 
 installed_cargo() {
diff --git a/scripts/tests/test_backends.py b/scripts/tests/test_backends.py
index 525ea7d..771595d 100644
--- a/scripts/tests/test_backends.py
+++ b/scripts/tests/test_backends.py
@@ -36,7 +36,7 @@ assert '--project-write' not in a and '--network' not in a and '--mount' not in
 assert '--timeout' in a and '--' in a
 native=a[a.index('--')+1:]; assert native
 mode=os.environ.get('FIXTURE_MODE','clean')
-count=1 if mode=='finding' else 0
+count=1 if mode in ('finding','old-upstream-finding') else 0
 code=0
 if tool=='gitleaks':
  assert '--redact=100' in native and '--ignore-gitleaks-allow' in native
@@ -57,6 +57,9 @@ elif tool=='opengrep':
 elif tool=='syft': report={'descriptor':{},'artifacts':[{}]}
 elif tool=='yara-x': report={'version':'1.0.0','matches':[{'rule':'fixture','file':'fixture'}]*count}
 elif tool=='grype': report={'descriptor':{},'source':{},'matches':[{}]*count}
+elif tool=='osv-scanner':
+ assert '--offline' in native and '--all-packages' in native
+ report={'results':[{'packages':[{'package':{'name':'fixture'},'vulnerabilities':[{'id':'TEST-1'}]*count}]}]}; code=1 if count else 0
 else: report={}
 if mode=='exit-disagreement': code=0; report=[{'code':'F821'}]
 if mode=='omit' and tool=='bandit': report['metrics']={'other':{}}
@@ -66,6 +69,9 @@ if mode=='mutate': (root/'scripts/probe.py').write_text('changed')
 if mode=='mode': (root/'scripts/probe.py').chmod(0o777)
 if mode=='add': (Path(os.environ['FIXTURE_PROJECT'])/'scripts/new source.py').write_text('x=1')
 d={'tool':tool,'version':'fixture','image':'sha256:'+'a'*64,'database':'b'*64,'native_exit_code':code,'outcome':'native','cleanup':'removed'}
+if tool=='osv-scanner' and mode.startswith('old-upstream'):
+ timestamp='2000-01-01T00:00:00Z'
+ d['database_metadata']={'schema':1,'snapshot':'b'*64,'data_timestamp':timestamp,'timestamp_semantics':'oldest_required_source','sources':[{'url':'https://official.example','sha256':'c'*64,'data_timestamp':timestamp,'timestamp_semantics':'upstream_object_generation_created'}]*2}
 if mode in ('timeout','cancelled','infrastructure'): d['outcome']=mode; d['native_exit_code']=None; code=124
 if mode=='cleanup': d['cleanup']='failed'
 if mode=='identity': d['image']='mutable'
@@ -174,6 +180,14 @@ if select_backend; then json_args "$TOOL_BIN"; else json_args "$BACKEND_REASON";
         self.assertEqual(row["state"], "error", row)
         self.assertIn("inventory", row["reason"])
 
+    def test_osv_old_upstream_provenance_passes_and_findings_still_fail(self):
+        for mode, expected in (("old-upstream", "passed"), ("old-upstream-finding", "findings")):
+            with self.subTest(mode=mode):
+                run, row = self.run_check("osv", mode)
+                self.assertEqual(row["state"], expected, (run.stderr, row))
+                self.assertEqual(run.returncode, 0 if expected == "passed" else 1)
+                self.assertFalse(row["product_acceptance"])
+
     def test_inventory_and_age_gaps(self):
         run, row = self.run_check("bandit", "omit")
         self.assertNotEqual(run.returncode, 0, row)
