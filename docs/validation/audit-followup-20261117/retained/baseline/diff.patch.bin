+                &renderer,
+                &layout::Limits::new(iced::Size::ZERO, iced::Size::new(width, height)),
+            );
+            let regions = node.children()[0].children();
+            assert!(
+                regions[0].bounds().height <= 60.0,
+                "chrome consumes work area at {width}"
