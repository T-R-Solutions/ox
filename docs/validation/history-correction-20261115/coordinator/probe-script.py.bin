from pathlib import Path
import tempfile,subprocess,json,os,shutil,hashlib
root=Path.cwd(); evidence=root/'docs/validation/history-correction-20261115'; temp=Path(tempfile.mkdtemp(prefix='ox-history-probe-'));src=temp/'source';src.mkdir();(src/'docs').mkdir()
shutil.copy(root/'scripts/config/native/gitleaks/gitleaks.toml',src/'policy.toml');shutil.copy(root/'scripts/config/native/gitleaks/gitleaks-history.ignore',src/'reviewed.ignore')
# Deliberately synthetic, generated only inside the disposable project; no real credential.
(src/'docs'/'example.md').write_text('api_key = "'+hashlib.sha256(b'ox-history-synthetic-secret-control-20261115').hexdigest()[:40]+'"\n')
for cmd in [['git','init',str(src)],['git','-C',str(src),'add','docs/example.md'],['git','-C',str(src),'-c','user.name=Ox controlled fixture','-c','user.email=fixture@example.invalid','-c','commit.gpgsign=false','commit','-m','controlled fixture']]:
 subprocess.run(cmd,check=True,capture_output=True)
env=os.environ|{'TOOLBOX_BIN':'/home/rodrigo/Projetos/dev_audit/shared-toolbox/bin/toolbox','TOOLBOX_SELINUX_LABEL':'shared'}
results=[]
def scan(name,mode,ignore):
 out=temp/name;out.mkdir();cmd=['bash',str(root/'scripts/toolbox.sh'),'exec','--tool','gitleaks','--project-root',str(src),'--results',str(out),'--diagnostic-file',str(out/'diagnostic.json'),'--',mode,'--config','/project/policy.toml','--redact=100','--ignore-gitleaks-allow','--exit-code','10','--report-format','json','--report-path','/out/report.json']
 if mode=='git':cmd+=['--log-opts=--all']
 cmd+=['--gitleaks-ignore-path',f'/project/{ignore}','/project']
 r=subprocess.run(cmd,env=env,capture_output=True);target=evidence/'probes'/name;target.mkdir(parents=True)
 for p in out.iterdir():
  if p.is_file():shutil.copy(p,target/p.name)
 (target/'stdout.log').write_bytes(r.stdout);(target/'stderr.log').write_bytes(r.stderr)
 report=json.loads((out/'report.json').read_text());row={'name':name,'exit_code':r.returncode,'finding_count':len(report),'fingerprints':[v['Fingerprint'] for v in report],'method':' '.join(cmd),'synthetic_fixture':True};results.append(row);return report
baseline=scan('history-new-doc-secret','git','reviewed.ignore');assert len(baseline)==1 and results[-1]['exit_code']==10
fp=baseline[0]['Fingerprint'];(src/'exact.ignore').write_text(fp+'\n');exact=scan('history-exact-fingerprint','git','exact.ignore');assert not exact and results[-1]['exit_code']==0
parts=fp.split(':');parts[-1]=str(int(parts[-1])+1);(src/'altered.ignore').write_text(':'.join(parts)+'\n');changed=scan('history-altered-fingerprint','git','altered.ignore');assert len(changed)==1 and results[-1]['exit_code']==10
current=scan('current-doc-secret','dir','reviewed.ignore');assert len(current)==1 and results[-1]['exit_code']==10
(evidence/'probes'/'results.json').write_text(json.dumps({'temporary_project':str(src),'results':results,'limits':['Disposable local Git repository only; four real Gitleaks invocations; no product acceptance.']},indent=2)+'\n')
print(json.dumps([{'name':r['name'],'exit_code':r['exit_code'],'finding_count':r['finding_count']} for r in results]))
