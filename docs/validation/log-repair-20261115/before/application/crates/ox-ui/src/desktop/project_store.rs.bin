//! Bounded convenience metadata, independent from task/evidence persistence.
//!
//! All cooperating local writers lock the stable sidecar before reading afresh.
//! Publication is a same-directory rename after syncing the staged snapshot.
//! This Linux/local-filesystem contract does not confine hostile path replacement
//! or establish power-loss durability. Never run these blocking operations in a view.

use std::ffi::OsString;
use std::fs::{self, File, OpenOptions};
use std::io::{self, Read, Write};
use std::path::{Component, Path, PathBuf};
use std::sync::atomic::{AtomicU64, Ordering};

const MAGIC: &[u8; 8] = b"OXRECENT";
const VERSION: u32 = 1;
const MAX_ENTRIES: usize = 20;
const MAX_PATH_BYTES: usize = 16 * 1024;
const MAX_SNAPSHOT_BYTES: usize = 16 + MAX_ENTRIES * (4 + MAX_PATH_BYTES);
static NEXT_FILE: AtomicU64 = AtomicU64::new(0);

pub(super) fn history_path() -> Result<PathBuf, String> {
    state_path(std::env::var_os("XDG_STATE_HOME"), std::env::var_os("HOME"))
}

fn state_path(xdg: Option<OsString>, home: Option<OsString>) -> Result<PathBuf, String> {
    let root = match xdg.filter(|value| !value.is_empty()) {
        Some(value) => PathBuf::from(value),
        None => PathBuf::from(home.ok_or("HOME não está disponível para os recentes.")?)
            .join(".local/state"),
    };
    if !root.is_absolute() {
        return Err("O diretório de estado dos recentes deve ser absoluto.".into());
    }
    Ok(root.join("ox/recent-projects.v1"))
}

pub(super) struct RecentStore {
    path: PathBuf,
}

impl RecentStore {
    pub(super) fn new(path: PathBuf) -> Self {
        Self { path }
    }

    pub(super) fn load(&self) -> Result<Vec<PathBuf>, String> {
        let _lock = self.lock()?;
        self.read().map_err(|error| error.message())
    }

    pub(super) fn record(&self, path: &Path) -> Result<Vec<PathBuf>, String> {
        let canonical = fs::canonicalize(path)
            .map_err(|error| format!("Não foi possível localizar o projeto: {error}"))?;
        if !canonical.is_dir() {
            return Err("O projeto deve ser um diretório existente.".into());
        }
        validate_path(&canonical).map_err(|reason| format!("Projeto inválido: {reason}"))?;
        let _lock = self.lock()?;
        let mut entries = self.read().map_err(|error| error.message())?;
        entries.retain(|entry| entry != &canonical);
        entries.insert(0, canonical);
        entries.truncate(MAX_ENTRIES);
        self.publish(&entries)?;
        Ok(entries)
    }

    pub(super) fn remove(&self, path: &Path) -> Result<Vec<PathBuf>, String> {
        // Missing projects remain removable. UI passes the stored canonical identity.
        validate_path(path).map_err(|reason| format!("Caminho inválido: {reason}"))?;
        let _lock = self.lock()?;
        let mut entries = self.read().map_err(|error| error.message())?;
        entries.retain(|entry| entry != path);
        self.publish(&entries)?;
        Ok(entries)
    }

    pub(super) fn reset(&self) -> Result<Vec<PathBuf>, String> {
        let _lock = self.lock()?;
        match self.read() {
            Ok(_) => {}
            Err(ReadError::Corrupt(_)) => self.backup()?,
            Err(error) => return Err(error.message()),
        }
        self.publish(&[])?;
        Ok(Vec::new())
    }

    fn parent(&self) -> Result<&Path, String> {
        if !self.path.is_absolute() || self.path.file_name().is_none() {
            return Err("O arquivo dos recentes deve ter um caminho absoluto válido.".into());
        }
        if self
            .path
            .components()
            .any(|part| matches!(part, Component::ParentDir))
        {
            return Err("O caminho dos recentes não pode conter '..'.".into());
        }
        self.path
            .parent()
            .ok_or_else(|| "Diretório de estado inválido.".into())
    }

    fn lock_path(&self) -> PathBuf {
        let mut name = self.path.as_os_str().to_os_string();
        name.push(".lock");
        PathBuf::from(name)
    }

    fn lock(&self) -> Result<LockedFile, String> {
        ensure_directory(self.parent()?)?;
        let path = self.lock_path();
        let lock = open_regular(&path, true)
            .map_err(|error| format!("Não foi possível acessar o lock dos recentes: {error}"))?
            .ok_or("Lock dos recentes indisponível.")?;
        lock.try_lock().map_err(|error| {
            format!("Recentes ocupados ou indisponíveis; tente novamente depois: {error}")
        })?;
        // Never unlink the sidecar: replacing its inode would allow two
        // independently locked writers.
        Ok(LockedFile(lock))
    }

    fn read(&self) -> Result<Vec<PathBuf>, ReadError> {
        let Some(file) =
            open_regular(&self.path, false).map_err(|error| ReadError::Io(error.to_string()))?
        else {
            return Ok(Vec::new());
        };
        let mut bytes = Vec::new();
        file.take((MAX_SNAPSHOT_BYTES + 1) as u64)
            .read_to_end(&mut bytes)
            .map_err(|error| ReadError::Io(error.to_string()))?;
        decode(&bytes)
    }

    fn publish(&self, entries: &[PathBuf]) -> Result<(), String> {
        let bytes = encode(entries);
        // Staging is unique; abandoned stages from interrupted processes are never
        // promoted on startup or mistaken for the committed snapshot.
        let (path, mut file) = self.exclusive_file("stage")?;
        let mut stage = Stage {
            path,
            published: false,
        };
        file.write_all(&bytes)
            .and_then(|()| file.sync_all())
            .map_err(|error| format!("Não foi possível preparar os recentes: {error}"))?;
        // Validate the destination again; cooperative writers still hold the lock.
        open_regular(&self.path, false)
            .map_err(|error| format!("Destino dos recentes inválido: {error}"))?;
        fs::rename(&stage.path, &self.path)
            .map_err(|error| format!("Não foi possível publicar os recentes: {error}"))?;
        stage.published = true;
        self.sync_parent().map_err(|error| {
            format!("Recentes publicados, mas a sincronização falhou; o estado pode já estar aplicado: {error}")
        })
    }

    fn backup(&self) -> Result<(), String> {
        let source = open_regular(&self.path, false)
            .map_err(|error| format!("Não foi possível preservar os recentes: {error}"))?
            .ok_or("O arquivo dos recentes mudou antes do backup.")?;
        if source.metadata().map_err(|error| error.to_string())?.len() > MAX_SNAPSHOT_BYTES as u64 {
            return Err("Histórico excede o limite de tamanho. O original foi preservado; mova-o manualmente para um backup antes de redefinir os recentes.".into());
        }
        let (path, mut backup) = self.exclusive_file("corrupt-backup")?;
        // Bound explicit recovery too; do not copy arbitrary oversized files.
        // A failed/partial backup stays visible and the original is not overwritten.
        let copied = io::copy(
            &mut source.take((MAX_SNAPSHOT_BYTES + 1) as u64),
            &mut backup,
        )
        .map_err(|error| {
            format!(
                "Backup incompleto em {}; o original foi preservado: {error}",
                path.display()
            )
        })?;
        if copied > MAX_SNAPSHOT_BYTES as u64 {
            return Err(format!(
                "Histórico cresceu durante o backup em {}; o original foi preservado. Recuperação manual necessária.",
                path.display()
            ));
        }
        backup
            .sync_all()
            .and_then(|()| self.sync_parent())
            .map_err(|error| {
                format!(
                    "Backup incompleto em {}; o original foi preservado: {error}",
                    path.display()
                )
            })
    }

    fn exclusive_file(&self, kind: &str) -> Result<(PathBuf, File), String> {
        for _ in 0..32 {
            let mut name = self.path.as_os_str().to_os_string();
            name.push(format!(
                ".{kind}-{}-{}",
                std::process::id(),
                NEXT_FILE.fetch_add(1, Ordering::Relaxed)
            ));
            let path = PathBuf::from(name);
            match OpenOptions::new().write(true).create_new(true).open(&path) {
                Ok(file) => return Ok((path, file)),
                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
                Err(error) => {
                    return Err(format!(
                        "Não foi possível criar {kind} dos recentes: {error}"
                    ));
                }
            }
        }
        Err(format!(
            "Não foi possível reservar {kind} exclusivo para os recentes."
        ))
    }

    fn sync_parent(&self) -> io::Result<()> {
        File::open(self.parent().map_err(io::Error::other)?)?.sync_all()
    }
}

struct LockedFile(File);

impl Drop for LockedFile {
    fn drop(&mut self) {
        // An unrelated concurrent fork can temporarily inherit open descriptors.
        // Explicit unlock releases this open-file-description lock immediately,
        // rather than waiting for the child's exec/exit to close inherited copies.
        let _ = self.0.unlock();
    }
}

struct Stage {
    path: PathBuf,
    published: bool,
}

impl Drop for Stage {
    fn drop(&mut self) {
        if !self.published {
            let _ = fs::remove_file(&self.path);
        }
    }
}

enum ReadError {
    Corrupt(String),
    Unsupported(u32),
    Io(String),
}

impl ReadError {
    fn message(self) -> String {
        match self {
            Self::Corrupt(reason) => format!(
                "Histórico de recentes corrompido ({reason}). Use Redefinir recentes para preservar um backup e começar vazio."
            ),
            Self::Unsupported(version) => format!(
                "Versão {version} do histórico não suportada. O arquivo foi preservado; use uma versão compatível do Ox."
            ),
            Self::Io(reason) => {
                format!("Não foi possível ler os recentes; o arquivo foi preservado: {reason}")
            }
        }
    }
}

fn open_regular(path: &Path, create: bool) -> io::Result<Option<File>> {
    match fs::symlink_metadata(path) {
        Ok(metadata) if !metadata.file_type().is_file() => {
            return Err(io::Error::other(
                "links e arquivos especiais não são permitidos",
            ));
        }
        Ok(_) => {}
        Err(error) if error.kind() == io::ErrorKind::NotFound && create => {
            match OpenOptions::new()
                .read(true)
                .write(true)
                .create_new(true)
                .open(path)
            {
                Ok(file) => return Ok(Some(file)),
                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
                    return open_regular(path, false);
                }
                Err(error) => return Err(error),
            }
        }
        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
        Err(error) => return Err(error),
    }
    let file = OpenOptions::new().read(true).write(create).open(path)?;
    if !file.metadata()?.is_file() {
        return Err(io::Error::other("o arquivo de estado não é regular"));
    }
    Ok(Some(file))
}

fn ensure_directory(path: &Path) -> Result<(), String> {
    let mut current = PathBuf::new();
    for part in path.components() {
        current.push(part);
        match fs::symlink_metadata(&current) {
            Ok(metadata) if metadata.file_type().is_dir() => {}
            Ok(_) => {
                return Err(format!(
                    "Diretório de estado inválido: {} (links não são permitidos).",
                    current.display()
                ));
            }
            Err(error) if error.kind() == io::ErrorKind::NotFound => {
                match fs::create_dir(&current) {
                    Ok(()) => {}
                    Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
                        if !fs::symlink_metadata(&current)
                            .is_ok_and(|metadata| metadata.file_type().is_dir())
                        {
                            return Err("O diretório de estado mudou durante a criação.".into());
                        }
                    }
                    Err(error) => {
                        return Err(format!(
                            "Não foi possível criar o diretório dos recentes: {error}"
                        ));
                    }
                }
            }
            Err(error) => {
                return Err(format!(
                    "Não foi possível acessar o diretório dos recentes: {error}"
                ));
            }
        }
    }
    Ok(())
}

fn validate_path(path: &Path) -> Result<(), &'static str> {
    let text = path.to_str().ok_or("o caminho deve ser UTF-8")?;
    if !path.is_absolute() || text.is_empty() || text.contains('\0') || text.len() > MAX_PATH_BYTES
    {
        return Err("o caminho deve ser absoluto, UTF-8 e limitado a 16384 bytes");
    }
    if path
        .components()
        .any(|part| matches!(part, Component::ParentDir | Component::CurDir))
    {
        return Err("o caminho deve estar normalizado");
    }
    let normalized: PathBuf = path.components().collect();
    if normalized.as_os_str() != path.as_os_str() {
        return Err("o caminho deve estar normalizado");
    }
    Ok(())
}

fn encode(entries: &[PathBuf]) -> Vec<u8> {
    let mut bytes = Vec::new();
    bytes.extend_from_slice(MAGIC);
    bytes.extend_from_slice(&VERSION.to_le_bytes());
    bytes.extend_from_slice(&(entries.len() as u32).to_le_bytes());
    for path in entries {
        let text = path.to_str().expect("validated UTF-8 snapshot");
        bytes.extend_from_slice(&(text.len() as u32).to_le_bytes());
        bytes.extend_from_slice(text.as_bytes());
    }
    bytes
}

fn decode(bytes: &[u8]) -> Result<Vec<PathBuf>, ReadError> {
    let invalid = |reason: &str| ReadError::Corrupt(reason.into());
    if bytes.get(..8) != Some(MAGIC) {
        return Err(invalid("assinatura inválida ou truncada"));
    }
    let mut cursor = 8;
    let mut number = || {
        let slice = bytes.get(cursor..cursor + 4)?;
        cursor += 4;
        Some(u32::from_le_bytes(slice.try_into().ok()?))
    };
    let version = number().ok_or_else(|| invalid("versão truncada"))?;
    if version != VERSION {
        return Err(ReadError::Unsupported(version));
    }
    let count = number().ok_or_else(|| invalid("contagem truncada"))? as usize;
    if count > MAX_ENTRIES || bytes.len() > MAX_SNAPSHOT_BYTES {
        return Err(invalid("limite de tamanho excedido"));
    }
    let mut entries = Vec::with_capacity(count);
    for _ in 0..count {
        let length = bytes
            .get(cursor..cursor + 4)
            .ok_or_else(|| invalid("tamanho truncado"))?;
        cursor += 4;
        let length = u32::from_le_bytes(length.try_into().expect("four-byte slice")) as usize;
        if length == 0 || length > MAX_PATH_BYTES {
            return Err(invalid("tamanho de caminho inválido"));
        }
        let text = bytes
            .get(cursor..cursor + length)
            .ok_or_else(|| invalid("caminho truncado"))?;
        cursor += length;
        let text = std::str::from_utf8(text).map_err(|_| invalid("UTF-8 inválido"))?;
        let path = PathBuf::from(text);
        validate_path(&path).map_err(invalid)?;
        if entries.contains(&path) {
            return Err(invalid("caminho duplicado"));
        }
        entries.push(path);
    }
    if cursor != bytes.len() {
        return Err(invalid("bytes excedentes"));
    }
    Ok(entries)
}

pub(super) fn create_project(parent: &Path, name: &str) -> Result<PathBuf, String> {
    if name.trim().is_empty() || name.contains(['/', '\\', '\0']) {
        return Err("Escolha um nome não vazio, sem separadores de caminho.".into());
    }
    let mut components = Path::new(name).components();
    if !matches!(components.next(), Some(Component::Normal(_))) || components.next().is_some() {
        return Err("O nome deve ser um único componente; '.' e '..' não são permitidos.".into());
    }
    let parent =
        fs::canonicalize(parent).map_err(|error| format!("A pasta pai deve existir: {error}"))?;
    if !parent.is_dir() {
        return Err("A pasta pai deve ser um diretório existente.".into());
    }
    let destination = parent.join(name);
    fs::create_dir(&destination).map_err(|error| {
        format!(
            "Não foi possível criar {}: {error}. Nenhum destino existente foi substituído.",
            destination.display()
        )
    })?;
    Ok(destination)
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::process::Command;
    use std::sync::{Arc, Barrier};

    struct Fixture(PathBuf);

    impl Fixture {
        fn new() -> Self {
            let path = std::env::temp_dir().join(format!(
                "ox-project-store-tests-{}-{}",
                std::process::id(),
                NEXT_FILE.fetch_add(1, Ordering::Relaxed)
            ));
            fs::create_dir(&path).unwrap();
            Self(fs::canonicalize(path).unwrap())
        }

        fn store(&self) -> RecentStore {
            RecentStore::new(self.0.join("state/recent-projects.v1"))
        }

        fn project(&self, name: &str) -> PathBuf {
            create_project(&self.0, name).unwrap()
        }

        fn child(&self, kind: &str) {
            let status = Command::new(std::env::current_exe().unwrap())
                .args(["--ignored", "subprocess_store_child", "--nocapture"])
                .env("OX_RECENTS_TEST_ROOT", &self.0)
                .env("OX_RECENTS_TEST_KIND", kind)
                .status()
                .unwrap();
            assert!(status.success());
        }
    }

    impl Drop for Fixture {
        fn drop(&mut self) {
            fs::remove_dir_all(&self.0).unwrap();
        }
    }

    #[test]
    fn state_location_requires_absolute_root_and_preserves_precedence() {
        assert_eq!(
            state_path(Some("/state".into()), Some("/home/u".into())).unwrap(),
            PathBuf::from("/state/ox/recent-projects.v1")
        );
        assert_eq!(
            state_path(None, Some("/home/u".into())).unwrap(),
            PathBuf::from("/home/u/.local/state/ox/recent-projects.v1")
        );
        assert_eq!(
            state_path(Some("".into()), Some("/home/u".into())).unwrap(),
            state_path(None, Some("/home/u".into())).unwrap()
        );
        assert!(state_path(Some("relative".into()), Some("/home/u".into())).is_err());
        assert!(state_path(None, None).is_err());
        assert!(state_path(None, Some("relative".into())).is_err());
        // Reading configuration performs no filesystem IO or process-wide env mutation.
        let _ = history_path();
    }

    #[test]
    fn restart_mru_dedup_and_missing_removal_preserve_project_content() {
        let fixture = Fixture::new();
        let first = fixture.project("first");
        let second = fixture.project("second");
        fs::write(first.join("sentinel"), b"keep").unwrap();
        let store = fixture.store();
        assert!(store.load().unwrap().is_empty());
        store.record(&first).unwrap();
        store.record(&second).unwrap();
        assert_eq!(
            store.record(&first).unwrap(),
            vec![first.clone(), second.clone()]
        );
        assert_eq!(
            fixture.store().load().unwrap(),
            vec![first.clone(), second.clone()]
        );
        fs::remove_dir(&second).unwrap();
        assert_eq!(
            fixture.store().remove(&second).unwrap(),
            vec![first.clone()]
        );
        assert_eq!(fs::read(first.join("sentinel")).unwrap(), b"keep");
        assert_eq!(fixture.store().remove(&second).unwrap(), vec![first]);
        assert!(fixture.store().reset().unwrap().is_empty());
    }

    #[test]
    fn metadata_cap_evicts_only_oldest_reference() {
        let fixture = Fixture::new();
        let mut projects = Vec::new();
        for index in 0..23 {
            let path = fixture.project(&format!("project-{index}"));
            fixture.store().record(&path).unwrap();
            projects.push(path);
        }
        let expected: Vec<_> = projects.iter().rev().take(20).cloned().collect();
        assert_eq!(fixture.store().load().unwrap(), expected);
        assert!(projects.iter().all(|path| path.is_dir()));
    }

    #[cfg(unix)]
    #[test]
    fn canonical_alias_dedup_and_non_utf8_rejection() {
        use std::os::unix::ffi::OsStringExt;
        use std::os::unix::fs::symlink;
        let fixture = Fixture::new();
        let real = fixture.project("real");
        let alias = fixture.0.join("alias");
        symlink(&real, &alias).unwrap();
        fixture.store().record(&real).unwrap();
        assert_eq!(fixture.store().record(&alias).unwrap(), vec![real]);
        let invalid = fixture.0.join(OsString::from_vec(vec![255]));
        fs::create_dir(&invalid).unwrap();
        let before = fs::read(fixture.store().path).unwrap();
        assert!(fixture.store().record(&invalid).is_err());
        assert_eq!(fs::read(fixture.store().path).unwrap(), before);
    }

    #[test]
    fn invalid_record_has_no_history_mutation() {
        let fixture = Fixture::new();
        let file = fixture.0.join("file");
        fs::write(&file, "keep").unwrap();
        assert!(fixture.store().record(&file).is_err());
        assert!(fixture.store().record(&fixture.0.join("missing")).is_err());
        assert!(!fixture.store().path.exists());
        assert_eq!(fs::read(file).unwrap(), b"keep");
    }

    #[test]
    fn corrupt_history_requires_explicit_reset_with_exact_retained_backups() {
        let fixture = Fixture::new();
        let store = fixture.store();
        store.load().unwrap();
        let project = fixture.project("project");
        let corrupt = b"damaged\0history";
        fs::write(&store.path, corrupt).unwrap();
        assert!(store.load().unwrap_err().contains("Redefinir"));
        assert!(store.record(&project).is_err());
        assert!(store.remove(&project).is_err());
        assert_eq!(fs::read(&store.path).unwrap(), corrupt);
        store.reset().unwrap();
        assert!(store.load().unwrap().is_empty());
        let backups = || {
            fs::read_dir(store.parent().unwrap())
                .unwrap()
                .map(|entry| entry.unwrap().path())
                .filter(|path| path.to_string_lossy().contains("corrupt-backup"))
                .collect::<Vec<_>>()
        };
        let original_backup = backups().pop().unwrap();
        assert_eq!(fs::read(&original_backup).unwrap(), corrupt);
        fs::write(&store.path, b"second corruption").unwrap();
        store.reset().unwrap();
        assert_eq!(backups().len(), 2);
        assert_eq!(fs::read(original_backup).unwrap(), corrupt);
        store.reset().unwrap();
        assert_eq!(backups().len(), 2);
    }

    #[test]
    fn unknown_version_is_never_overwritten_even_by_reset() {
        let fixture = Fixture::new();
        let store = fixture.store();
        store.load().unwrap();
        let project = fixture.project("project");
        for version in [0u32, 2, u32::MAX] {
            let mut bytes = MAGIC.to_vec();
            bytes.extend_from_slice(&version.to_le_bytes());
            // An incomplete future format must still be recognized as unsupported.
            fs::write(&store.path, &bytes).unwrap();
            assert!(store.load().unwrap_err().contains("não suportada"));
            assert!(store.reset().is_err());
            assert!(store.record(&project).is_err());
            assert!(store.remove(&project).is_err());
            assert_eq!(fs::read(&store.path).unwrap(), bytes);
        }
        assert_eq!(fs::read_dir(store.parent().unwrap()).unwrap().count(), 2);
    }

    #[test]
    fn every_truncation_and_malformed_bound_is_rejected() {
        let snapshot = encode(&[PathBuf::from("/one"), PathBuf::from("/two")]);
        for length in 0..snapshot.len() {
            assert!(
                decode(&snapshot[..length]).is_err(),
                "prefix length {length}"
            );
        }
        assert_eq!(decode(&snapshot).ok().unwrap().len(), 2);
        let mut trailing = snapshot.clone();
        trailing.push(0);
        assert!(decode(&trailing).is_err());
        for count in [21u32, u32::MAX] {
            let mut bytes = encode(&[]);
            bytes[12..16].copy_from_slice(&count.to_le_bytes());
            assert!(decode(&bytes).is_err());
        }
        for length in [0u32, MAX_PATH_BYTES as u32 + 1, u32::MAX] {
            let mut bytes = snapshot.clone();
            bytes[16..20].copy_from_slice(&length.to_le_bytes());
            assert!(decode(&bytes).is_err());
        }
        assert!(decode(&encode(&["/same".into(), "/same".into()])).is_err());
        assert!(decode(&encode(&["relative".into()])).is_err());
        assert!(decode(&encode(&["/path/../escape".into()])).is_err());
        assert!(decode(&encode(&["/path/./child".into()])).is_err());
        assert!(decode(&encode(&["/path//child".into()])).is_err());
        assert!(decode(&encode(&["/null\0value".into()])).is_err());
        let longest = PathBuf::from(format!("/{}", "a".repeat(MAX_PATH_BYTES - 1)));
        assert!(decode(&encode(&[longest])).is_ok());
        let excessive = PathBuf::from(format!("/{}", "a".repeat(MAX_PATH_BYTES)));
        assert!(decode(&encode(&[excessive])).is_err());
        let mut invalid_utf8 = encode(&["/a".into()]);
        *invalid_utf8.last_mut().unwrap() = 255;
        assert!(decode(&invalid_utf8).is_err());
    }

    #[test]
    fn oversized_corruption_is_bounded_and_reset_preserves_original_without_copy() {
        let fixture = Fixture::new();
        let store = fixture.store();
        store.load().unwrap();
        let mut oversized = encode(&[]);
        oversized.resize(MAX_SNAPSHOT_BYTES + 4096, 42);
        fs::write(&store.path, &oversized).unwrap();
        assert!(store.load().is_err());
        assert!(store.reset().unwrap_err().contains("manualmente"));
        assert_eq!(fs::read(&store.path).unwrap(), oversized);
        assert_eq!(fs::read_dir(store.parent().unwrap()).unwrap().count(), 2);
    }

    #[test]
    fn two_instances_read_fresh_and_contention_never_loses_successful_writes() {
        let fixture = Fixture::new();
        let first = fixture.project("first");
        let second = fixture.project("second");
        let a = fixture.store();
        let b = fixture.store();
        a.load().unwrap();
        b.load().unwrap();
        a.record(&first).unwrap();
        assert_eq!(
            b.record(&second).unwrap(),
            vec![second.clone(), first.clone()]
        );
        let third = fixture.project("third");
        let fourth = fixture.project("fourth");
        let barrier = Arc::new(Barrier::new(2));
        let threads: Vec<_> = [third, fourth]
            .into_iter()
            .map(|path| {
                let barrier = barrier.clone();
                let store = fixture.store();
                std::thread::spawn(move || {
                    barrier.wait();
                    (path.clone(), store.record(&path))
                })
            })
            .collect();
        let successful: Vec<_> = threads
            .into_iter()
            .map(|thread| thread.join().unwrap())
            .filter_map(|(path, result)| result.ok().map(|_| path))
            .collect();
        assert!(!successful.is_empty());
        let loaded = fixture.store().load().unwrap();
        assert_eq!(loaded.len(), 2 + successful.len());
        assert!(loaded.contains(&first) && loaded.contains(&second));
        assert!(successful.iter().all(|path| loaded.contains(path)));
    }

    #[test]
    fn stable_os_lock_blocks_all_operations_and_releases_on_close() {
        let fixture = Fixture::new();
        let project = fixture.project("project");
        let store = fixture.store();
        let lock = store.lock().unwrap();
        assert!(store.load().is_err());
        assert!(store.record(&project).is_err());
        assert!(store.remove(&project).is_err());
        assert!(store.reset().is_err());
        fixture.child("busy");
        drop(lock);
        fixture.child("record");
        assert_eq!(store.load().unwrap(), vec![project]);
    }

    #[test]
    fn process_exit_before_and_after_rename_preserves_committed_snapshot() {
        let fixture = Fixture::new();
        let first = fixture.project("first");
        let second = fixture.project("second");
        fixture.store().record(&first).unwrap();
        fixture.child("exit-before-rename");
        assert_eq!(fixture.store().load().unwrap(), vec![first]);
        fixture.child("exit-after-rename");
        assert_eq!(fixture.store().load().unwrap(), vec![second]);
        // The abandoned stage is retained and never automatically promoted/deleted.
        assert!(
            fs::read_dir(fixture.store().parent().unwrap())
                .unwrap()
                .any(|entry| entry.unwrap().path().to_string_lossy().contains(".stage-"))
        );
    }

    #[test]
    #[ignore = "subprocess helper, launched by parent tests with isolated paths"]
    fn subprocess_store_child() {
        let root = PathBuf::from(std::env::var_os("OX_RECENTS_TEST_ROOT").unwrap());
        let kind = std::env::var("OX_RECENTS_TEST_KIND").unwrap();
        let store = RecentStore::new(root.join("state/recent-projects.v1"));
        match kind.as_str() {
            "busy" => assert!(store.load().unwrap_err().contains("ocupados")),
            "record" => {
                store.record(&root.join("project")).unwrap();
            }
            "exit-before-rename" | "exit-after-rename" => {
                let _lock = store.lock().unwrap();
                let (stage, mut file) = store.exclusive_file("stage").unwrap();
                file.write_all(&encode(&[root.join("second")])).unwrap();
                file.sync_all().unwrap();
                if kind == "exit-after-rename" {
                    fs::rename(stage, &store.path).unwrap();
                }
                // Abrupt exit skips Rust destructors and closes the OS lock.
                // This exercises publication windows, not power-loss durability.
                std::process::exit(0);
            }
            _ => panic!("unknown child mode"),
        }
    }

    #[cfg(unix)]
    #[test]
    fn symlink_and_special_snapshot_lock_and_state_directory_are_rejected() {
        use std::os::unix::fs::symlink;
        use std::os::unix::net::UnixListener;
        let fixture = Fixture::new();
        let store = fixture.store();
        store.load().unwrap();
        let sentinel = fixture.0.join("sentinel");
        fs::write(&sentinel, b"keep").unwrap();
        symlink(&sentinel, &store.path).unwrap();
        assert!(store.load().is_err());
        assert!(store.reset().is_err());
        assert_eq!(fs::read(&sentinel).unwrap(), b"keep");
        fs::remove_file(&store.path).unwrap();
        let socket = UnixListener::bind(&store.path).unwrap();
        assert!(store.load().is_err());
        assert!(store.reset().is_err());
        drop(socket);
        fs::remove_file(&store.path).unwrap();
        fs::remove_file(store.lock_path()).unwrap();
        symlink(&sentinel, store.lock_path()).unwrap();
        assert!(store.load().is_err());
        fs::remove_file(store.lock_path()).unwrap();
        let _socket = UnixListener::bind(store.lock_path()).unwrap();
        assert!(store.load().is_err());
        let alias = fixture.0.join("state-alias");
        symlink(store.parent().unwrap(), &alias).unwrap();
        assert!(RecentStore::new(alias.join("recents")).load().is_err());
    }

    #[test]
    fn create_produces_only_empty_directory_and_rejects_collisions_without_mutation() {
        let fixture = Fixture::new();
        let project = fixture.project("Olá project");
        assert_eq!(fs::read_dir(&project).unwrap().count(), 0);
        fs::write(project.join("sentinel"), b"keep").unwrap();
        assert!(create_project(&fixture.0, "Olá project").is_err());
        let file = fixture.0.join("file");
        fs::write(&file, b"keep file").unwrap();
        assert!(create_project(&fixture.0, "file").is_err());
        assert_eq!(fs::read(project.join("sentinel")).unwrap(), b"keep");
        assert_eq!(fs::read(file).unwrap(), b"keep file");
        assert!(create_project(&fixture.0.join("missing"), "child").is_err());
        assert!(!fixture.0.join("missing").exists());
    }

    #[test]
    fn invalid_project_names_reject_traversal_and_leave_parent_unchanged() {
        let fixture = Fixture::new();
        for name in [
            "",
            " ",
            ".",
            "..",
            "../outside",
            "/absolute",
            "a/b",
            "a\\b",
            "null\0name",
        ] {
            assert!(create_project(&fixture.0, name).is_err(), "name {name:?}");
        }
        assert_eq!(fs::read_dir(&fixture.0).unwrap().count(), 0);
    }

    #[cfg(unix)]
    #[test]
    fn create_collision_including_dangling_symlink_preserves_target() {
        use std::os::unix::fs::symlink;
        let fixture = Fixture::new();
        let target = fixture.project("target");
        fs::write(target.join("sentinel"), b"keep").unwrap();
        symlink(&target, fixture.0.join("alias")).unwrap();
        symlink(fixture.0.join("missing"), fixture.0.join("dangling")).unwrap();
        assert!(create_project(&fixture.0, "alias").is_err());
        assert!(create_project(&fixture.0, "dangling").is_err());
        assert_eq!(fs::read(target.join("sentinel")).unwrap(), b"keep");
        assert!(!fixture.0.join("missing").exists());
        assert!(
            fs::symlink_metadata(fixture.0.join("dangling"))
                .unwrap()
                .file_type()
                .is_symlink()
        );
    }

    #[test]
    fn simultaneous_project_creators_have_exactly_one_winner() {
        let fixture = Fixture::new();
        let barrier = Arc::new(Barrier::new(2));
        let threads: Vec<_> = (0..2)
            .map(|_| {
                let parent = fixture.0.clone();
                let barrier = barrier.clone();
                std::thread::spawn(move || {
                    barrier.wait();
                    create_project(&parent, "shared")
                })
            })
            .collect();
        let successes = threads
            .into_iter()
            .map(|thread| thread.join().unwrap())
            .filter(Result::is_ok)
            .count();
        assert_eq!(successes, 1);
        assert_eq!(fs::read_dir(fixture.0.join("shared")).unwrap().count(), 0);
    }
}
