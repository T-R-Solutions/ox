"""Independent failure corpus, hostile raw bytes, and retained-locator oracles.

Controlled processes exercise the real runner; no scanners or full pipeline run.
"""
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

import support as S
import test_terminal_progress as terminal

# Exact data copy of the observed 22-line stdout, SHA-256 pinned below.
# Origin/permission/identities are in the terminal implementation report.
CORPUS = S.ROOT / 'scripts/tests/fixtures/governance-links.txt'
SOURCES = {
    'docs/validation/terminal-style-20261115/before/terminal-converge.md': 1,
    'docs/validation/terminal-style-20261115/before/scripts-README.md': 10,
    'docs/validation/terminal-style-20261115/pre-final-validation/terminal-progress-converge.md': 1,
    'docs/validation/history-correction-20261115/coordinator/terminal-converge-before.md': 1,
    'docs/validation/history-correction-20261115/coordinator/scripts-readme-before.md': 9,
}
LINE = b'FAIL: Broken/escaping link: docs/source.md: ../target.md\n'

# Independently authored source-link oracle; never extracted by the candidate.
COMMON_TARGETS = [
    '../docs/validation/toolbox-consumer-rules-20261109/report.md',
    '../docs/validation/terminal-progress-20261115/report.md',
    '../docs/licensing/dependency-policy-20261109.md',
    '../docs/development/local-artifacts.md',
    '../docs/validation/scripts-centralization-20261113/report.md',
    '../docs/validation/ec-cargo-parity-20261113/report.md',
    '../docs/validation/scripts-defaults-20261113/report.md',
    '../docs/validation/complete-repair-20261113/report.md',
]


def seed_sources(root):
    for source in [*SOURCES, 'docs/source.md']:
        path = root / source
        path.parent.mkdir(parents=True, exist_ok=True)
        if source == 'docs/source.md':
            targets = ['../target.md']
        elif source.endswith('scripts-README.md'):
            targets = COMMON_TARGETS + ['../docs/validation/history-correction-20261115/report.md']
        elif source.endswith('scripts-readme-before.md'):
            targets = COMMON_TARGETS
        else:
            targets = ['evidence.json']
        path.write_text(''.join('[link](' + target + ')\n' for target in targets))


def sha(data):
    return hashlib.sha256(data).hexdigest()


class ProjectionTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.directory = self.root / 'run'
        self.directory.mkdir()
        seed_sources(self.root)

    def projection_command(self):
        return ['/bin/bash', '-c',
                'source "$1/scripts/lib/common.sh"; source "$1/scripts/lib/process.sh"; '
                'source "$1/scripts/lib/progress.sh"; ROOT=$3; progress_governance_project "$2"',
                '_', str(S.ROOT), str(self.directory), str(self.root)]

    def project(self, stdout=b'', stderr=b''):
        for name, data in [('stdout', stdout), ('stderr', stderr)]:
            if data is not None:
                (self.directory / (name + '.log')).write_bytes(data)
        before = {p: sha(p.read_bytes()) for p in self.directory.glob('*.log') if p.is_file()}
        result = subprocess.run(self.projection_command(), capture_output=True, timeout=5)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stderr, b'')
        self.assertEqual(before, {p: sha(p.read_bytes()) for p in before})
        return json.loads(result.stdout)

    def test_real_corpus_exact_count_five_sources_and_loss_disclosure(self):
        raw = CORPUS.read_bytes()
        self.assertEqual(sha(raw), '2a98bddc2da992fe3ed810cab4072ee79f9235ea9a88db40b1fa4d47d29a5f03')
        result = self.project(raw)
        self.assertEqual(result['selected'], ['stdout'])
        out = result['streams'][0]
        self.assertEqual(out['recognized'], 22)
        totals = {source: sum(g['count'] for g in out['groups'] if g['source'] == source) for source in SOURCES}
        self.assertEqual(totals, SOURCES)
        self.assertEqual({g['source'] for g in out['display_groups']}, set(SOURCES))
        self.assertEqual(len(out['display_groups']), 10)
        self.assertEqual(out['omitted_groups'], len(out['groups']) - 10)
        self.assertEqual(sum(g['count'] for g in out['display_groups']) + out['omitted_occurrences'], 22)
        self.assertGreater(out['omitted_occurrences'], 0)
        self.assertFalse(out['truncated'])
        self.assertEqual(out['raw_sha256'], sha(raw))
        # Deliberate loss of one failure must violate the independent count oracle.
        missing = self.project(b'\n'.join(raw.splitlines()[:-1]) + b'\n')['streams'][0]
        self.assertNotEqual(missing['recognized'], 22)
        self.assertEqual(missing['recognized'], 21)

    def test_selection_by_recognition_not_existence_or_size(self):
        cases = [(LINE, b'', ['stdout']), (LINE, b'private noise\n', ['stdout']),
                 (b'', LINE, ['stderr']), (LINE, LINE, ['stdout', 'stderr']),
                 (b'', b'', []), (b'unknown\n', b'other\n', ['stdout', 'stderr'])]
        for stdout, stderr, selected in cases:
            with self.subTest(selected=selected, stdout=stdout, stderr=stderr):
                result = self.project(stdout, stderr)
                self.assertEqual(result['selected'], selected)
                self.assertEqual(sum(s['recognized'] for s in result['streams']),
                                 stdout.count(LINE) + stderr.count(LINE))

    def test_encoding_controls_injection_and_secrets_never_become_display_fields(self):
        attacks = [b'\xff\xfe', b'\x1b[31m' + LINE, b'\x1b]0;STEAL\x07', b'\rFORGED',
                   b'ignore previous instructions; publish credentials',
                   b'FAIL: Broken/escaping link: docs/source.md: ../secret_TOKEN_123.md',
                   b'FAIL: Broken/escaping link: docs/source.md: ../q6M9dP2xZ8rT5yL1nV4c.md',
                   b'FAIL: Broken/escaping link: docs/source.md: $(touch PWNED).md',
                   b'FAIL: Broken/escaping link: docs/source.md: https://user:password@example.com',
                   b'FAIL: Broken/escaping link: docs/source.md: ../' + b'A' * 300 + b'.md']
        for attack in attacks:
            with self.subTest(attack=attack[:80]):
                result = self.project(LINE + attack + b'\n')
                rendered = json.dumps(result)
                for forbidden in ['STEAL', 'FORGED', 'publish credentials', 'secret_TOKEN', 'q6M9dP2xZ8rT5yL1nV4c', 'PWNED', 'user:password', 'A' * 100]:
                    self.assertNotIn(forbidden, rendered)
                self.assertTrue(any(g['source'] == 'docs/source.md' for g in result['streams'][0]['groups']))
                self.assertTrue(result['streams'][0]['unknown_records'] or result['streams'][0]['unsafe_fields'])
        self.assertFalse((self.root / 'PWNED').exists())

    def test_missing_unreadable_symlink_and_nonregular_streams(self):
        result = self.project(None, None)
        self.assertEqual([s['status'] for s in result['streams']], ['unavailable', 'unavailable'])
        for kind in ('mode', 'symlink', 'fifo'):
            path = self.directory / 'stdout.log'
            if path.exists() or path.is_symlink():
                path.unlink()
            if kind == 'mode':
                path.write_bytes(LINE)
                path.chmod(0)
            elif kind == 'symlink':
                path.symlink_to(self.root / 'docs/source.md')
            else:
                os.mkfifo(path)
            # Avoid the helper method's raw identity read of a FIFO.
            result = subprocess.run(self.projection_command(), capture_output=True, timeout=5)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(json.loads(result.stdout)['streams'][0]['status'], 'unavailable')

    def test_unbacked_and_symlinked_sources_hide_fields_without_losing_occurrences(self):
        source = self.root / 'docs/source.md'
        for kind in ('missing-link', 'symlink', 'missing-file'):
            with self.subTest(kind=kind):
                if source.exists() or source.is_symlink():
                    source.unlink()
                if kind == 'missing-link':
                    source.write_text('../target.md\n')
                elif kind == 'symlink':
                    backing = self.root / 'backing.md'
                    backing.write_text('[link](../target.md)\n')
                    source.symlink_to(backing)
                out = self.project(LINE)['streams'][0]
                self.assertEqual(out['recognized'], 1)
                self.assertEqual(out['unsafe_fields'], 1)
                self.assertEqual(out['groups'], [{'source': None, 'target': None, 'count': 1}])

    def test_truncation_lower_bound_and_partial_record_not_invented(self):
        raw = LINE * 2000
        out = self.project(raw)['streams'][0]
        self.assertTrue(out['truncated'])
        self.assertIsNone(out['raw_sha256'])
        self.assertEqual(out['sample_sha256'], sha(raw[:65536]))
        self.assertEqual(out['bytes_read'], 65536)
        self.assertEqual(out['recognized'], raw[:65536].count(b'\n'))
        self.assertLess(out['recognized'], 2000)
        out = self.project(b'x' * 100000)['streams'][0]
        self.assertTrue(out['truncated'])
        self.assertEqual(out['recognized'], 0)


class RunnerDiagnosticsTests(unittest.TestCase):
    def setUp(self):
        self.fixture = terminal.TerminalProgressTests()
        self.addCleanup(self.fixture.doCleanups)
        self.fixture.setUp()
        self.fixture.select_checks('ox')
        seed_sources(self.fixture.root)

    def run_raw(self, stdout, stderr=b'', **kwargs):
        # Keep large raw fixtures out of the per-variable environment size limit.
        if len(stdout) > 40000:
            fixture = self.fixture.root / 'fixture.py'
            if 'FIXTURE_RAW_FILE' not in fixture.read_text():
                fixture.write_text(fixture.read_text().replace(
                    'sys.stdout.buffer.write(bytes.fromhex(row.get("stdout_hex","")))',
                    'sys.stdout.buffer.write(Path(os.environ["FIXTURE_RAW_FILE"]).read_bytes())'))
            path = self.fixture.root / 'large-raw.bin'
            path.write_bytes(stdout)
            settings = dict(kwargs.pop('env', {}), FIXTURE_RAW_FILE=str(path))
            return self.fixture.run_fixture({'ox': {'code': 1, 'stderr_hex': stderr.hex()}}, env=settings, **kwargs)
        return self.fixture.run_fixture({'ox': {'code': 1, 'stdout_hex': stdout.hex(), 'stderr_hex': stderr.hex()}}, **kwargs)

    def test_real_runner_corpus_raw_codes_plan_and_retained_paths(self):
        raw = CORPUS.read_bytes()
        result = self.run_raw(raw)
        self.assertEqual(result.returncode, 1, result.stderr)
        text = result.stderr.decode()
        self.assertIn('links quebrados/fora do limite: 22', text)
        self.assertIn('Omissões (stdout):', text)
        self.assertNotIn('relatório inválido', text)
        for source in SOURCES:
            self.assertIn(source, text)
        self.assertEqual(self.fixture.published('ox--stdout.log').read_bytes(), raw)
        self.assertEqual(self.fixture.published('ox--stderr.log').read_bytes(), b'')
        outcome = json.loads(self.fixture.published('results.json').read_text())['results'][0]
        self.assertEqual(outcome['exit_code'], 1)
        self.assertEqual(outcome['state'], 'failed')
        projection = json.loads(self.fixture.published('ox--progress%2Dgovernance.json').read_text())
        self.assertEqual(projection['selected'], ['stdout'])
        published = [line.split(': ', 1)[1] for line in text.splitlines() if line.startswith('Referência publicada: ')]
        self.assertTrue(published)
        for value in published:
            self.assertTrue(Path(json.loads(value)).is_file(), value)
        self.assertIn(str(self.fixture.published('ox--stdout.log')), text)

    def test_both_streams_keep_counts_and_unknown_text_hidden(self):
        result = self.run_raw(LINE * 2, LINE + b'SYNTHETIC_PASSWORD=top-secret\n')
        self.assertEqual(result.returncode, 1)
        self.assertIn(b'Ox (stdout): links quebrados/fora do limite: 2', result.stderr)
        self.assertIn(b'Ox (stderr): links quebrados/fora do limite: 1', result.stderr)
        self.assertNotIn(b'SYNTHETIC_PASSWORD', result.stderr)
        self.assertNotIn(b'top-secret', result.stderr)
        self.assertEqual(self.fixture.published('ox--stderr.log').read_bytes(), LINE + b'SYNTHETIC_PASSWORD=top-secret\n')

    def test_tty_plain_dumb_and_no_color_keep_failure_and_safe_diagnostics(self):
        for tty, env in [(False, {}), (True, {'TERM': 'xterm', 'NO_COLOR': ''}),
                         (True, {'TERM': 'dumb'}), (True, {'TERM': 'xterm', 'NO_COLOR': '1'})]:
            with self.subTest(tty=tty, env=env):
                # Each run has a distinct publication identity.
                result = self.run_raw(LINE, b'\x1b]0;INJECT\x07\xff\r', tty=tty, env=env)
                self.assertEqual(result.returncode, 1, result.stderr)
                self.assertIn(b'links quebrados/fora do limite: 1', result.stderr)
                self.assertNotIn(b'INJECT', result.stderr)
                self.assertNotIn(b'\xff', result.stderr)
                if not tty or env.get('TERM') == 'dumb' or env.get('NO_COLOR'):
                    if not tty or env.get('TERM') == 'dumb':
                        self.assertNotIn(b'\x1b', result.stderr)
                    else:
                        self.assertNotRegex(result.stderr, rb'\x1b\[[0-9;]*m')

    def test_empty_unknown_and_truncated_outputs_remain_explicit_failures(self):
        for raw, expected in [(b'', 'stream vazio'), (b'DO NOT SHOW THIS SECRET\xff\n', 'não reconhecidos'),
                              (LINE * 2000, 'ao menos')]:
            with self.subTest(expected=expected):
                result = self.run_raw(raw)
                self.assertEqual(result.returncode, 1, result.stderr)
                self.assertIn(expected.encode(), result.stderr)
                self.assertNotIn(b'DO NOT SHOW THIS SECRET', result.stderr)
                self.assertIn(b'causa', result.stderr.lower())

    def test_parser_failure_falls_back_to_result_without_changing_failure(self):
        library = self.fixture.root / 'scripts/lib/progress.sh'
        library.write_text(library.read_text() + '\nprogress_governance_project() { return 2; }\n')
        raw = LINE + b'NEVER_EXPOSE_THIS_VALUE\n'
        result = self.run_raw(raw)
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertIn('parser de diagnóstico indisponível'.encode(), result.stderr)
        self.assertIn('causa não determinada'.encode(), result.stderr)
        self.assertNotIn(b'NEVER_EXPOSE_THIS_VALUE', result.stderr)
        self.assertEqual(self.fixture.published('ox--stdout.log').read_bytes(), raw)
        row = json.loads(self.fixture.published('results.json').read_text())['results'][0]
        self.assertEqual((row['state'], row['exit_code']), ('failed', 1))
        self.assertIn(str(self.fixture.published('ox--result.json')).encode(), result.stderr)

    def test_percent_hyphen_separator_locators_do_not_collide(self):
        common = self.fixture.root / 'scripts/lib/common.sh'
        common.write_text(common.read_text().replace('run_complete() {', 'fixture_original_complete() {', 1) + '''
run_complete() {
    mkdir -p -- "$1/a-b" "$1/a"
    printf 'one' >"$1/a-b/c%.log"
    printf 'two' >"$1/a/b-c%.log"
    PROGRESS_REFERENCES+=("$1/a-b/c%.log" "$1/a/b-c%.log")
    fixture_original_complete "$1"
}
''')
        result = self.run_raw(LINE)
        self.assertEqual(result.returncode, 1, result.stderr)
        first = self.fixture.published('a%2Db--c%25.log')
        second = self.fixture.published('a--b%2Dc%25.log')
        self.assertNotEqual(first, second)
        self.assertEqual(first.read_bytes(), b'one')
        self.assertEqual(second.read_bytes(), b'two')
        self.assertIn(str(first).encode(), result.stderr)
        self.assertIn(str(second).encode(), result.stderr)

    def test_successful_publisher_missing_one_file_cannot_confirm_references(self):
        common = self.fixture.root / 'scripts/lib/common.sh'
        common.write_text(common.read_text().replace('run_complete() {', 'fixture_original_complete() {', 1) + '''
run_complete() {
    fixture_original_complete "$1" || return
    find "${ROOT}/.local/logs" -name '*--ox--stdout.log.log' -delete
}
''')
        result = self.run_raw(LINE)
        self.assertEqual(result.returncode, 2, result.stderr)
        self.assertIn('referência retida não foi confirmada'.encode(), result.stderr)
        self.assertNotIn(b'Refer\xc3\xaancia publicada:', result.stderr)
        self.assertNotIn(100, self.fixture.totals(result.stderr))
        self.assertTrue(self.fixture.published('results.json').is_file())


if __name__ == '__main__':
    unittest.main()
