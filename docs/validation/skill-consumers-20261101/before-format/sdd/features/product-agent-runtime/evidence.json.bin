{
  "schema_version": 2,
  "environment": "Linux x86_64, Rust 1.99.1",
  "requirements": [
    {
      "id": "AC-01",
      "criterion": "A controlled local adapter runs to success or nonzero failure with observed process exit and ordered lifecycle events.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-02",
      "criterion": "Cancellation enters Cancelling before an observed terminal Cancelled outcome and reaps the owned child.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-03",
      "criterion": "Wrong-generation, duplicate, out-of-order and late completion events cannot corrupt terminal or current session state.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-04",
      "criterion": "Execution deadlines stop a hanging local adapter and recovery creates a fresh attempt with no old events or grants.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-05",
      "criterion": "Runtime and controlled adapter preserve a workspace sentinel; output and supervision limitations are explicit.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    }
  ],
