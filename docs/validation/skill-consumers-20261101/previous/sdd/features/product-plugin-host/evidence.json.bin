{
  "schema_version": 2,
  "environment": "Linux x86_64, Rust 1.99.1",
  "requirements": [
    {
      "id": "AC-01",
      "criterion": "A real local plugin process negotiates protocol 1.0 and completes a correlated echo request.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-02",
      "criterion": "An incompatible major version is rejected before any operation.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-03",
      "criterion": "Echo requires both plugin-advertised support and caller grant; denied operations are not sent.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-04",
      "criterion": "Malformed, oversized and mismatched response frames fail the host without approval.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-05",
      "criterion": "A silent plugin times out within the configured deadline and an unexpected exit is distinguished.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    },
    {
      "id": "AC-06",
      "criterion": "Shutdown closes admission, reaps the child and releases its socket; recovery starts a new independent host.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST"
      ]
    }
  ],
