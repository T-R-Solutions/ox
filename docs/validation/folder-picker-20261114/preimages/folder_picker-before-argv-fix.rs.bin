//! Optional Linux desktop adapter. Zenity is a separately installed GTK program;
//! it is never invoked through a shell and does not execute project code.
use std::{
    io::Read,
    process::{Command, Stdio},
    sync::{
        Arc,
        atomic::{AtomicBool, Ordering},
    },
    time::Duration,
};

pub(super) type Selection = Result<Option<String>, String>;

#[derive(Debug)]
pub(super) struct Request {
    pub id: u64,
    pub generation: u64,
    pub cancel: Arc<AtomicBool>,
}
impl Drop for Request {
    fn drop(&mut self) {
        self.cancel.store(true, Ordering::Relaxed);
    }
}

// A flag only requests termination: the supervisor owns, kills and reaps the
// direct child before reporting completion. Relaxed is enough; no data is published.
pub(super) fn choose(cancel: &AtomicBool) -> Selection {
    supervise(
        Command::new("zenity").args([
            "--file-selection",
            "--directory",
            "--title=Escolher pasta — Ox",
            "--ok-label=Abrir pasta",
            "--cancel-label=Cancelar",
            "--width=600",
            "--height=400",
        ]),
        cancel,
    )
}

fn supervise(command: &mut Command, cancel: &AtomicBool) -> Selection {
    if cancel.load(Ordering::Relaxed) {
        return Ok(None);
    }
    let mut child = command.stdin(Stdio::null()).stdout(Stdio::piped())
        .stderr(Stdio::null()).spawn()
        .map_err(|e| format!("Não foi possível abrir o seletor de pasta (Zenity): {e}. Digite o caminho manualmente."))?;
    let mut stdout = child.stdout.take().expect("piped stdout");
    // Drain concurrently so a full pipe never blocks child exit. Retain at most
    // 64 KiB; overflow is an error, never a silently truncated directory.
    let reader = std::thread::Builder::new()
        .name("ox-folder-output".into())
        .spawn(move || {
            let mut kept = Vec::new();
            let mut buffer = [0; 4096];
            let mut overflow = false;
            loop {
                let size = stdout.read(&mut buffer)?;
                if size == 0 {
                    break;
                }
                if kept.len() + size <= 65536 {
                    kept.extend_from_slice(&buffer[..size]);
                } else {
                    overflow = true;
                }
            }
            Ok::<_, std::io::Error>((kept, overflow))
        });
    let reader = match reader {
        Ok(reader) => reader,
        Err(e) => {
            let _ = child.kill();
            let _ = child.wait();
            return Err(format!("Não foi possível acompanhar o seletor: {e}"));
        }
    };
    let mut cancelled = false;
    let status = loop {
        if cancel.load(Ordering::Relaxed) {
            cancelled = true;
            let _ = child.kill();
            break child.wait();
        }
        match child.try_wait() {
            Ok(Some(status)) => break Ok(status),
            Ok(None) => std::thread::sleep(Duration::from_millis(20)),
            Err(e) => {
                let _ = child.kill();
                let _ = child.wait();
                break Err(e);
            }
        }
    };
    let output = reader
        .join()
        .map_err(|_| "Falha ao ler a seleção de pasta".to_owned())?
        .map_err(|e| format!("Falha ao ler a seleção de pasta: {e}"))?;
    if cancelled {
        return Ok(None);
    }
    let status = status.map_err(|e| format!("Falha ao acompanhar o seletor: {e}"))?;
    if status.code() == Some(1) {
        return Ok(None);
    }
    if !status.success() {
        return Err(format!(
            "O seletor de pasta encerrou com {status}. Digite o caminho manualmente."
        ));
    }
    if output.1 {
        return Err("O seletor retornou um caminho maior que o limite suportado. Digite o caminho manualmente.".into());
    }
    decode(&output.0).map(Some)
}

fn decode(output: &[u8]) -> Result<String, String> {
    let bytes = output
        .strip_suffix(b"\n")
        .ok_or("Resposta incompleta do seletor de pasta")?;
    let path = std::str::from_utf8(bytes).map_err(|_| "O nome desta pasta não pode ser representado no campo de texto (UTF-8). Nenhum caminho foi alterado.".to_owned())?;
    if !std::path::Path::new(path).is_absolute() || path.contains('\0') {
        return Err("O seletor não retornou um caminho de pasta absoluto válido".into());
    }
    Ok(path.to_owned())
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn selection_preserves_spaces_unicode_and_filename_newline() {
        assert_eq!(
            decode("/tmp/ ação \n\n".as_bytes()).unwrap(),
            "/tmp/ ação \n"
        );
        assert_eq!(decode(b"/\n").unwrap(), "/");
        assert!(decode(b"relative\n").is_err());
        assert!(decode(b"/bad\xff\n").is_err());
        assert!(decode(b"/no-terminator").is_err());
    }
    #[test]
    fn missing_program_and_nonzero_exit_are_errors() {
        let cancel = AtomicBool::new(false);
        assert!(supervise(&mut Command::new("/ox-no-such-folder-picker"), &cancel).is_err());
        assert_eq!(
            supervise(&mut Command::new("/usr/bin/false"), &cancel).unwrap(),
            None
        );
        assert!(
            supervise(
                Command::new("/usr/bin/ls").arg("/ox-no-such-folder"),
                &cancel
            )
            .is_err()
        );
    }
    #[test]
    fn cancelled_supervised_child_is_reaped() {
        let cancel = Arc::new(AtomicBool::new(false));
        let flag = cancel.clone();
        let worker =
            std::thread::spawn(move || supervise(Command::new("/usr/bin/sleep").arg("30"), &flag));
        std::thread::sleep(Duration::from_millis(80));
        cancel.store(true, Ordering::Relaxed);
        assert_eq!(worker.join().unwrap().unwrap(), None);
    }
}
