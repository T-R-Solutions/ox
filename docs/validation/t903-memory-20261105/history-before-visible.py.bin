from pathlib import Path
import importlib.util,sys,os,subprocess,time,json,hashlib,select,traceback,threading,re
b=Path(__file__).resolve().parent
s=importlib.util.spec_from_file_location('session',b/'native-session.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
out=b/sys.argv[1];backend=sys.argv[2];scale=float(sys.argv[3]);width=int(sys.argv[4]);height=int(sys.argv[5]);session=None;r={'backend_requested':backend}
try:
 session=m.Session(out,f'{int(1200*scale)}x{int(900*scale)}',scale);env=dict(session.env);w=out/'workspace';w.mkdir();(w/'sentinel').write_bytes(b'preserve FIFO journey')
 if backend=='x11':
  rd,wr=os.pipe();log=(out/'xwayland.log').open('w');server=subprocess.Popen(['Xwayland','-displayfd',str(wr),'-geometry','1200x900','-nolisten','tcp','-shm','-noreset'],pass_fds=(wr,),env=env,stdout=log,stderr=log);session.children.append(server);os.close(wr);assert select.select([rd],[],[],10)[0];env['DISPLAY']=':'+os.read(rd,32).decode().strip();env.pop('WAYLAND_DISPLAY');r['display']=env['DISPLAY']
 env.update(OX_VALIDATION_WORKSPACE=str(w),OX_VALIDATION_SESSION=out.name,WAYLAND_DEBUG='1',OX_VALIDATION_WIDTH=str(width),OX_VALIDATION_HEIGHT=str(height),WINIT_X11_SCALE_FACTOR=str(scale))
 
 if os.environ.get('OX_ALLOC_PROBE'):
  env.update(LD_PRELOAD='/tmp/ox-t903-allocation-probe.so',OX_ALLOC_LOG=str(out/'allocations.log'))
 binary=Path('/tmp/ox-t903-target/debug/ox');log=(out/'client.log').open('w');app=subprocess.Popen([str(binary)],env=env,stdout=log,stderr=log);session.children.append(app);r.update(pid=app.pid,binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest())
 rss=[];rss_stop=threading.Event()
 def sample_rss():
  while not rss_stop.wait(.02):
   try:
    status=Path(f'/proc/{app.pid}/status').read_text();rss.append({'time':time.monotonic(),'rss_kib':int(re.search(r'VmRSS:\s+(\d+)',status)[1]),'hwm_kib':int(re.search(r'VmHWM:\s+(\d+)',status)[1])})
   except (FileNotFoundError,TypeError):break
 threading.Thread(target=sample_rss,daemon=True).start()
 def text():return (out/'client.log').read_text()
 session.wait(lambda:'OX_CLIENT_FRAME_MS' in text(),'initial draw');time.sleep(.5);session.key(0xffe1)
 if backend=='x11':
  (out/'x11-focus.txt').write_text(subprocess.check_output(['/usr/bin/python3',str(b/'focus-x11.py'),env['DISPLAY']],text=True))
  (out/'x11-window-tree.txt').write_text(subprocess.check_output(['xprop','-display',env['DISPLAY'],'-root'],text=True))
 else:assert 'xdg_toplevel' in text(), 'native protocol absent'
 def tab(n):
  for _ in range(n):session.key(0xff09)
 def enter():session.key(0xff0d);time.sleep(.25)
 tab(4);enter();session.wait(lambda:'Workspace ready' in text() or 'workspace accepted' in text().lower() or 'Done(' in text(),'select done');session.shot('selected');tab(1);enter();session.wait(lambda:bool(list(w.glob('.ox-task-*/result.txt'))),'artifact');time.sleep(.2)
 attempt=next(w.glob('.ox-task-*'));result=attempt/'result.txt';original=result.read_bytes();assert original==(attempt/'request.txt').read_bytes()+b'result=42\n';tab(4);enter();session.wait(lambda:'APPROVED' in text(),'approval');session.shot('approved');session.key(0xff56);session.shot('approved-history');session.key(0xff55)
 # Fill the existing bounded 32-observation history by explicit Verify actions.
 for i in range(31):
  offset=len(text());enter();session.wait(lambda:'Done(' in text()[offset:],'history verification '+str(i))
 session.shot('history-32-top');session.key(0xff56);session.shot('history-32-scroll')
 samples=[]
 for i in range(23):
  before=session.latest;start=time.monotonic();session.call('RemoteDesktop',session.rd,'NotifyKeyboardKeysym','(ub)',(0xff55 if i%2 else 0xff56,True))
  # Poll a changed actual monitor frame; this includes capture delivery, not scanout.
  session.wait(lambda:session.latest[0]>=start and session.latest[3]!=before[3],'scroll response',3)
  samples.append({'iteration':i,'warmup':i<3,'response_ms':(session.latest[0]-start)*1000})
  session.call('RemoteDesktop',session.rd,'NotifyKeyboardKeysym','(ub)',(0xff55 if i%2 else 0xff56,False));time.sleep(.1)
 
 if (out/'allocations.log').exists():
  import shutil;shutil.copyfile(out/'allocations.log',out/'allocations-at32.log')
 (out/'maps.txt').write_text(Path(f'/proc/{app.pid}/maps').read_text());(out/'smaps-rollup.txt').write_text(Path(f'/proc/{app.pid}/smaps_rollup').read_text());r['samples']=samples;r['observations_requested']=32
 import re
 r['maximum_observed_run']=max(map(int,re.findall(r'run (\d+):',text())),default=0)
 r['client_frame_max_ms']=max(map(float,re.findall(r'OX_CLIENT_FRAME_MS=([\d.]+)',text())),default=0)
 assert r['maximum_observed_run']==32, 'did not observe 32 retained runs'
 # Refusal is observed by a further explicit verification; preserve all prior records.
 for i in range(20):session.key(0xff56)
 session.shot('history-32-bottom')
 def ticks():return sum(map(int,Path(f'/proc/{app.pid}/stat').read_text().rsplit(')',1)[1].split()[11:13]))
 idle=[]
 for i in range(3):
  start=time.monotonic();a=ticks();time.sleep(10);z=ticks();elapsed=time.monotonic()-start
  idle.append({'seconds':elapsed,'before':a,'after':z,'hz':os.sysconf('SC_CLK_TCK'),'percent':(z-a)/os.sysconf('SC_CLK_TCK')/elapsed*100})
 r['idle']=idle
 r['sentinel_preserved']=(w/'sentinel').read_bytes()==b'preserve FIFO journey'
 tab(3);enter();session.wait(lambda:app.poll() is not None,'natural close');r['app_exit']=app.returncode;r['process_absent']=not Path(f'/proc/{app.pid}').exists()
except Exception as e:r['error']=repr(e);traceback.print_exc()
finally:
 if 'rss_stop' in locals():rss_stop.set();r['rss_samples']=rss
 if session:session.close()
 out.mkdir(exist_ok=True);(out/'result.json').write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r),flush=True)
