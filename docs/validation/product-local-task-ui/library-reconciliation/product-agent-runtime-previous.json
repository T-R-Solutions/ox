      "evidence_ids": [
        "E-TEST",
        "E-CHECKS",
        "E-REVIEW"
      ]
    },
    {
      "id": "AC-03",
      "criterion": "Wrong-generation, duplicate, out-of-order and late completion events cannot corrupt terminal or current session state.",
