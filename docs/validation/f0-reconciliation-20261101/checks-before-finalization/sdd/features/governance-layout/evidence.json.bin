        "E-DOCUMENTARY-DELTA-AC-01"
      ],
      "reason": "Recovery reports 439/439 inputs; mapping of the 23 original files needs criterion-specific review."
    },
    {
      "id": "AC-02",
      "criterion": "Documented commands run from the root and an independent copy; active references and traceability resolve to new locations; guards continue rejecting improper changes.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-02"
      ],
      "reason": "Root commands and independent-copy suite pass; active reference mapping review remains incomplete."
    },
    {
      "id": "AC-03",
      "criterion": "The actual ZIP includes tools/governance/ and config/governance/, excludes src/, Cargo, crates and unrelated paths; the manifest matches and five commands pass in an independent extraction.",
      "status": "UNVERIFIED",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-03"
      ],
      "reason": "No new actual ZIP was qualified in this consolidation."
    },
    {
      "id": "AC-04",
      "criterion": "Recoverable baseline, preserved prior history, new observations bound to current inputs and valid freshness; the skills' 36 technical scenarios remain UNVERIFIED.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-04"
      ],
      "reason": "Recovery passes; literal 36 UNVERIFIED clause is obsolete relative to later consumer records and needs explicit succession reconciliation."
    }
