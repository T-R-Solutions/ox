{
  "schema_version": 2,
  "environment": "2026-11-01 Linux; environment identity in docs/validation/foundation-current-20261101/environment.json",
  "requirements": [
    {
      "id": "AC-01",
      "criterion": "An independent copy runs the Ox and SDD checkers without studies or the source library.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-01"
      ],
      "reason": "Independent-copy tests ran in the complete suite; current actual delivery boundary needs separate qualification."
    },
    {
      "id": "AC-02",
      "criterion": "Recursive inspection rejects study names and full contents in files and archives, including renamed ones.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-02"
      ],
      "reason": "Recursive inspection and mutation suite pass; criterion-specific renamed-content case mapping remains incomplete."
    },
    {
      "id": "AC-03",
      "criterion": "Coverage points to existing local authority IDs; links and catalog/profile agree.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-03"
      ],
      "reason": "Local authority IDs and links pass; semantic correspondence review remains incomplete."
    },
    {
      "id": "AC-04",
      "criterion": "Tests reject skill, bridge, authority, evidence and link corruption; restoration recovers success.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-04"
      ],
      "reason": "Mutation tests pass; the exact required corruption/restoration cases need criterion-specific mapping."
    },
    {
      "id": "AC-05",
      "criterion": "Previous observations are preserved with original hashes; affected evidence is replaced with new observations or an undecided state.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-05"
      ],
      "reason": "Predecessors exist and freshness passes; full history lineage review remains incomplete."
    },
    {
      "id": "AC-06",
      "criterion": "The nine skills' 36 technical scenarios remain UNVERIFIED.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-06"
      ],
      "reason": "Literal 36 UNVERIFIED condition conflicts with later consumer acceptance; technical-acceptance explicitly supersedes product-foundation AC-03, so succession scope here needs reconciliation."
    },
    {
      "id": "AC-07",
      "criterion": "The new ZIP contains a verifiable inventory and passes recursive inspection and the five official commands in a clean extraction.",
      "status": "UNVERIFIED",
      "evidence_ids": [
        "CURRENT-REVIEW",
        "E-DOCUMENTARY-DELTA-AC-07"
      ],
      "reason": "No new actual ZIP was qualified in this consolidation."
    }
  ],
