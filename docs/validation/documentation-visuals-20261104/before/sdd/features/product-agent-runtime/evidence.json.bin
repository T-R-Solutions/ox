  "requirements": [
    {
      "id": "AC-01",
      "criterion": "A controlled local adapter runs to success or nonzero failure with observed process exit and ordered lifecycle events.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST",
        "E-F0-RASTER-CLOSURE",
        "E-README-SKILL-INTEGRATION-REVIEW",
        "E-DOCUMENTATION-VISUALS-REVIEW",
        "E-README-PRESERVATION-REPAIR"
      ]
    },
    {
      "id": "AC-02",
      "criterion": "Cancellation enters Cancelling before an observed terminal Cancelled outcome and reaps the owned child.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST",
        "E-F0-RASTER-CLOSURE",
