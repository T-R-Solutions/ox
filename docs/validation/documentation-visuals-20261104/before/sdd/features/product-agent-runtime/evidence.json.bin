        "E-README-PRESERVATION-REPAIR"
      ]
    },
    {
      "id": "AC-03",
      "criterion": "Wrong-generation, duplicate, out-of-order and late completion events cannot corrupt terminal or current session state.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST",
        "E-F0-RASTER-CLOSURE",
        "E-README-SKILL-INTEGRATION-REVIEW",
        "E-DOCUMENTATION-VISUALS-REVIEW",
        "E-README-PRESERVATION-REPAIR"
      ]
    },
    {
      "id": "AC-04",
      "criterion": "Execution deadlines stop a hanging local adapter and recovery creates a fresh attempt with no old events or grants.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
        "E-UI-TEST",
        "E-F0-RASTER-CLOSURE",
        "E-README-SKILL-INTEGRATION-REVIEW",
        "E-DOCUMENTATION-VISUALS-REVIEW",
        "E-README-PRESERVATION-REPAIR"
      ]
    },
    {
      "id": "AC-05",
      "criterion": "Runtime and controlled adapter preserve a workspace sentinel; output and supervision limitations are explicit.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-UI-RECONCILIATION",
