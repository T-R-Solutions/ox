"""Exact two-document correction successor; historical observations stay unchanged."""

import hashlib
import json
import re

BASE = "docs/validation/claude-analysis-20261117"
REGISTRY = BASE + "/document-successors.json"
REVIEWED = "fd2ba396e63c50d5613d866e937a7f6d78694d6f7ae3ef9b78245a372c653189"
DESTINATIONS = frozenset({"scripts/README.md", "sdd/project.md"})


def sha(data):
    return hashlib.sha256(data).hexdigest()


def records(root):
    from readme_revision import file, unique

    raw = file(root, REGISTRY).read_bytes()
    if sha(raw) != REVIEWED:
        raise ValueError("Claude analysis document registry changed")
    doc = json.loads(raw, object_pairs_hook=unique)
    if (not isinstance(doc, dict)
            or set(doc) != {"schema_version", "revision", "records"}
            or type(doc["schema_version"]) is not int or doc["schema_version"] != 1
            or doc["revision"] != "claude-analysis-documents-001"
            or not isinstance(doc["records"], list)):
        raise ValueError("Unexpected Claude analysis document schema")
    rows = {}
    for row in doc["records"]:
        if (not isinstance(row, dict)
                or set(row) != {"destination", "sha256", "previous", "previous_sha256"}
                or not isinstance(row["destination"], str)
                or row["destination"] not in DESTINATIONS
                or row["destination"] in rows
                or row["previous"] != BASE + "/before/" + row["destination"] + ".bin"
                or any(not isinstance(row[key], str)
                       or not re.fullmatch("[a-f0-9]{64}", row[key])
                       for key in ("sha256", "previous_sha256"))
                or row["sha256"] == row["previous_sha256"]):
            raise ValueError("Unexpected Claude analysis document inventory")
        if sha(file(root, row["previous"]).read_bytes()) != row["previous_sha256"]:
            raise ValueError("Claude analysis document predecessor changed")
        rows[row["destination"]] = row
    if rows.keys() != DESTINATIONS:
        raise ValueError("Claude analysis document scope differs")
    return rows


def predecessor(root, relative, data, *, strict=True):
    """Strict callers reject drift; historical projections leave unknown bytes intact."""
    """Authenticate the live successor before mapping only its exact input bytes."""
    from readme_revision import file
    from audit_followup_revision import predecessor as followup_predecessor
    from document_ledger import predecessor as ledger_predecessor

    if relative in DESTINATIONS:
        records(root)  # Preserve authentication before any live-input diagnostic.
    data = ledger_predecessor(root, relative, data, strict=strict)
    data = followup_predecessor(root, relative, data, strict=strict)
    if relative not in DESTINATIONS:
        return data
    row = records(root)[relative]
    live = ledger_predecessor(root, relative, file(root, relative).read_bytes(), strict=strict)
    if sha(live) == row["previous_sha256"]:
        raise ValueError("Claude analysis document predecessor downgrade: " + relative)
    if sha(live) != row["sha256"]:
        if strict:
            raise ValueError("Claude analysis document current changed: " + relative)
        return data
    if sha(data) == row["sha256"]:
        return file(root, row["previous"]).read_bytes()
    return data


def fixture_paths(root):
    from audit_followup_revision import fixture_paths as followup_paths
    from document_ledger import fixture_paths as ledger_paths

    return [*ledger_paths(root), *followup_paths(root), REGISTRY, *[name for row in records(root).values()
                       for name in (row["destination"], row["previous"])]]
