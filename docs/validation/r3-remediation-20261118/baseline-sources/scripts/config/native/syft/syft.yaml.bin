# Catálogo offline das fontes Ox, sem recuperação remota implícita.
check-for-app-update: false
default-catalogers:
  - directory
  - file
package:
  search-indexed-archives: true
  search-unindexed-archives: true
  exclude-binary-overlap-by-ownership: false
exclude: []
javascript:
  include-dev-dependencies: true
dotnet:
  dep-packages-must-claim-dll: false
