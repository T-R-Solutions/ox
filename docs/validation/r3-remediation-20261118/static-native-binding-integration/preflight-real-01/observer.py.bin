import datetime
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

root = Path('/home/rodrigo/Projetos/ox')
out = Path('/tmp/ox-r3-static-preflight-01')
out.mkdir(exist_ok=False)
env = dict(os.environ, TOOLBOX_BIN='/home/rodrigo/Projetos/dev_audit/shared-toolbox/bin/toolbox',
           TOOLBOX_SELINUX_LABEL='shared', CARGO_HOME=str(root/'.cache/ox/cargo-home'),
           PYTHONDONTWRITEBYTECODE='1', PYTHONOPTIMIZE='0')

def capture():
    paths = set()
    for base in ('scripts', 'tools/governance', 'sdd/tools', 'application/tools', 'docs/assets'):
        for p in (root/base).rglob('*'):
            if p.is_file() and not p.is_symlink() and p.suffix in ('.py', '.sh', '.toml', '.json', '.yaml', '.ini'):
                paths.add(p)
    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(paths)}

before = capture()
(out/'inputs-before.json').write_text(json.dumps(before, indent=2)+'\n')
rows = []
for check in ('ruff', 'bandit'):
    stage = out/check
    stage.mkdir()
    previous = set((root/'.local/logs').rglob('*'+check+'*'))
    cmd = ['bash', 'scripts/checks/run.sh', '--check', check]
    started = time.time()
    with (stage/'stdout.log').open('wb') as stdout, (stage/'stderr.log').open('wb') as stderr:
        run = subprocess.run(cmd, cwd=root, env=env, stdout=stdout, stderr=stderr, check=False)
    new = sorted(set((root/'.local/logs').rglob('*'+check+'*'))-previous)
    copied = []
    for p in new:
        if p.is_file():
            target = stage/'native-records'/p.relative_to(root/'.local/logs')
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(p, target)
            copied.append({'source': str(p), 'retained': str(target.relative_to(out)),
                           'sha256': hashlib.sha256(target.read_bytes()).hexdigest()})
    row = {'check': check, 'command': cmd, 'cwd': str(root), 'exit_code': run.returncode,
           'seconds': time.time()-started, 'records': copied}
    rows.append(row)
    (stage/'result.json').write_text(json.dumps(row, indent=2)+'\n')
    print(json.dumps({k:v for k,v in row.items() if k!='records'}), flush=True)
after = capture()
(out/'inputs-after.json').write_text(json.dumps(after, indent=2)+'\n')
changes = [p for p in sorted(before.keys()|after.keys()) if before.get(p)!=after.get(p)]
record = {'results': rows, 'input_changes': changes, 'environment': {k:env[k] for k in ('TOOLBOX_BIN','TOOLBOX_SELINUX_LABEL','CARGO_HOME','PYTHONDONTWRITEBYTECODE','PYTHONOPTIMIZE')},
          'finished_utc': datetime.datetime.now(datetime.UTC).isoformat(),
          'limitations': ['Source/config manifest covers the listed maintained verifier roots; actual scanner assessment/native reports retain their own observed inputs. No global product acceptance.']}
(out/'result.json').write_text(json.dumps(record, indent=2)+'\n')
raise SystemExit(1 if changes or any(row['exit_code'] for row in rows) else 0)
