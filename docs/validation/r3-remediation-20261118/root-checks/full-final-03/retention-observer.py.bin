import datetime, hashlib, json, shutil
from pathlib import Path

root = Path('/home/rodrigo/Projetos/ox')
capture = Path('/tmp/ox-r3-complete-final-03')
run = Path('/var/tmp/ox-r3-final-verification-XltM2HKX/ox-run-vF121JpR')
base = root / 'docs/validation/r3-remediation-20261118/root-checks'
destination = base / 'full-final-03'
pending = base / 'pending-real-optin-final-02'
if not (capture / 'result.json').is_file():
    raise SystemExit('Refuse retention before supervisor final result')
if destination.exists() or pending.exists():
    raise SystemExit('Refuse overwrite of retained observations')

def sha(path):
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()

inventory = []
for label, source in [('capture', capture), ('run-root', run)]:
    for path in sorted(source.rglob('*')):
        if path.is_symlink():
            raise SystemExit(f'Refuse symlink: {path}')
        if path.is_file():
            inventory.append((label, source, path, path.stat().st_size))
if any(size > 64 * 1024 * 1024 for _, _, _, size in inventory):
    raise SystemExit('Inspect unexpected large output before copying')
if sum(size for _, _, _, size in inventory) > 512 * 1024 * 1024:
    raise SystemExit('Inspect unexpected aggregate output before copying')

destination.mkdir(parents=True)
records = []
for label, source, path, size in inventory:
    target = destination / label / path.relative_to(source)
    target.parent.mkdir(parents=True, exist_ok=True)
    before = sha(path)
    shutil.copy2(path, target)
    copied, after = sha(target), sha(path)
    if not before == copied == after:
        raise SystemExit(f'Copy identity mismatch: {path}')
    records.append({'source': str(path), 'retained': str(target.relative_to(root)),
                    'bytes': size, 'sha256': before})
shutil.copy2(__file__, destination / 'retention-observer.py.bin')
result = json.loads((capture / 'result.json').read_text())
receipt = {'retained_at_utc': datetime.datetime.now(datetime.UTC).isoformat(),
           'scope': 'Observed partial full03; never approval of omitted phases',
           'exit_code': result.get('exit_code'), 'files': records,
           'observer_sha256': sha(Path(__file__)),
           'fixture_copies': 'Not duplicated; operational scratch outside run-root'}
(destination / 'retention.json').write_text(json.dumps(receipt, indent=2) + '\n')

pending.mkdir()
launchers = []
for source in [Path('/tmp/ox-r3-real-optin-final-02-supervisor.py'),
               Path('/tmp/ox-r3-optin-capture-02.py')]:
    target = pending / (source.name + '.bin')
    shutil.copy2(source, target)
    if sha(source) != sha(target):
        raise SystemExit('Pending launcher identity mismatch')
    launchers.append({'restore_path': str(source), 'retained_file': target.name,
                      'sha256': sha(target)})
(pending / 'manifest.json').write_text(json.dumps({
    'status': 'NOT EXECUTED', 'launchers': launchers,
    'resume': 'Restore exact bytes and verify hashes, inspect prerequisites and use a new observation directory if started/result already exists. No download authorized for indexmap.'
}, indent=2) + '\n')
print(json.dumps({'retained': str(destination), 'files': len(records),
                  'bytes': sum(item['bytes'] for item in records),
                  'exit_code': result.get('exit_code'), 'pending_optin': str(pending)}))
