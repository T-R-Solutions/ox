import hashlib, importlib.util, json, os, select, subprocess, time, traceback
from pathlib import Path
root=Path('/home/rodrigo/Projetos/ox')
base=root/'docs/validation/r3-remediation-20261118/root-checks'
out=Path('/tmp/ox-r3-native-final-20261118')
spec=importlib.util.spec_from_file_location('native',root/'docs/validation/f0-resumption-20261103/native-session.py')
native=importlib.util.module_from_spec(spec)
spec.loader.exec_module(native)
session=None
record={'primary_desktop_input':False,'method':'isolated headless Mutter + dedicated Xwayland; integrated independently reviewed desktop driver'}
def source_inputs():
 rows={}
 for rel in ['application/crates','application/vendor','application/tools']:
  for item in (root/rel).rglob('*'):
   if item.is_file() and not item.is_symlink():
    rows[str(item.relative_to(root))]=hashlib.sha256(item.read_bytes()).hexdigest()
 for rel in ['application/Cargo.toml','application/Cargo.lock','application/rust-toolchain.toml','docs/design/tokens.json']:
  item=root/rel
  if item.is_file():rows[rel]=hashlib.sha256(item.read_bytes()).hexdigest()
 return rows
before=source_inputs()
record['inputs_before']=before
try:
 session=native.Session(out,'2400x1800')
 rd,wr=os.pipe()
 with (out/'xwayland.log').open('wb') as log:
  server=subprocess.Popen(['Xwayland','-displayfd',str(wr),'-geometry','2000x1600','-nolisten','tcp','-shm','-noreset'],pass_fds=(wr,),env=session.env,stdout=log,stderr=log)
  session.children.append(server)
  os.close(wr)
  if not select.select([rd],[],[],10)[0]: raise RuntimeError('dedicated Xwayland readiness failed')
  display=':'+os.read(rd,32).decode().strip()
  os.close(rd)
  env=dict(session.env,DISPLAY=display,CARGO_HOME=str(root/'.cache/ox/cargo-home'),OX_DESKTOP_CAPTURE_DIR=str(out))
  env.pop('WAYLAND_DISPLAY',None)
  cmd=['cargo','test','--locked','--offline','-p','ox-app','--test','desktop','--','--ignored','--nocapture','--test-threads=1']
  record.update(command=cmd,display=display,desktop_source_sha256=hashlib.sha256((root/'application/crates/ox-app/tests/desktop.rs').read_bytes()).hexdigest())
  start=time.time()
  with (out/'tests.stdout.log').open('wb') as stdout,(out/'tests.stderr.log').open('wb') as stderr:
   run=subprocess.run(cmd,cwd=root/'application',env=env,stdout=stdout,stderr=stderr)
  record.update(exit_code=run.returncode,seconds=time.time()-start)
  after=source_inputs()
  record['inputs_after']=after
  record['input_changes']=[k for k in sorted(before.keys()|after.keys()) if before.get(k)!=after.get(k)]
  record['binaries']={}
  for name in ['ox','local-task','task-oracle','held-task-oracle']:
   item=root/'application/target/debug'/name
   if item.is_file():record['binaries'][name]=hashlib.sha256(item.read_bytes()).hexdigest()
except Exception as error:
 record.update(error=str(error),exit_code=2)
 traceback.print_exc()
finally:
 if session:session.close()
 out.mkdir(parents=True,exist_ok=True)
 (out/'result.json').write_text(json.dumps(record,indent=2)+'\n')
 print(json.dumps(record),flush=True)
raise SystemExit(record['exit_code'])
