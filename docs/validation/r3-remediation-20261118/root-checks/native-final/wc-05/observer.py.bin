"""Current private native WC replay; no product hooks or primary-desktop input."""
import datetime,hashlib,importlib.util,json,os,re,stat,struct,subprocess,sys,time,traceback
from pathlib import Path
ROOT=Path('/home/rodrigo/Projetos/ox');OUT=Path('/tmp/ox-r3-wc-05')
assert __debug__
if OUT.exists():raise SystemExit('Refuse overwrite')
OUT.mkdir();console=sys.stdout;sys.stdout=(OUT/'driver.stdout.log').open('w');sys.stderr=(OUT/'driver.stderr.log').open('w');parent=OUT/'projects';parent.mkdir();existing=parent/'existing';existing.mkdir();(existing/'sentinel').write_bytes(b'preserve\n')
state=OUT/'state';state.mkdir();store=state/'ox/recent-projects.v1'
provider_bin=OUT/'provider-bin';provider_bin.mkdir();provider=provider_bin/'zenity'
provider.write_text('#!/bin/sh\nexec /usr/bin/zenity "$@" 2>> "$OX_R3_ZENITY_LOG"\n');provider.chmod(0o700)

spec=importlib.util.spec_from_file_location('native',ROOT/'docs/validation/f0-resumption-20261103/native-session.py');native=importlib.util.module_from_spec(spec);spec.loader.exec_module(native)
record={'method':'actual final Ox, private Mutter RemoteDesktop/PipeWire, real GTK Zenity, private durable state','scope':'current WC replay, not external desktop/portal or assistive technology acceptance','script_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'session_sha256':hashlib.sha256(Path(spec.origin).read_bytes()).hexdigest(),'sessions':[],'checks':[]}
session=None;app=None;log=None;current=None
def observed_inputs():
 paths=[p for p in (ROOT/'application/crates').rglob('*') if p.is_file() and not p.is_symlink()]
 paths += [ROOT/r for r in ['application/Cargo.toml','application/Cargo.lock','application/rust-toolchain.toml','docs/design/tokens.json']]
 paths += [Path(__file__),Path(spec.origin),provider,Path('/usr/bin/zenity')]
 return {str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
sources=observed_inputs()
record['inputs_before']=sources

def check(ok,label):
 if not ok:raise RuntimeError(label)
 record['checks'].append(label)

def chord(mod,key):
 session.key(mod,True);session.key(key);session.key(mod,False)

def tabs(n):
 for _ in range(abs(n)):
  chord(0xFFE1,0xFF09) if n<0 else session.key(0xFF09)

def text(value):
 for char in str(value):session.key(ord(char))

def replace(value):chord(0xFFE3,ord('a'));text(value)

def title(value,mark=None):
 start_at=current.get('title_cursor',0) if mark is None else mark
 needle='.set_title("'+value
 session.wait(lambda:needle in Path(log.name).read_text()[start_at:],'fresh title '+value,timeout=30)
 current['title_cursor']=Path(log.name).read_text().index(needle,start_at)+len(needle)

def shot(name):session.shot(name)

def click(x,y):
 session.call('RemoteDesktop',session.rd,'NotifyPointerMotionAbsolute','(sdd)',(session.stream,float(x),float(y)))
 time.sleep(.15)
 session.call('RemoteDesktop',session.rd,'NotifyPointerButton','(ib)',(272,True));session.call('RemoteDesktop',session.rd,'NotifyPointerButton','(ib)',(272,False));time.sleep(.2)
 session.events.append({'pointer_click':[x,y],'time':time.monotonic()})

def history():
 b=store.read_bytes();check(b[:8]==b'OXRECENT','snapshot magic')
 version,count=struct.unpack_from('<II',b,8);check(version==1 and count<=20,'snapshot version/bound')
 at=16;rows=[]
 for _ in range(count):
  length,=struct.unpack_from('<I',b,at);at+=4;check(0<length<=16384 and at+length<=len(b),'snapshot entry bound')
  rows.append(b[at:at+length].decode('utf8'));at+=length
 check(at==len(b),'snapshot exact framing');return rows

def expected_history(paths,allow_prior_corruption=False):
 expected=[str(p.resolve()) for p in paths]
 def published():
  if not store.is_file():return False
  try:return history()==expected
  except RuntimeError:
   if not allow_prior_corruption:raise
   record.setdefault('reset_wait_observations',[]).append({'sha256':hashlib.sha256(store.read_bytes()).hexdigest(),'meaning':'prior corrupt bytes still present before asynchronous explicit reset publication'})
   return False
 session.wait(published,'actual MRU '+repr(expected))
 record['checks'].append('actual MRU '+repr(expected))

def no_tasks():check(not list(parent.rglob('.ox-task-*')),'navigation/open/create did not create any task attempt')

def start(name,monitor):
 global session,app,log,current
 session=native.Session(OUT/name,monitor,1)
 session.call('RemoteDesktop',session.rd,'NotifyPointerMotionAbsolute','(sdd)',(session.stream,1.0,1.0))
 log=(OUT/name/'wayland.log').open('w')
 env=dict(session.env,WAYLAND_DEBUG='1',OX_VALIDATION_SESSION=name,XDG_STATE_HOME=str(state),GDK_BACKEND='wayland',GDK_DEBUG='no-portals',GTK_A11Y='none',GSETTINGS_BACKEND='memory',GTK_USE_PORTAL='0',PATH=str(provider_bin)+':'+session.env.get('PATH',''),OX_R3_ZENITY_LOG=str(OUT/name/'zenity.stderr.log'))
 binary=ROOT/'application/target/debug/ox'
 app=subprocess.Popen([str(binary)],cwd=ROOT,env=env,stdout=log,stderr=log);session.children.append(app)
 current={'chooser_stderr':str(OUT/name/'zenity.stderr.log'),'provider_adapter':str(provider),'provider_adapter_sha256':hashlib.sha256(provider.read_bytes()).hexdigest(),'real_zenity_sha256':hashlib.sha256(Path('/usr/bin/zenity').read_bytes()).hexdigest(),'name':name,'monitor':monitor,'pid':app.pid,'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'XDG_STATE_HOME':str(state),'dialog':'real installed zenity with private Wayland and GTK portal disabled; portal latency not claimed'};record['sessions'].append(current)
 title('Central de projetos');time.sleep(.6);session.key(0xFFE1)
 session.wait(lambda:'.enter(' in Path(log.name).read_text(),'keyboard focus')
 def actual_geometry():
  pairs=re.findall(r'xdg_toplevel#\d+\.configure\((\d+), (\d+),',Path(log.name).read_text())
  valid=[(int(w),int(h)) for w,h in pairs if int(w)>0 and int(h)>0]
  return valid[-1] if valid else None
 expected=tuple(map(int,monitor.split('x')))
 session.wait(lambda:actual_geometry() is not None,'initial configured geometry')
 if actual_geometry()!=expected:chord(0xFFE9,0xFFC7)
 session.wait(lambda:actual_geometry()==expected,'actual configured monitor geometry '+monitor)
 ack=time.monotonic();session.wait(lambda:session.latest is not None and session.latest[0]>ack,'fresh frame after actual geometry acknowledgement')
 current['configured_geometry']=list(actual_geometry());shot('initial')

def close_private_session():
 # Historical helper closes the listener but leaves its own socket pathname.
 endpoint=Path(session.buspath);before=endpoint.lstat()
 check(str(endpoint)=='/tmp/ox-f0-bus-'+str(os.getpid()) and stat.S_ISSOCK(before.st_mode) and before.st_uid==os.getuid(),'private bus endpoint ownership/type')
 session.close()
 check(all(p.poll() is not None for p in session.children),'private compositor/session children all exited')
 after=endpoint.lstat()
 check((before.st_dev,before.st_ino)==(after.st_dev,after.st_ino) and stat.S_ISSOCK(after.st_mode),'same closed private socket inode before cleanup')
 endpoint.unlink()
 record.setdefault('closed_operational_sockets',[]).append({'path':str(endpoint),'inode':before.st_ino,'meaning':'owned socket pathname removed only after all owned children exited; no historical evidence removed'})

def stop():
 global session,app,log
 if app is not None and app.poll() is None:
  chord(0xFFE9,0xFFC1);session.wait(lambda:app.poll() is not None,'natural exit',timeout=30)
 if app is not None:
  check(app.returncode==0,'natural exit zero');current['natural_exit']=app.returncode
  check(hashlib.sha256((ROOT/'application/target/debug/ox').read_bytes()).hexdigest()==current['binary_sha256'],'actual binary bytes unchanged through session')
 if session is not None:
  current['events']=session.events;close_private_session();session=None
 if log is not None:log.close();log=None
 app=None

def picker_children():
 ids=set()
 for p in Path('/proc/'+str(app.pid)+'/task').glob('*/children'):
  try:ids.update(p.read_text().split())
  except FileNotFoundError:pass
 found=[]
 for pid in ids:
  try:
   argv=(Path('/proc')/pid/'cmdline').read_bytes().split(b'\0')
   if argv and Path(os.fsdecode(argv[0])).name=='zenity':found.append(int(pid))
  except FileNotFoundError:pass
 return found

def chooser(cancel=False,path=None):
 provider_log=Path(current['chooser_stderr']);mark=provider_log.stat().st_size if provider_log.exists() else 0
 session.key(0xFF0D)
 session.wait(lambda:bool(picker_children()),'real Zenity direct child',timeout=60)
 owned=picker_children();current.setdefault('chooser_pids',[]).append(owned)
 session.wait(lambda:provider_log.exists() and '.set_title("Escolher pasta' in provider_log.read_text()[mark:],'actual GTK chooser mapping via transparently captured stderr',timeout=60)
 time.sleep(.4)
 chord(0xFFE3,ord('l'));replace(str(path or parent)+'/');session.key(0xFFFF)
 shot('chooser-cancel' if cancel else 'chooser-confirm')
 if cancel:
  session.key(0xFF1B)  # Close GTK's Ctrl+L location editor first.
  time.sleep(.25)
  if any(Path('/proc',str(pid)).exists() for pid in owned):session.key(0xFF1B)  # Then cancel the actual dialog.
 else:
  session.key(0xFF0D);time.sleep(.4)
  if picker_children():session.key(0xFF0D)
 session.wait(lambda:all(not Path('/proc',str(pid)).exists() for pid in owned),'actual Zenity PID disappearance after reap',timeout=60);time.sleep(.3)
 if not cancel:title('Tarefas — '+path.name)
 shot('chooser-cancel-return' if cancel else 'chooser-confirm-return');no_tasks()

def new_form(name,parent_value):
 # Settings round-trip returns Start with stable Open-folder focus.
 click(1568,60);title('Preferências');session.key(0xFF1B);title('Central de projetos')
 tabs(-1);session.key(0xFF0D);title('Novo projeto')
 replace(name);tabs(1);replace(parent_value)

def nav(code,expected):
 tabs(1);chord(0xFFE3,ord('k'));text(code);mark=len(Path(log.name).read_text());session.key(0xFF0D);title(expected,mark);time.sleep(.2)

try:
 start('wide','1600x1000')
 tabs(3);chooser(cancel=True)
 check(not store.exists(),'cancelled chooser did not publish history')
 new_form('cancelled',parent);shot('create-cancel-preview');session.key(0xFF1B);title('Central de projetos');check(not (parent/'cancelled').exists(),'creation cancelled before confirmation')
 before_collision={str(p.relative_to(existing)):('file',hashlib.sha256(p.read_bytes()).hexdigest()) if p.is_file() else ('directory',None) for p in existing.rglob('*')}
 new_form('existing',parent);tabs(2);session.key(0xFF0D);time.sleep(.6);shot('collision-error');check({str(p.relative_to(existing)):('file',hashlib.sha256(p.read_bytes()).hexdigest()) if p.is_file() else ('directory',None) for p in existing.rglob('*')}==before_collision,'collision preserves complete existing tree');check((existing/'sentinel').read_bytes()==b'preserve\n','collision preserves existing bytes');check(not store.exists(),'collision does not record a successful open')
 session.key(0xFF1B);title('Central de projetos')
 new_form('new',parent);shot('create-destination-preview');tabs(2);session.key(0xFF0D);title('Tarefas — new');created=parent/'new';check(created.is_dir() and not list(created.iterdir()),'confirmed exclusive creation is empty');expected_history([created]);no_tasks();shot('created')
 nav('s01','Central de projetos');chooser(path=existing);expected_history([existing,created]);shot('opened-existing');check((existing/'sentinel').read_bytes()==b'preserve\n','opening preserves existing bytes');stop()
 start('restart','1600x1000');expected_history([existing,created]);no_tasks();shot('actual-mru-restarted')
 moved=parent/'moved';existing.rename(moved);tabs(6);session.key(0xFF0D);time.sleep(.7);shot('unavailable-reopen');expected_history([existing,created]);check((moved/'sentinel').read_bytes()==b'preserve\n','missing reopen preserves moved project')
 # Missing open leaves the same first-recent control, with Remove next in order.
 tabs(1);session.key(0xFF0D);expected_history([created]);shot('removed-unavailable');check((moved/'sentinel').read_bytes()==b'preserve\n','removing metadata never removes project');stop()
 start('removal-restart','1600x1000');expected_history([created]);shot('removal-persisted');tabs(6);session.key(0xFF0D);title('Tarefas — new');no_tasks();shot('remaining-project-reopened');stop()
 for width in [1024,2560]:
  start('width-'+str(width),str(width)+'x1000');tabs(6);session.key(0xFF0D);title('Tarefas — new');shot('command-bar');click(220,60);shot('file-menu');session.key(0xFF1B);shot('menu-escape-focus');click(220,60);click(min(width-100,1000),230);shot('menu-outside-focus');no_tasks()
  if width==2560:nav('w00','Editor e arquivos');shot('full-width-embedded-editor')
  stop()
 start('narrow','640x480');expected_history([created]);no_tasks();shot('actual-recent-narrow');tabs(1);session.key(0xFF0D);title('Preferências');tabs(2);session.key(0xFF0D);shot('dark-settings');tabs(1);session.key(0xFF0D);shot('high-contrast-settings');tabs(2);session.key(0xFF0D);shot('compact-settings');tabs(2);session.key(0xFF0D);title('Central de projetos');shot('high-contrast-compact-entry');tabs(-2);session.key(0xFF0D);title('Preferências');tabs(1);session.key(0xFF0D);tabs(3);session.key(0xFF0D);tabs(3);session.key(0xFF0D);title('Central de projetos');shot('light-comfortable-entry');tabs(-1);session.key(0xFF0D);title('Novo projeto');replace('narrow-cancel');tabs(1);replace(parent);tabs(2);shot('create-confirmation-keyboard-focus');session.key(0xFF1B);check(not (parent/'narrow-cancel').exists(),'narrow keyboard cancellation creates nothing');no_tasks();stop()
 original=store.read_bytes();(OUT/'actual-history-before-corruption.bin').write_bytes(original);corrupt=b'R3 actual private corrupt snapshot\n';store.write_bytes(corrupt)
 start('recovery','1600x1000');shot('corrupt-history');check(store.read_bytes()==corrupt,'loading corruption preserves all bytes');tabs(6);session.key(0xFF0D);shot('explicit-reset-confirmation');check(store.read_bytes()==corrupt,'reset prompt is not reset action');tabs(1);session.key(0xFF0D);expected_history([],allow_prior_corruption=True);shot('reset-empty');backups=[p for p in store.parent.iterdir() if 'corrupt-backup' in p.name];check(len(backups)==1 and backups[0].read_bytes()==corrupt,'reset retains exact corrupt backup');no_tasks();stop()
 record['result']='observed; screenshots require human semantic review'
except Exception as error:
 record['error']=str(error)
 if session:
  try:shot('failure')
  except Exception:pass
 traceback.print_exc()
finally:
 if app is not None:current['exit_before_cleanup']=app.poll()
 if session is not None:
  current['events']=session.events;close_private_session()
 if log is not None:log.close()
 after=observed_inputs()
 record['input_changes']=[k for k in sorted(sources.keys()|after.keys()) if sources.get(k)!=after.get(k)]
 if record['input_changes']:
  record.setdefault('error','observed input drift; cannot accept');record['result']='INCONCLUSIVE due to input drift'
 (OUT/'observer.py.bin').write_bytes(Path(__file__).read_bytes())
 (OUT/'result.json').write_text(json.dumps(record,indent=2)+'\n')
 print(json.dumps({k:v for k,v in record.items() if k not in ['sessions','inputs_before','checks']}),flush=True,file=console)
raise SystemExit(1 if 'error' in record else 0)
