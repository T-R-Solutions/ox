import datetime, hashlib, json, os, subprocess, sys, time
from pathlib import Path
root=Path('/home/rodrigo/Projetos/ox')
out=Path('/tmp/ox-r3-root-final-checks');out.mkdir(exist_ok=True)
name=sys.argv[1]
cmd=sys.argv[2:]
inputs={}
for base in ['application/crates','application/tools','application/vendor']:
 for p in (root/base).rglob('*'):
  if p.is_file() and not p.is_symlink(): inputs[str(p.relative_to(root))]=hashlib.sha256(p.read_bytes()).hexdigest()
for rel in ['application/Cargo.toml','application/Cargo.lock','docs/design/tokens.json','DESIGN.md','docs/design/surfaces.md']:
 inputs[rel]=hashlib.sha256((root/rel).read_bytes()).hexdigest()
(out/(name+'-inputs.json')).write_text(json.dumps(inputs,indent=2)+'\n')
env=dict(os.environ,CARGO_HOME=str(root/'.cache/ox/cargo-home'),PYTHONDONTWRITEBYTECODE='1')
start=time.time()
with (out/(name+'.stdout.log')).open('wb') as stdout, (out/(name+'.stderr.log')).open('wb') as stderr:
 result=subprocess.run(cmd,cwd=root/'application',env=env,stdout=stdout,stderr=stderr)
record={'command':cmd,'cwd':str(root/'application'),'exit_code':result.returncode,'seconds':time.time()-start,'CARGO_HOME':env['CARGO_HOME'],'time_utc':datetime.datetime.now(datetime.UTC).isoformat(),'TOOLBOX_BIN':env.get('TOOLBOX_BIN'),'TOOLBOX_SELINUX_LABEL':env.get('TOOLBOX_SELINUX_LABEL'),'inputs_unchanged':all((root/k).is_file() and hashlib.sha256((root/k).read_bytes()).hexdigest()==v for k,v in inputs.items())}
(out/(name+'-result.json')).write_text(json.dumps(record,indent=2)+'\n')
record['input_changes']=[k for k,v in inputs.items() if not (root/k).is_file() or hashlib.sha256((root/k).read_bytes()).hexdigest()!=v]
(out/(name+'-result.json')).write_text(json.dumps(record,indent=2)+'\n')
print(json.dumps(record),flush=True)
sys.exit(result.returncode)
