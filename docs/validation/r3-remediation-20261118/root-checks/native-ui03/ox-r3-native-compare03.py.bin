from pathlib import Path
from PIL import Image,ImageChops,__version__ as pillow_version
import hashlib,json
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
observations=[]
for label,old,new in [('maintained-wayland','/tmp/ox-r3-wayland-final-01','/tmp/ox-r3-wayland-final-03'),('maintained-composition','/tmp/ox-r3-composition-final-01','/tmp/ox-r3-composition-final-03'),('wc','/tmp/ox-r3-wc-07','/tmp/ox-r3-wc-08')]:
 old=Path(old);new=Path(new);pairs=[]
 for p in sorted(old.rglob('*.png')):
  q=new/p.relative_to(old)
  if not q.is_file():continue
  old_sha,new_sha=sha(p),sha(q)
  a=Image.open(p).convert('RGB');b=Image.open(q).convert('RGB')
  row={'name':str(p.relative_to(old)),'old_path':str(p),'new_path':str(q),'old_sha256':old_sha,'new_sha256':new_sha,'old_dimensions':list(a.size),'new_dimensions':list(b.size)}
  if a.size==b.size:
   row['full_diff_bbox']=ImageChops.difference(a,b).getbbox()
   regions={'top-content-band':(0,35,a.width,83),'left-column':(0,116,min(262,a.width),min(a.height,975))}
   row['regions']={name:{'box':list(box),'diff_bbox':ImageChops.difference(a.crop(box),b.crop(box)).getbbox()} for name,box in regions.items()}
  assert old_sha==sha(p) and new_sha==sha(q),'Observed PNG changed while read'
  pairs.append(row)
 observations.append({'scenario':label,'old_root':str(old),'new_root':str(new),'pairs':pairs})
out=Path('/tmp/ox-r3-native-ui03-compare-bound.json')
out.write_text(json.dumps({'method':'Explicit RGB PNG comparisons with before/after file hash checks; full-image and bounded regions, no normalization or masked deletion','observer_path':str(Path(__file__)),'observer_sha256':sha(Path(__file__)),'pillow_version':pillow_version,'limitations':['Region names denote geometric boxes, not proof sidebar/chrome is visible in every view.','Differences require semantic review; dynamic system titles, paths, observation times remain differences.','These comparisons and image hashes do not assert new direct human approval.'], 'observations':observations},indent=2)+'\n')
for obs in observations:
 print(obs['scenario'],'pairs',len(obs['pairs']),'top-band-identical',sum(r.get('regions',{}).get('top-content-band',{}).get('diff_bbox','missing') is None for r in obs['pairs']))
