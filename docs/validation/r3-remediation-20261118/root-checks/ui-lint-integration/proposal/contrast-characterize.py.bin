from pathlib import Path
import re,subprocess,json,hashlib
base=Path('/tmp/ox-r3-ui-lint-proposal-hx9k2w90')
rel='application/crates/ox-ui/src/design.rs'
def body(s):
 st=s.index('    fn contrast('); br=s.index('{',st);depth=0
 for end in range(br,len(s)):
  if s[end]=='{':depth+=1
  elif s[end]=='}':
   depth-=1
   if not depth:return s[st:end+1]
old=(base/'before'/rel).read_text();new=(base/'after'/rel).read_text()
assert old.split('#[cfg(test)]')[0]==new.split('#[cfg(test)]')[0]
tokens=Path('/home/rodrigo/Projetos/ox/application/crates/ox-ui/src/tokens.rs').read_bytes()
colors=sorted(set(re.findall(r'Color::from_rgb8\((\d+), (\d+), (\d+)\)',tokens.decode())))
src='#[derive(Clone,Copy)]struct Color{r:f32,g:f32,b:f32}\n'
for name,s in [('before',old),('after',new)]:src+=body(s).replace('fn contrast(',f'fn {name}(')+'\n'
src+='fn main(){let colors=['+','.join('Color{r:'+r+'f32/255.,g:'+g+'f32/255.,b:'+b+'f32/255.}' for r,g,b in colors)+'];\n'
src+='''let(mut pairs,mut changed,mut max_delta)=(0,0,0_f32);for a in colors{for b in colors{let x=before(a,b);let y=after(a,b);assert!(x.is_finite()&&y.is_finite());let delta=(x-y).abs();assert!(delta<=0.00001);for threshold in [3.,4.5,7.]{assert_eq!(x>=threshold,y>=threshold,"acceptance boundary changed");}pairs+=1;if x.to_bits()!=y.to_bits(){changed+=1;max_delta=max_delta.max(delta);}}}println!("palette_colors={} pairs={pairs} changed={changed} max_abs_delta={max_delta}",colors.len());}'''
p=base/'contrast-characterization.rs';p.write_text(src)
results=[]
for cmd in [['rustc','--edition','2024',str(p),'-o',str(base/'contrast-characterization')],[str(base/'contrast-characterization')]]:
 r=subprocess.run(cmd,capture_output=True);results.append({'command':cmd,'exit':r.returncode,'stdout':r.stdout.decode(),'stderr':r.stderr.decode()})
 if r.returncode:break
(base/'contrast-characterization.json').write_text(json.dumps({'source_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'tokens_sha256':hashlib.sha256(tokens).hexdigest(),'production_prefix_byte_identical':True,'results':results,'limitations':'Extracts actual contrast helper and compares all current token RGB pairs and thresholds3/4.5/7. Does not replace real style tests/native rendering.'},indent=2)+'\n');print(json.dumps(results[-1],indent=2))
