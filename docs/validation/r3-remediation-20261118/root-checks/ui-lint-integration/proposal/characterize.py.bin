from pathlib import Path
import subprocess, hashlib, json
base=Path('/tmp/ox-r3-ui-lint-proposal-hx9k2w90')
surfaces=['Start','NewProject','Project','Tasks','NewTask','Activity','Decisions','Agents','AgentSettings','Providers','Context','Tools','Settings','Appearance','Editor','Architecture','Orchestration','Observability','Review','Recovery','Focus','Problems','Tests','Trace','Terminal','Sdd','Skills']
scaffold=r'''
#![allow(dead_code)]
extern crate self as iced;
#[derive(Clone,Copy,Default,Debug)] pub struct Color {r:f32,g:f32,b:f32,a:f32}
impl Color {pub const TRANSPARENT:Self=Self{r:0.,g:0.,b:0.,a:0.};}
#[derive(Clone,Copy,Default,Debug)] pub struct Rectangle {x:f32,y:f32,width:f32,height:f32}
#[derive(Clone,Copy,Default,Debug)] pub struct Radius(f32);
impl From<f32> for Radius {fn from(v:f32)->Self{Self(v)}}
#[derive(Clone,Copy,Default,Debug)] pub struct Border{color:Color,width:f32,radius:Radius}
#[derive(Clone,Copy)] pub enum Length{Fixed(f32)}
#[derive(Clone,Copy)] pub struct Size<T=f32>{width:T,height:T}
impl<T> Size<T>{pub fn new(width:T,height:T)->Self{Self{width,height}}}
pub struct Theme;
pub struct Element<'a,M>(std::marker::PhantomData<&'a M>);
impl<'a,M> Element<'a,M>{pub fn new<W>(_:W)->Self{Self(std::marker::PhantomData)}}
#[derive(Default)] pub struct Renderer{quads:Vec<(advanced::renderer::Quad,Color)>}
pub mod advanced {
    pub mod widget{pub struct Tree;}
    pub mod mouse{pub struct Cursor;}
    pub mod renderer{
        #[derive(Clone,Copy,Default,Debug)]pub struct Quad{pub bounds:crate::Rectangle,pub border:crate::Border,pub shadow:u8}
        pub struct Style{pub text_color:crate::Color}
    }
    pub mod layout{
        pub struct Node;
        impl Node{pub fn new(_:crate::Size)->Self{Self}}
        pub struct Limits;
        impl Limits{pub fn resolve(&self,_:u16,_:u16,s:crate::Size)->crate::Size{s}}
    }
    pub struct Layout<'a>(pub crate::Rectangle,pub std::marker::PhantomData<&'a ()>);
    impl Layout<'_>{pub fn bounds(&self)->crate::Rectangle{self.0}}
    pub trait Renderer{fn fill_quad(&mut self,q:renderer::Quad,c:crate::Color);}
    impl Renderer for crate::Renderer{fn fill_quad(&mut self,q:renderer::Quad,c:crate::Color){self.quads.push((q,c));}}
    pub trait Widget<M,T,R>{
        fn size(&self)->crate::Size<crate::Length>;
        fn layout(&mut self,t:&mut widget::Tree,r:&R,l:&layout::Limits)->layout::Node;
        fn draw(&self,t:&widget::Tree,r:&mut R,theme:&T,s:&renderer::Style,l:Layout<'_>,c:mouse::Cursor,v:&crate::Rectangle);
    }
}
mod workbench{#[derive(Clone,Copy)]pub enum Surface{SURFACES}}
'''.replace('SURFACES',','.join(surfaces))
probe=r'''
pub(super) fn observe(origin:crate::Rectangle,color:crate::Color)->Vec<(bool,Vec<(crate::advanced::renderer::Quad,crate::Color)>)>{
    let mut kinds=vec![Kind::Folder,Kind::Repository,Kind::Plus,Kind::Panels,Kind::Search,Kind::Settings,Kind::Activity,Kind::Close,Kind::Info,Kind::Plugin,Kind::Chevron,Kind::Dock,Kind::Status];
    kinds.extend([SURFACES].map(Kind::Destination));
    kinds.into_iter().map(|kind|{
        let mut r=crate::Renderer::default();
        <Icon as crate::advanced::Widget<(),crate::Theme,crate::Renderer>>::draw(&Icon(kind),&crate::advanced::widget::Tree,&mut r,&crate::Theme,&crate::advanced::renderer::Style{text_color:color},crate::advanced::Layout(origin,std::marker::PhantomData),crate::advanced::mouse::Cursor,&origin);
        (matches!(kind,Kind::Settings|Kind::Destination(Surface::Settings|Surface::AgentSettings)),r.quads)
    }).collect()
}
'''.replace('SURFACES',','.join('Surface::'+s for s in surfaces))
main=r'''
fn bits(q:advanced::renderer::Quad,c:Color)->[u32;14]{[q.bounds.x.to_bits(),q.bounds.y.to_bits(),q.bounds.width.to_bits(),q.bounds.height.to_bits(),q.border.color.r.to_bits(),q.border.color.g.to_bits(),q.border.color.b.to_bits(),q.border.color.a.to_bits(),q.border.width.to_bits(),q.border.radius.0.to_bits(),c.r.to_bits(),c.g.to_bits(),c.b.to_bits(),c.a.to_bits()]}
fn main(){
 let coordinates=[-8192.,-1024.,-16.,-0.5,0.,0.25,1.,6.8,15.75,640.,1024.,1600.,2560.,4096.,8192.];
 let colors=[Color{r:0.,g:0.,b:0.,a:0.},Color{r:1.,g:1.,b:1.,a:1.},Color{r:0.25,g:0.5,b:0.75,a:1.},Color{r:0.9,g:0.1,b:0.2,a:0.5}];
 let(mut cases,mut quads,mut changed,mut max_delta)=(0,0,0,0_f32);
 for x in coordinates {for y in coordinates {for color in colors {
  let origin=Rectangle{x,y,width:16.,height:16.};
  let old=before::observe(origin,color);let new=after::observe(origin,color);
  assert_eq!(old.len(),40);assert_eq!(old.len(),new.len());
  for ((old_cog,old),(new_cog,new)) in old.into_iter().zip(new){
   assert_eq!(old_cog,new_cog);assert_eq!(old.len(),new.len());cases+=1;
   for ((oq,oc),(nq,nc)) in old.into_iter().zip(new){
    let ob=bits(oq,oc);let nb=bits(nq,nc);quads+=1;
    assert_eq!(oq.shadow,nq.shadow);
    if !old_cog {assert_eq!(ob,nb);}else{
      assert_eq!(&ob[2..],&nb[2..]);
      for (axis,(a,b)) in [(oq.bounds.x,nq.bounds.x),(oq.bounds.y,nq.bounds.y)].into_iter().enumerate(){
       let delta=(a-b).abs();let anchor=if axis==0{x}else{y};
       let bound=2.*f32::EPSILON*((anchor+6.8).abs()+5.6);
       assert!(delta<=bound,"cog displacement {delta} exceeds {bound} at {x}/{y}");
       if a.to_bits()!=b.to_bits(){changed+=1;max_delta=max_delta.max(delta);}
      }
    }
   }
  }
 }}}
 println!("cases={cases} quads={quads} changed_cog_coordinates={changed} max_abs_delta={max_delta}");
}
'''
src=scaffold
for variant in ['before','after']:
    path=base/variant/'application/crates/ox-ui/src/desktop/icons.rs'
    code=path.read_text().split('\n',1)[1]
    src+='\nmod '+variant+' {\n'+code+probe+'\n}\n'
src+=main
source=base/'icons-characterization.rs';source.write_text(src)
commands=[['rustc','--edition','2024',str(source),'-o',str(base/'icons-characterization')],[str(base/'icons-characterization')]]
results=[]
for i,cmd in enumerate(commands):
    proc=subprocess.run(cmd,capture_output=True)
    (base/f'characterization-{i}.stdout.log').write_bytes(proc.stdout);(base/f'characterization-{i}.stderr.log').write_bytes(proc.stderr)
    results.append({'command':cmd,'exit':proc.returncode,'stdout':proc.stdout.decode(),'stderr':proc.stderr.decode()})
    if proc.returncode:break
(base/'characterization.json').write_text(json.dumps({'source_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),'results':results,'limitations':'Standalone recording renderer tests source-emitted quad commands, not Iced rendering, default internals, pixels or native interactions. Exact non-cog bit identity; bounded FMA displacement only cog x/y.'},indent=2)+'\n')
print(json.dumps(results[-1],indent=2))
