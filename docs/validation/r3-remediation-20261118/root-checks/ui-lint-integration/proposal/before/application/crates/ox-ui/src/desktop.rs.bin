mod splitter;
mod views;
#[expect(
    clippy::struct_excessive_bools,
    reason = "Independent transient UI toggles; domain state lives in Controller"
)]
struct Desktop {
    controller: Arc<Mutex<Controller>>,
    cancel: Arc<AtomicBool>,
    path: String,
    selected: bool,
    workspace_error: Option<String>,
    picker: Option<folder_picker::Request>,
    picker_serial: u64,
    picker_error: Option<String>,
    picker_parent: bool,
    manual_path: bool,
    project_name: String,
    project_parent: String,
    project_request: Option<Arc<AtomicBool>>,
    recent: Vec<PathBuf>,
    history_busy: bool,
    history_serial: u64,
    history_error: Option<String>,
    reset_confirmation: bool,
    result: bool,
    busy: bool,
    closing: bool,
    generation: u64,
    status: String,
    details: bool,
    focus: Option<usize>,
    validation_label: Option<String>,
    appearance: Appearance,
    density: Density,
    surface: Surface,
    settings_origin: Option<(Appearance, Density, Surface)>,
    navigation_open: bool,
    navigation_width: f32,
    navigation_drag: bool,
    navigation_grab: f32,
    width: f32,
    command_open: bool,
    command: String,
    command_selection: usize,
    return_focus: Option<usize>,
    draft: String,
    graph_exploratory: bool,
    demo_document: usize,
    /// Open command menu; while set, traversal is modal to its items.
    menu: Option<chrome::Menu>,
    /// Open document tabs in opening order (presentation state only).
    tabs: Vec<Surface>,
    dock_open: bool,
    dock_tool: Surface,
    recent_filter: String,
}
impl Default for Desktop {
    fn default() -> Self {
        let binaries = std::env::current_exe()
            .ok()
            .and_then(|p| p.parent().map(PathBuf::from))
            .unwrap_or_default();
        Self {
            controller: Arc::new(Mutex::new(Controller::new(binaries))),
            cancel: Arc::new(AtomicBool::new(false)),
            path: String::new(),
            selected: false,
            workspace_error: None,
            picker: None,
            picker_serial: 0,
            picker_error: None,
            picker_parent: false,
            manual_path: false,
            project_name: String::new(),
            project_parent: String::new(),
            project_request: None,
            recent: Vec::new(),
            history_busy: false,
            history_serial: 0,
            history_error: None,
            reset_confirmation: false,
            result: false,
            busy: false,
            closing: false,
            generation: 0,
            status:
                "UNVERIFIED. Controlled fixture; no sandbox or remote agents. Task history is session-only."
                    .into(),
            details: false,
            focus: None,
            validation_label: std::env::var("OX_VALIDATION_SESSION").ok(),
            appearance: Appearance::default(),
            density: Density::default(),
            surface: Surface::default(),
            settings_origin: None,
            navigation_open: true,
            navigation_width: 256.0,
            navigation_drag: false,
            navigation_grab: 0.0,
            width: 1280.0,
            command_open: false,
            command: String::new(),
            command_selection: 0,
            return_focus: None,
            draft: String::new(),
            graph_exploratory: false,
            demo_document: 0,
            menu: None,
            tabs: Vec::new(),
            dock_open: false,
            dock_tool: Surface::Problems,
            recent_filter: String::new(),
        }
    }
}
#[derive(Clone, Debug)]
enum Message {
    Path(String),
    Select,
    ChooseFolder,
    ProjectName(String),
    ProjectParent(String),
    CreateProject,
    OpenRecent(PathBuf),
    History(HistoryAction),
    ResetConfirmation(bool),
    HistoryDone(u64, std::result::Result<Vec<PathBuf>, String>),
    ProjectDone(u64, OpenOutcome),
    FolderChosen(u64, folder_picker::Selection),
    Start(&'static str),
    Verify,
    Refresh,
    Cancel,
    Close,
    Toggle,
    Focus(bool),
    Activate,
    InputFocused(usize),
    Scroll(f32),
    Navigate(Surface),
    SaveSettings,
    BackSettings,
    Appearance(Appearance),
    CycleAppearance,
    Density(Density),
    CycleDensity,
    Navigation,
    Resize(f32),
    SidebarStart(f32),
    SidebarMove(f32),
    SidebarEnd,
    SidebarAdjust(f32),
    Command,
    CommandInput(String),
    CommandGo,
    CommandMove(bool),
    Escape,
    Draft(String),
    GraphMode(bool),
    DemoDocument(usize),
    /// Open, toggle (same menu) or close (`None`) a command menu.
    Menu(Option<chrome::Menu>),
    /// Execute the menu item with this control id, then close the menu.
    MenuItem(usize),
    CloseTab(Surface),
    Dock,
    OpenFolder,
    RecentFilter(String),
    Done(u64, Action, std::result::Result<String, String>),
}
#[derive(Clone, Copy, Debug)]
enum Action {
    Start,
    Verify,
    Refresh,
}
#[derive(Clone, Debug)]
enum HistoryAction {
    Load,
    Remove(PathBuf),
    Reset,
}
#[derive(Clone, Debug)]
struct OpenOutcome {
    result: std::result::Result<String, String>,
    canonical: Option<PathBuf>,
    history: Option<std::result::Result<Vec<PathBuf>, String>>,
    created: Option<PathBuf>,
}

// Query the actual layout rather than estimating row heights. Full paths and
// diagnostics may wrap to arbitrary heights at the minimum window size.
struct RevealControl {
    scroller: &'static str,
    target: iced::widget::Id,
    bounds: Option<iced::Rectangle>,
    viewport: Option<(iced::Rectangle, iced::Vector)>,
}
impl iced::advanced::widget::Operation<Message> for RevealControl {
    fn traverse(
        &mut self,
        operate: &mut dyn FnMut(&mut dyn iced::advanced::widget::Operation<Message>),
    ) {
        operate(self);
    }
    fn container(&mut self, id: Option<&iced::widget::Id>, bounds: iced::Rectangle) {
        if id == Some(&self.target) {
            self.bounds = Some(bounds);
        }
    }
    fn scrollable(
        &mut self,
        id: Option<&iced::widget::Id>,
        bounds: iced::Rectangle,
        _: iced::Rectangle,
        translation: iced::Vector,
        _: &mut dyn iced::advanced::widget::operation::Scrollable,
    ) {
        if id == Some(&iced::widget::Id::new(self.scroller)) {
            self.viewport = Some((bounds, translation));
        }
    }
    fn finish(&self) -> iced::advanced::widget::operation::Outcome<Message> {
        use iced::advanced::widget::operation::{Outcome, scrollable};
        if let (Some(target), Some((viewport, translation))) = (self.bounds, self.viewport) {
            let top = target.y - translation.y;
            let bottom = top + target.height;
            let delta = if top < viewport.y + 8.0 {
                top - viewport.y - 8.0
            } else if bottom > viewport.y + viewport.height - 8.0 {
                bottom - viewport.y - viewport.height + 8.0
            } else {
                0.0
            };
            if delta.abs() > 0.5 {
                return Outcome::Chain(Box::new(scrollable::scroll_by(
                    iced::widget::Id::new(self.scroller),
                    scrollable::AbsoluteOffset { x: 0.0, y: delta },
                )));
            }
        }
        Outcome::None
    }
}
impl Desktop {
    const fn entry(&self) -> bool {
        matches!(self.surface, Surface::Start | Surface::NewProject)
    }
    /// Recent projects matching the session filter, with their stable list
    /// index (control ids derive from it). Order remains most-recent first.
    fn visible_recent(&self) -> Vec<(usize, &PathBuf)> {
        let filter = self.recent_filter.trim().to_lowercase();
        self.recent
            .iter()
            .enumerate()
            .filter(|(_, path)| {
                filter.is_empty() || path.to_string_lossy().to_lowercase().contains(&filter)
            })
            .collect()
    }
    const fn project_available(&self) -> bool {
        !self.busy && !self.history_busy && !self.closing && self.picker.is_none()
    }
    fn reveal_scroller(&self, id: usize) -> &'static str {
        if self.surface == Surface::Start && matches!(id, 2 | 3 | 273 | 274) {
            "welcome-sidebar"
        } else {
            "main"
        }
    }
    fn reveal(&self, id: usize) -> Task<Message> {
        iced::advanced::widget::operate(RevealControl {
            scroller: self.reveal_scroller(id),
            target: iced::widget::Id::from(format!("welcome-control-{id}")),
            bounds: None,
            viewport: None,
        })
    }
    fn initialize() -> (Self, Task<Message>) {
        let mut state = Self::default();
        let task = state.history(HistoryAction::Load);
        (state, task)
    }
    fn history(&mut self, action: HistoryAction) -> Task<Message> {
        if self.history_busy || self.busy || self.closing || self.picker.is_some() {
            return Task::none();
        }
        self.history_busy = true;
        self.history_serial += 1;
        self.reset_confirmation = false;
        let id = self.history_serial;
        let (send, receive) = iced::futures::channel::oneshot::channel();
        let spawn = std::thread::Builder::new()
            .name("ox-recent-projects".into())
            .spawn(move || {
                let result = project_store::history_path().and_then(|p| {
                    let store = project_store::RecentStore::new(p);
                    match action {
                        HistoryAction::Load => store.load(),
                        HistoryAction::Remove(path) => store.remove(&path),
                        HistoryAction::Reset => store.reset(),
                    }
                });
                let _ = send.send(result);
            });
        if let Err(error) = spawn {
            self.history_busy = false;
            self.history_error = Some(format!("Histórico indisponível: {error}"));
            return Task::none();
        }
        Task::perform(
            async move {
                receive
                    .await
                    .unwrap_or_else(|_| Err("Worker de histórico terminou sem resposta".into()))
            },
            move |result| Message::HistoryDone(id, result),
        )
    }
    fn open_project(&mut self, create: bool) -> Task<Message> {
        if !self.project_available() {
            return Task::none();
        }
        if create && !std::path::Path::new(&self.project_parent).is_absolute() {
            self.workspace_error = Some("Informe o caminho absoluto da pasta de destino.".into());
            return Task::none();
        }
        self.busy = true;
        self.selected = false;
        self.result = false;
        self.generation += 1;
        let generation = self.generation;
        let flag = Arc::new(AtomicBool::new(false));
        self.project_request = Some(flag.clone());
        self.workspace_error = None;
        self.status = if create {
            "Criando a pasta vazia…"
        } else {
            "Validando o diretório do projeto…"
        }
        .into();
        let path = self.path.clone();
        let parent = self.project_parent.clone();
        let name = self.project_name.clone();
        let controller = self.controller.clone();
        let (send, receive) = iced::futures::channel::oneshot::channel();
        let spawn = std::thread::Builder::new()
            .name("ox-open-project".into())
            .spawn(move || {
                let mut outcome = OpenOutcome {
                    result: Err("Abertura cancelada".into()),
                    canonical: None,
                    history: None,
                    created: None,
                };
                let result = (|| {
                    if flag.load(Ordering::Relaxed) {
                        return Err("Abertura cancelada".into());
                    }
                    let path = if create {
                        let destination =
                            project_store::create_project(std::path::Path::new(&parent), &name)?;
                        outcome.created = Some(destination.clone());
                        destination
                    } else {
                        PathBuf::from(path)
                    };
                    if flag.load(Ordering::Relaxed) {
                        return Err("Abertura cancelada".into());
                    }
                    let path = path.canonicalize().map_err(|e| e.to_string())?;
                    if path.to_str().is_none() {
                        return Err("O caminho real não é UTF-8; escolha outra pasta".into());
                    }
                    let mut controller = controller
                        .lock()
                        .map_err(|_| "Estado do projeto indisponível".to_owned())?;
                    let status = controller.select(&path).map_err(|e| e.to_string())?;
                    let canonical = controller
                        .workspace
                        .clone()
                        .ok_or_else(|| "Diretório validado ausente".to_owned())?;
                    drop(controller);
                    outcome.history = Some(
                        project_store::history_path()
                            .and_then(|p| project_store::RecentStore::new(p).record(&canonical)),
                    );
                    outcome.canonical = Some(canonical);
                    Ok(status)
                })();
                outcome.result = result;
                let _ = send.send(outcome);
            });
        if let Err(error) = spawn {
            self.busy = false;
            self.project_request = None;
            self.workspace_error = Some(format!("Não foi possível iniciar a abertura: {error}"));
            return Task::none();
        }
        Task::perform(
            async move {
                receive.await.unwrap_or_else(|_| OpenOutcome {result: Err("Worker terminou sem resposta; confira o destino antes de tentar criar novamente".into()), canonical: None, history: None, created: None})
            },
            move |result| Message::ProjectDone(generation, result),
        )
    }
    // Visual/tab order. Iced 0.14 buttons do not implement native keyboard focus.
    fn sidebar_max(&self) -> f32 {
        (self.width - 326.0).clamp(200.0, 420.0)
    }
    fn sidebar_width(&self) -> f32 {
        if self.navigation_open {
            self.navigation_width.clamp(200.0, self.sidebar_max())
        } else {
            52.0
        }
    }
    /// Sidebar destinations. Project entry, preferences and tool windows are
    /// reached through the menus, the project selector, the bottom dock and Ctrl+K.
    fn navigation_order() -> Vec<Surface> {
        ["PROJETO", "TRABALHO", "CAPACIDADES", "BANCADA"]
            .into_iter()
            .flat_map(|group| {
                Surface::ALL
                    .into_iter()
                    .filter(move |s| s.group() == group && Self::in_sidebar(*s))
            })
            .collect()
    }
    const fn in_sidebar(surface: Surface) -> bool {
        !matches!(
            surface,
            Surface::Start
                | Surface::NewProject
                | Surface::Settings
                | Surface::Appearance
                | Surface::Problems
                | Surface::Tests
                | Surface::Trace
                | Surface::Terminal
        )
    }
    fn reveal_navigation_focus(&self) -> Task<Message> {
        if self.entry() || self.command_open {
            return Task::none();
        }
        self.focus
            .filter(|id| (100..127).contains(id))
            .map_or_else(Task::none, |id| {
                iced::advanced::widget::operate(RevealControl {
                    scroller: "navigation",
                    target: iced::widget::Id::from(format!("navigation-control-{id}")),
                    bounds: None,
                    viewport: None,
                })
            })
    }
    fn focused_label(&self) -> Option<&str> {
        match self.focus? {
            272 => None,
            212 => Some("Recolher / expandir navegação · Ctrl+B"),
            213 => Some("Ir para… · Ctrl+K"),
            603 => Some("Projeto atual · abrir a Central de projetos"),
            644 => Some("Painel de ferramentas · Ctrl+J"),
            645 => Some("Ocultar painel de ferramentas"),
            id @ 600..=602 => chrome::Menu::ALL.get(id - 600).map(|m| m.label()),
            id @ 610..=639 => self.menu.and_then(|m| {
                self.menu_items(m)
                    .into_iter()
                    .find(|item| item.id == id)
                    .map(|item| item.label)
            }),
            id @ 640..=643 => dock::DOCK_TOOLS.get(id - 640).map(|s| s.title()),
            id @ 500..=553 if id % 2 == 1 => Some("Fechar aba"),
            id @ 500..=553 => Surface::ALL.get((id - 500) / 2).map(|s| s.title()),
            id => Surface::ALL
                .iter()
                .find(|s| s.id() == id)
                .map(|s| s.title()),
        }
    }
    fn controls(&self) -> Vec<(usize, Message)> {
        if let Some(menu) = self.menu {
            return self
                .menu_items(menu)
                .into_iter()
                .filter(|item| item.action.is_some())
                .map(|item| (item.id, Message::MenuItem(item.id)))
                .collect();
        }
        if self.command_open {
            let mut controls = vec![(300, Message::Activate), (301, Message::Escape)];
            controls.extend(
                self.command_matches()
                    .iter()
                    .map(|s| (s.id(), Message::Navigate(*s))),
            );
            return controls;
        }
        if matches!(self.surface, Surface::Settings | Surface::Appearance) {
            let mut controls: Vec<_> = Appearance::ALL
                .iter()
                .enumerate()
                .map(|(i, a)| (220 + i, Message::Appearance(*a)))
                .collect();
            controls.extend([
                (223, Message::Density(Density::Comfortable)),
                (224, Message::Density(Density::Compact)),
                (225, Message::BackSettings),
                (226, Message::SaveSettings),
            ]);
            return controls;
        }
        if self.entry() {
            return self.entry_controls();
        }
        let mut controls = vec![(212, Message::Navigation)];
        controls.extend(
            chrome::Menu::ALL
                .iter()
                .map(|m| (m.id(), Message::Menu(Some(*m)))),
        );
        controls.extend([
            (213, Message::Command),
            (603, Message::Navigate(Surface::Start)),
            (644, Message::Dock),
            (272, Message::Navigate(Surface::Settings)),
        ]);
        if self.busy {
            controls.push((214, Message::Cancel));
        }
        controls.extend(
            Self::navigation_order()
                .iter()
                .map(|s| (s.id(), Message::Navigate(*s))),
        );
        controls.extend(self.tab_controls());
        let workspace = matches!(
            self.surface,
            Surface::Start | Surface::Project | Surface::Tasks
        );
        if self.project_available() && workspace {
            controls.push((2, Message::Activate));
            if self.surface == Surface::Start && self.picker.is_none() {
                controls.push((273, Message::ChooseFolder));
            }
            controls.push((3, Message::Select));
            if self.selected && self.surface == Surface::Tasks {
                controls.extend([
                    (4, Message::Start("good")),
                    (5, Message::Start("bad")),
                    (6, Message::Start("failure")),
                    (7, Message::Start("hang")),
                ]);
            }
            if self.result && self.surface == Surface::Tasks {
                controls.extend([(9, Message::Verify), (10, Message::Refresh)]);
            }
        }
        if self.busy && self.surface == Surface::Tasks {
            controls.push((8, Message::Cancel));
        }
        controls.extend(self.surface_controls());
        controls.extend(self.dock_controls());
        controls
    }
    /// Controls owned by the active document, in rendered order.
    fn surface_controls(&self) -> Vec<(usize, Message)> {
        let mut controls = Vec::new();

        match self.surface {
            Surface::Start => {
                if self.selected && !self.closing {
                    controls.push((270, Message::Navigate(Surface::Tasks)));
                }
                controls.extend([
                    (271, Message::Navigate(Surface::Activity)),
                    (272, Message::Navigate(Surface::Appearance)),
                ]);
            }
            Surface::Appearance | Surface::Settings => {
                controls.extend(
                    Appearance::ALL
                        .iter()
                        .enumerate()
                        .map(|(i, a)| (220 + i, Message::Appearance(*a))),
                );
                controls.extend([
                    (223, Message::Density(Density::Comfortable)),
                    (224, Message::Density(Density::Compact)),
                ]);
            }
            Surface::Editor | Surface::Focus => {
                controls.extend((0..3).map(|i| (250 + i, Message::DemoDocument(i))));
                controls.extend((0..3).map(|i| (253 + i, Message::DemoDocument(i))));
            }
            Surface::NewTask => controls.push((230, Message::Activate)),
            Surface::Architecture => controls.extend([
                (240, Message::GraphMode(false)),
                (241, Message::GraphMode(true)),
            ]),
            _ => {}
        }
        controls
    }
    fn entry_controls(&self) -> Vec<(usize, Message)> {
        let mut controls = vec![(272, Message::Navigate(Surface::Settings))];
        if self.project_available() {
            if self.surface == Surface::NewProject {
                controls.extend([
                    (290, Message::Activate),
                    (291, Message::Activate),
                    (292, Message::ChooseFolder),
                    (293, Message::CreateProject),
                ]);
            } else {
                controls.extend([
                    (274, Message::Navigate(Surface::NewProject)),
                    (273, Message::ChooseFolder),
                ]);
                if self.manual_path {
                    controls.extend([(2, Message::Activate), (3, Message::Select)]);
                }
                if self.history_error.is_some() {
                    controls.extend([
                        (280, Message::History(HistoryAction::Load)),
                        (281, Message::ResetConfirmation(true)),
                    ]);
                    if self.reset_confirmation {
                        controls.extend([
                            (282, Message::History(HistoryAction::Reset)),
                            (283, Message::ResetConfirmation(false)),
                        ]);
                    }
                }
                if !self.recent.is_empty() {
                    controls.push((284, Message::Activate));
                }
                for (i, path) in self.visible_recent() {
                    controls.extend([
                        (400 + i * 2, Message::OpenRecent(path.clone())),
                        (
                            401 + i * 2,
                            Message::History(HistoryAction::Remove(path.clone())),
                        ),
                    ]);
                }
            }
        }
        if self.surface == Surface::NewProject && !self.busy && !self.closing {
            controls.push((294, Message::Navigate(Surface::Start)));
        }
        if self.surface == Surface::Start && self.selected && !self.closing {
            let position = controls
                .iter()
                .position(|(id, _)| *id == 2 || *id >= 280)
                .unwrap_or(controls.len());
            controls.insert(position, (270, Message::Navigate(Surface::Tasks)));
        }
        if self.surface == Surface::Start {
            let position = controls
                .iter()
                .position(|(id, _)| *id == 270 || *id >= 280)
                .unwrap_or(controls.len());
            controls.insert(position, (275, Message::Navigate(Surface::Tools)));
        }
        controls
    }
    fn control<'a>(
        &self,
        index: usize,
        label: &'a str,
        message: Option<Message>,
    ) -> iced::widget::Button<'a, Message> {
        self.styled_control(index, label, message, ButtonRole::Secondary)
    }
    fn styled_control<'a>(
        &self,
        index: usize,
        label: &'a str,
        message: Option<Message>,
        role: ButtonRole,
    ) -> iced::widget::Button<'a, Message> {
        let focused = self.focus == Some(index);
        let p = self.appearance.palette();
        let kind = match index {
            273 | 292 => Some(icons::Kind::Folder),
            274 => Some(icons::Kind::Plus),
            272 => Some(icons::Kind::Settings),
            212 => Some(icons::Kind::Panels),
            213 => Some(icons::Kind::Search),
            276 => Some(icons::Kind::Repository),
            270 => Some(icons::Kind::Activity),
            _ => None,
        };
        let mut content = iced::widget::row![]
            .spacing(8)
            .align_y(iced::Alignment::Center);
        if let Some(kind) = kind {
            content = content.push(icons::icon(kind));
        }
        content = content.push(iced::widget::text(label).size(14));
        button(content)
            .padding(self.density.control_padding())
            .on_press_maybe(message)
            .style(move |_, status| crate::design::button_style(p, role, focused, status))
    }
    fn icon_control<'a>(
        &self,
        index: usize,
        label: &'a str,
        kind: icons::Kind,
        message: Message,
    ) -> Element<'a, Message> {
        let p = self.appearance.palette();
        let focused = self.focus == Some(index);
        let control = iced::widget::tooltip(
            button(
                iced::widget::container(icons::icon(kind))
                    .center_x(32)
                    .center_y(32),
            )
            .padding(0)
            .on_press(message)
            .style(move |_, status| {
                crate::design::button_style(
                    p,
                    if index == 645 {
                        ButtonRole::Tab(false)
                    } else {
                        ButtonRole::Chrome
                    },
                    focused,
                    status,
                )
            }),
            iced::widget::container(iced::widget::text(label).size(13))
                .padding(8)
                .style(move |_| {
                    crate::design::panel(p.surface_base, p.text_primary, p.border_interactive)
                }),
            iced::widget::tooltip::Position::Bottom,
        )
        .gap(6)
        .into();
        hint::focus(
            control,
            iced::widget::container(iced::widget::text(label).size(13))
                .padding(8)
                .style(move |_| {
                    crate::design::panel(p.surface_base, p.text_primary, p.border_interactive)
                })
                .into(),
            focused && index != 272,
        )
    }
    fn command_matches(&self) -> Vec<Surface> {
        let query = self.command.trim().to_lowercase();
        Surface::ALL
            .iter()
            .copied()
            .filter(|s| {
                s.title().to_lowercase().contains(&query) || s.code().to_lowercase() == query
            })
            .collect()
    }
    fn restore_visible_focus(&mut self) {
        if self
            .focus
            .is_some_and(|id| !self.controls().iter().any(|(i, _)| *i == id))
        {
            self.focus = if matches!(self.surface, Surface::Settings | Surface::Appearance) {
                None
            } else {
                Some(if self.entry() { 272 } else { 212 })
            };
        }
    }
    fn cancel_picker(&self) {
        if let Some(picker) = &self.picker {
            picker.cancel.store(true, Ordering::Relaxed);
        }
    }
    fn choose_folder(&mut self) -> Task<Message> {
        if !self.entry() || !self.project_available() {
            return Task::none();
        }
        self.picker_parent = self.surface == Surface::NewProject;
        self.picker_serial += 1;
        let id = self.picker_serial;
        let cancel = Arc::new(AtomicBool::new(false));
        let flag = cancel.clone();
        let (send, receive) = iced::futures::channel::oneshot::channel();
        let spawn = std::thread::Builder::new()
            .name("ox-folder-picker".into())
            .spawn(move || {
                let result = folder_picker::choose(&flag);
                let _ = send.send(result);
            });
        if let Err(error) = spawn {
            self.picker_error = Some(format!(
                "Não foi possível abrir o seletor: {error}. Digite o caminho manualmente."
            ));
            if !self.picker_parent {
                self.manual_path = true;
            }
            let id = if self.picker_parent { 291 } else { 2 };
            self.focus = Some(id);
            return Task::batch([
                iced::widget::operation::focus(if self.picker_parent {
                    "project-parent"
                } else {
                    "workspace"
                }),
                self.reveal(id),
            ]);
        }
        self.picker = Some(folder_picker::Request {
            id,
            generation: self.generation,
            cancel,
        });
        // Opening/cancelling a dialog never modifies domain or draft state.
        Task::perform(
            async move {
                receive.await.unwrap_or_else(|_| {
                    Err("O seletor terminou sem uma resposta. Digite o caminho manualmente.".into())
                })
            },
            move |result| Message::FolderChosen(id, result),
        )
    }
    fn launch(&mut self, action: Action, mode: &'static str) -> Task<Message> {
        if self.busy || self.closing {
            return Task::none();
        }
        self.cancel_picker();
        self.busy = true;
        self.generation += 1;
        let generation = self.generation;
        self.cancel.store(false, Ordering::Relaxed);
        self.status = match action {
            Action::Start => "Em execução: tarefa controlada; prazo do subprocesso de 10 segundos. Cancelar solicita término observado.",
            Action::Verify => "Verificando a tentativa atual; prazo do subprocesso de 10 segundos…",
            Action::Refresh => "Observando os inputs atuais…",
        }.into();
        let controller = self.controller.clone();
        let cancel = self.cancel.clone();
        let (send, receive) = iced::futures::channel::oneshot::channel();
        let spawn = std::thread::Builder::new()
            .name("ox-local-task".into())
            .spawn(move || {
                let result = controller
                    .lock()
                    .map_err(|_| "Worker state unavailable".to_owned())
                    .and_then(|mut c| {
                        match action {
                            Action::Start => c.execute(mode, cancel),
                            Action::Verify => c.verify_cancellable(true, &cancel),
                            Action::Refresh => c.verify(false),
                        }
                        .map_err(|e| e.to_string())
                    });
                let _ = send.send(result);
            });
        if let Err(e) = spawn {
            self.busy = false;
            self.status = e.to_string();
            return Task::none();
        }
        Task::perform(
            async move {
                receive
                    .await
                    .unwrap_or_else(|_| Err("Worker terminated unexpectedly".into()))
            },
            move |result| Message::Done(generation, action, result),
        )
    }
    #[expect(
        clippy::too_many_lines,
        reason = "Exhaustive UI message dispatch delegates domain work to Controller"
    )]
    fn update(&mut self, message: Message) -> Task<Message> {
        match message {
            Message::Navigate(surface) if dock::DOCK_TOOLS.contains(&surface) => {
                // Tool windows dock below the active document instead of replacing it.
                self.menu = None;
                if self.entry() || matches!(self.surface, Surface::Settings | Surface::Appearance) {
                    let _ = self.update(Message::Navigate(Surface::Project));
                }
                self.dock_open = true;
                self.dock_tool = surface;
                if self.command_open {
                    self.command_open = false;
                    self.command.clear();
                    self.focus = Some(213);
                }
                self.restore_visible_focus();
            }
            Message::Navigate(surface) => {
                self.menu = None;
                self.cancel_picker();
                if let Some(flag) = &self.project_request {
                    flag.store(true, Ordering::Relaxed);
                }
                if surface == Surface::NewProject {
                    self.workspace_error = None;
                    self.picker_error = None;
                }
                if surface == Surface::Start && self.surface == Surface::NewProject {
                    self.workspace_error = None;
                    self.picker_error = None;
                }

                let settings = |s| matches!(s, Surface::Settings | Surface::Appearance);
                if settings(surface) && !settings(self.surface) {
                    self.settings_origin = Some((self.appearance, self.density, self.surface));
                } else if !settings(surface)
                    && let Some((appearance, density, _)) = self.settings_origin.take()
                {
                    self.appearance = appearance;
                    self.density = density;
                }
                // Keep the document being left as a tab even if it was reached
                // without one (initial state or programmatic selection).
                self.open_tab(self.surface);
                self.surface = surface;
                self.open_tab(surface);
                if self.command_open {
                    self.command_open = false;
                    self.command.clear();
                    self.focus = Some(213);
                }
                self.navigation_drag = false;
                if surface == Surface::Focus {
                    self.navigation_open = false;
                }
                if self.entry() {
                    self.focus = Some(if surface == Surface::NewProject {
                        290
                    } else {
                        273
                    });
                }
                self.restore_visible_focus();
                if surface == Surface::NewProject {
                    return Task::batch([
                        iced::widget::operation::focus("project-name"),
                        iced::widget::operation::snap_to(
                            "main",
                            iced::widget::scrollable::RelativeOffset::START,
                        ),
                    ]);
                }
                return iced::widget::operation::snap_to(
                    "main",
                    iced::widget::scrollable::RelativeOffset::START,
                );
            }
            Message::SaveSettings | Message::BackSettings => {
                if let Some((appearance, density, origin)) = self.settings_origin.take() {
                    if matches!(message, Message::BackSettings) {
                        self.appearance = appearance;
                        self.density = density;
                    }
                    return self.update(Message::Navigate(origin));
                }
            }
            Message::Appearance(appearance) => self.appearance = appearance,
            Message::CycleAppearance => self.appearance = self.appearance.next(),
            Message::Density(density) => self.density = density,
            Message::CycleDensity => self.density = self.density.next(),
            Message::Navigation => {
                self.cancel_picker();
                self.navigation_drag = false;
                self.navigation_open = !self.navigation_open;
                self.restore_visible_focus();
                return self.reveal_navigation_focus();
            }
            Message::Resize(width) => {
                self.width = width;
                self.navigation_drag = false;
                self.restore_visible_focus();
                return self.reveal_navigation_focus();
            }
            Message::SidebarStart(offset) => {
                self.navigation_grab = if offset.is_finite() {
                    offset.clamp(0.0, 6.0)
                } else {
                    0.0
                };
                self.navigation_drag = self.navigation_open && !self.entry() && !self.command_open;
            }
            Message::SidebarMove(x) => {
                if self.navigation_drag && x.is_finite() {
                    self.navigation_width =
                        (x - self.navigation_grab).clamp(200.0, self.sidebar_max());
                }
            }
            Message::SidebarEnd => self.navigation_drag = false,
            Message::SidebarAdjust(delta) => {
                self.navigation_drag = false;
                self.navigation_open = true;
                self.navigation_width = (self.navigation_width.clamp(200.0, self.sidebar_max())
                    + delta)
                    .clamp(200.0, self.sidebar_max());
                self.restore_visible_focus();
                return self.reveal_navigation_focus();
            }
            Message::Command => {
                self.menu = None;
                self.navigation_drag = false;
                self.cancel_picker();
                self.return_focus = self.focus;
                self.command_open = true;
                self.command.clear();
                self.command_selection = 0;
                self.focus = Some(300);
                return iced::widget::operation::focus("command");
            }
            Message::CommandInput(query) => {
                self.command = query;
                self.command_selection = 0;
            }
            Message::CommandGo => {
                if let Some(surface) = self.command_matches().get(self.command_selection).copied() {
                    return self.update(Message::Navigate(surface));
                }
            }
            Message::CommandMove(backwards) if self.menu.is_some() => {
                let controls = self.controls();
                if !controls.is_empty() {
                    let position = controls.iter().position(|(id, _)| Some(*id) == self.focus);
                    let next = match (position, backwards) {
                        (Some(p), false) => (p + 1) % controls.len(),
                        (Some(p), true) => (p + controls.len() - 1) % controls.len(),
                        (None, false) => 0,
                        (None, true) => controls.len() - 1,
                    };
                    self.focus = Some(controls[next].0);
                }
            }
            Message::CommandMove(backwards) if self.command_open => {
                let count = self.command_matches().len();
                if count > 0 {
                    self.command_selection = if backwards {
                        (self.command_selection + count - 1) % count
                    } else {
                        (self.command_selection + 1) % count
                    };
                }
            }
            Message::Escape => {
                self.navigation_drag = false;
                if self.menu.is_some() {
                    return self.toggle_menu(None);
                }
                if self.command_open {
                    self.command_open = false;
                    self.focus = self.return_focus.take();
                    self.restore_visible_focus();
                } else if matches!(self.surface, Surface::Settings | Surface::Appearance) {
                    return self.update(Message::BackSettings);
                } else if self.surface == Surface::NewProject && !self.busy {
                    return self.update(Message::Navigate(Surface::Start));
                }
            }
            Message::ProjectName(name) if self.project_available() => {
                self.project_name = name;
                self.workspace_error = None;
                self.focus = Some(290);
            }
            Message::ProjectParent(parent) if !self.busy && !self.closing => {
                self.cancel_picker();
                self.project_parent = parent;
                self.workspace_error = None;
                self.focus = Some(291);
            }
            Message::CreateProject if self.surface == Surface::NewProject => {
                return self.open_project(true);
            }
            Message::OpenRecent(path)
                if self.project_available() && self.surface == Surface::Start =>
            {
                self.path = path.to_str().expect("history accepts only UTF-8").into();
                self.selected = false;
                self.result = false;
                return self.open_project(false);
            }
            Message::History(action) => return self.history(action),
            Message::ResetConfirmation(confirm) if !self.history_busy => {
                self.reset_confirmation = confirm;
            }
            Message::HistoryDone(id, result) if self.history_busy && id == self.history_serial => {
                self.history_busy = false;
                match result {
                    Ok(paths) => {
                        self.recent = paths;
                        self.history_error = None;
                    }
                    Err(error) => self.history_error = Some(error),
                }
                self.restore_visible_focus();
                if self.closing && !self.busy && self.picker.is_none() {
                    return iced::exit();
                }
            }
            Message::ProjectDone(id, outcome)
                if self.busy && id == self.generation && self.project_request.is_some() =>
            {
                self.busy = false;
                let canceled = self
                    .project_request
                    .take()
                    .expect("checked request")
                    .load(Ordering::Relaxed);
                if let Some(history) = outcome.history {
                    match history {
                        Ok(paths) => {
                            self.recent = paths;
                            self.history_error = None;
                        }
                        Err(error) => {
                            self.history_error = Some(format!(
                                "O projeto foi aberto, mas o histórico não foi salvo: {error}"
                            ));
                        }
                    }
                }
                self.selected = outcome.result.is_ok() && !canceled;
                if self.selected {
                    self.path = outcome
                        .canonical
                        .expect("successful open has canonical path")
                        .to_str()
                        .expect("canonical UTF-8 validated by store or selection")
                        .into();
                    self.surface = Surface::Tasks;
                    self.open_tab(Surface::Tasks);
                    self.workspace_error = None;
                } else {
                    let mut error = outcome
                        .result
                        .as_ref()
                        .err()
                        .cloned()
                        .unwrap_or_else(|| "Abertura cancelada".into());
                    if let Some(created) = outcome.created {
                        let _ = write!(
                            error,
                            ". A pasta foi criada e preservada em {}. Abra-a como pasta existente; não repita a criação.",
                            created.display()
                        );
                    }
                    self.workspace_error = Some(error);
                }
                self.status = outcome
                    .result
                    .unwrap_or_else(|e| format!("UNVERIFIED — {e}"));
                self.restore_visible_focus();
                if self.closing && self.picker.is_none() && !self.history_busy {
                    return iced::exit();
                }
            }
            Message::Draft(draft) => self.draft = draft,
            Message::DemoDocument(index) if index < 3 => self.demo_document = index,
            Message::Menu(menu) => return self.toggle_menu(menu),
            Message::MenuItem(id) => return self.run_menu_item(id),
            Message::CloseTab(surface) => return self.close_tab(surface),
            Message::Dock => {
                self.menu = None;
                self.dock_open = !self.dock_open;
                self.restore_visible_focus();
            }
            Message::OpenFolder => {
                let navigate = self.update(Message::Navigate(Surface::Start));
                return Task::batch([navigate, self.choose_folder()]);
            }
            Message::RecentFilter(filter) => {
                self.recent_filter = filter;
                self.focus = Some(284);
            }
            Message::GraphMode(exploratory) => self.graph_exploratory = exploratory,
            Message::Scroll(y) => {
                return iced::widget::operation::scroll_by(
                    "main",
                    iced::widget::scrollable::AbsoluteOffset { x: 0.0, y },
                );
            }
            Message::Focus(backwards) => {
                let controls = self.controls();
                let position = controls.iter().position(|(id, _)| Some(*id) == self.focus);
                let next = match (position, backwards) {
                    (Some(p), false) => (p + 1) % controls.len(),
                    (Some(p), true) => (p + controls.len() - 1) % controls.len(),
                    (None, false) => 0,
                    (None, true) => controls.len() - 1,
                };
                self.focus = Some(controls[next].0);
                let target = match self.focus {
                    Some(2) => "workspace",
                    Some(230) => "task-draft",
                    Some(300) => "command",
                    Some(290) => "project-name",
                    Some(291) => "project-parent",
                    Some(284) => "recent-filter",
                    _ => "no-text-input",
                };
                let focus = iced::widget::operation::focus(target);
                if self.entry() || matches!(self.surface, Surface::Settings | Surface::Appearance) {
                    return Task::batch([focus, self.reveal(controls[next].0)]);
                }
                if self.surface == Surface::Start
                    && self
                        .focus
                        .is_some_and(|id| matches!(id, 2 | 3 | 273 | 270..=272))
                {
                    return Task::batch([
                        focus,
                        iced::widget::operation::snap_to(
                            "main",
                            if self.focus.is_some_and(|id| (270..=272).contains(&id)) {
                                iced::widget::scrollable::RelativeOffset::END
                            } else {
                                iced::widget::scrollable::RelativeOffset::START
                            },
                        ),
                    ]);
                }
                if self.focus.is_some_and(|id| (100..127).contains(&id)) {
                    return Task::batch([focus, self.reveal_navigation_focus()]);
                }
                return focus;
            }
            Message::InputFocused(id) => {
                // Mouse focus and explicit non-submitting Enter must agree with
                // the same traversal order used by keyboard button activation.
                if self.controls().iter().any(|(control, _)| *control == id) {
                    self.focus = Some(id);
                }
            }
            Message::Activate => {
                if let Some((_, action)) = self.controls().into_iter().find(|(id, _)| {
                    Some(*id) == self.focus && ![2, 230, 284, 290, 291, 300].contains(id)
                }) {
                    return self.update(action);
                }
            }
            Message::Toggle => self.details = !self.details,
            Message::ChooseFolder => return self.choose_folder(),
            Message::FolderChosen(id, result) => {
                if self.picker.as_ref().is_none_or(|p| p.id != id) {
                    return Task::none();
                }
                let picker = self.picker.take().expect("matching request");
                let current = !picker.cancel.load(Ordering::Relaxed)
                    && picker.generation == self.generation
                    && self.surface
                        == if self.picker_parent {
                            Surface::NewProject
                        } else {
                            Surface::Start
                        }
                    && !self.busy
                    && !self.closing;
                if self.closing && !self.busy {
                    return iced::exit();
                }
                if !current {
                    return Task::none();
                }
                match result {
                    Ok(Some(path)) if self.picker_parent => {
                        self.project_parent = path;
                        self.focus = Some(293);
                        return Task::batch([
                            iced::widget::operation::focus("no-text-input"),
                            self.reveal(293),
                        ]);
                    }
                    Ok(Some(path)) => {
                        let _ = self.update(Message::Path(path));
                        return self.update(Message::Select);
                    }
                    Ok(None) => {}
                    Err(error) => {
                        self.picker_error = Some(error);
                        if !self.picker_parent {
                            self.manual_path = true;
                            self.focus = Some(2);
                            return Task::batch([
                                iced::widget::operation::focus("workspace"),
                                self.reveal(2),
                            ]);
                        }
                    }
                }
                let id = if self.picker_parent { 291 } else { 273 };
                self.focus = Some(id);
                return Task::batch([
                    iced::widget::operation::focus(if self.picker_parent {
                        "project-parent"
                    } else {
                        "no-text-input"
                    }),
                    self.reveal(id),
                ]);
            }
            Message::Path(path) if !self.busy && !self.closing => {
                self.cancel_picker();
                self.picker_error = None;
                self.generation += 1;
                self.path = path;
                self.focus = Some(2);
                self.selected = false;
                self.workspace_error = None;
                self.result = false;
                self.status = "UNVERIFIED — valide o diretório do projeto".into();
            }
            Message::Select if self.project_available() => {
                self.cancel_picker();
                self.selected = false;
                self.workspace_error = None;
                self.result = false;
                return self.open_project(false);
            }
            Message::Start(mode) if self.selected && !self.busy => {
                self.result = false;
                return self.launch(Action::Start, mode);
            }
            Message::Verify if self.result => return self.launch(Action::Verify, ""),
            Message::Refresh if self.result => return self.launch(Action::Refresh, ""),
            Message::Cancel if self.busy => {
                self.cancel.store(true, Ordering::Relaxed);
                if let Some(flag) = &self.project_request {
                    flag.store(true, Ordering::Relaxed);
                }
                self.status =
                    "Cancelamento solicitado; aguardando o término observado do processo supervisionado."
                        .into();
            }
            Message::Close => {
                self.cancel_picker();
                self.closing = true;
                self.cancel.store(true, Ordering::Relaxed);
                if let Some(flag) = &self.project_request {
                    flag.store(true, Ordering::Relaxed);
                }
                if !self.busy && !self.history_busy && self.picker.is_none() {
                    return iced::exit();
                }
                self.status = "Encerrando: aguardando o término do trabalho supervisionado…".into();
            }
            Message::Done(g, action, result) if g == self.generation && self.busy => {
                self.busy = false;
                if matches!(action, Action::Start) {
                    self.result = result.is_ok();
                }
                self.status = result.unwrap_or_else(|e| format!("UNVERIFIED — {e}"));
                self.restore_visible_focus();
                if self.closing && self.picker.is_none() {
                    return iced::exit();
                }
            }
            _ => {}
        }
        Task::none()
    }
}
fn map_event(event: iced::Event, status: iced::event::Status, navigation: bool) -> Option<Message> {
    if let iced::Event::Window(iced::window::Event::Resized(size)) = &event {
        return Some(Message::Resize(size.width));
    }
    match &event {
        iced::Event::Mouse(
            iced::mouse::Event::ButtonReleased(iced::mouse::Button::Left)
            | iced::mouse::Event::CursorLeft,
        )
        | iced::Event::Window(iced::window::Event::Unfocused) => {
            return Some(Message::SidebarEnd);
        }
        _ => {}
    }
    if let iced::Event::Keyboard(iced::keyboard::Event::KeyPressed { key, modifiers, .. }) = event {
        use iced::keyboard::{Key, key::Named};
        return match key {
            Key::Character(ref ch)
                if navigation
                    && status == iced::event::Status::Ignored
                    && modifiers.control()
                    && ch.eq_ignore_ascii_case("k") =>
            {
                Some(Message::Command)
            }
            Key::Named(Named::ArrowUp) => Some(Message::CommandMove(true)),
            Key::Named(Named::ArrowDown) => Some(Message::CommandMove(false)),
            Key::Named(Named::Escape) => Some(Message::Escape),
            Key::Character(ref ch)
                if navigation
                    && status == iced::event::Status::Ignored
                    && modifiers.control()
                    && ch.eq_ignore_ascii_case("b") =>
            {
                Some(Message::Navigation)
            }
            Key::Character(ref ch)
                if navigation
                    && status == iced::event::Status::Ignored
                    && modifiers.control()
                    && ch.eq_ignore_ascii_case("j") =>
            {
                Some(Message::Dock)
            }
            Key::Named(Named::ArrowLeft)
                if navigation
                    && status == iced::event::Status::Ignored
                    && modifiers.control()
                    && modifiers.alt() =>
            {
                Some(Message::SidebarAdjust(-24.0))
            }
            Key::Named(Named::ArrowRight)
                if navigation
                    && status == iced::event::Status::Ignored
                    && modifiers.control()
                    && modifiers.alt() =>
            {
                Some(Message::SidebarAdjust(24.0))
            }
            Key::Named(Named::Tab) => Some(Message::Focus(modifiers.shift())),
            Key::Named(Named::Enter | Named::Space) if status == iced::event::Status::Ignored => {
                Some(Message::Activate)
            }
            Key::Named(Named::PageDown) if status == iced::event::Status::Ignored => {
                Some(Message::Scroll(240.0))
            }
            Key::Named(Named::PageUp) if status == iced::event::Status::Ignored => {
                Some(Message::Scroll(-240.0))
            }
            _ => None,
        };
    }
    None
}

fn map_drag(event: iced::Event) -> Option<Message> {
    match event {
        iced::Event::Mouse(iced::mouse::Event::CursorMoved { position }) => {
            Some(Message::SidebarMove(position.x))
        }
        _ => None,
    }
}

/// # Errors
/// Returns the Iced initialization or event-loop error when the native desktop cannot run.
pub fn run() -> Result {
    iced::application(Desktop::initialize, Desktop::update, Desktop::view)
        .title(Desktop::window_title)
        .window_size((1280.0, 820.0))
        .default_font(crate::design::UI_FONT)
        .font(include_bytes!("../assets/fonts/IBMPlexSans-Regular.ttf").as_slice())
        .font(include_bytes!("../assets/fonts/IBMPlexSans-SemiBold.ttf").as_slice())
        .font(include_bytes!("../assets/fonts/IBMPlexMono-Regular.ttf").as_slice())
        .theme(|s: &Desktop| s.appearance.theme())
        .exit_on_close_request(false)
        .subscription(|s: &Desktop| {
            iced::Subscription::batch([
                iced::window::close_requests().map(|_| Message::Close),
                if s.entry() || matches!(s.surface, Surface::Settings | Surface::Appearance) {
                    iced::event::listen_with(|event, status, _| map_event(event, status, false))
                } else {
                    iced::event::listen_with(|event, status, _| map_event(event, status, true))
                },
                if s.navigation_drag {
                    iced::event::listen_with(|event, _, _| map_drag(event))
                } else {
                    iced::Subscription::none()
                },
            ])
        })
        .run()
}

#[cfg(test)]
mod tests {
    use super::*;
    fn pending_ui() -> Desktop {
        Desktop {
            picker: Some(folder_picker::Request {
                id: 5,
                generation: 8,
                cancel: Arc::new(AtomicBool::new(false)),
            }),
            picker_serial: 5,
            generation: 8,
            selected: true,
            result: true,
            path: "/original".into(),
            status: "prior verification".into(),
            workspace_error: Some("prior error".into()),
            navigation_open: false,
            ..Desktop::default()
        }
    }
    #[test]
    fn preferences_save_and_back_restore_the_origin_without_domain_effects() {
        let mut ui = Desktop::default();
        let _ = ui.update(Message::Navigate(Surface::Settings));
        assert_eq!(
            ui.controls().iter().map(|(id, _)| *id).collect::<Vec<_>>(),
            vec![220, 221, 222, 223, 224, 225, 226]
        );
        let _ = ui.update(Message::Appearance(Appearance::Dark));
        let _ = ui.update(Message::Density(Density::Compact));
        let _ = ui.update(Message::BackSettings);
        assert_eq!(ui.surface, Surface::Start);
        assert_eq!(ui.appearance, Appearance::Light);
        assert_eq!(ui.density, Density::Comfortable);
        let _ = ui.update(Message::Navigate(Surface::Settings));
        let _ = ui.update(Message::Appearance(Appearance::Dark));
        let _ = ui.update(Message::SaveSettings);
        assert_eq!(ui.surface, Surface::Start);
        assert_eq!(ui.appearance, Appearance::Dark);
        let _ = ui.update(Message::Navigate(Surface::Appearance));
        let _ = ui.update(Message::Appearance(Appearance::HighContrast));
        let _ = ui.update(Message::Escape);
        assert_eq!(ui.appearance, Appearance::Dark);
        assert_eq!(ui.surface, Surface::Start);
        assert_eq!(ui.controller.lock().unwrap().attempt, 0);
    }

    #[test]
    fn sidebar_drag_is_bounded_and_stops_without_domain_effects() {
        let mut ui = Desktop {
            surface: Surface::Editor,
            ..Desktop::default()
        };
        let _ = ui.update(Message::SidebarMove(400.0));
        assert_eq!(ui.sidebar_width(), 256.0);
        let _ = ui.update(Message::SidebarStart(3.0));
        let _ = ui.update(Message::SidebarMove(259.0));
        assert_eq!(ui.sidebar_width(), 256.0);
        let _ = ui.update(Message::SidebarMove(339.0));
        assert_eq!(ui.sidebar_width(), 336.0);
        let _ = ui.update(Message::SidebarEnd);
        let _ = ui.update(Message::SidebarStart(0.0));
        assert!(ui.navigation_drag);
        let _ = ui.update(Message::SidebarMove(900.0));
        assert_eq!(ui.sidebar_width(), 420.0);
        let _ = ui.update(Message::SidebarMove(-50.0));
        assert_eq!(ui.sidebar_width(), 200.0);
        let _ = ui.update(Message::SidebarMove(f32::NAN));
        assert_eq!(ui.sidebar_width(), 200.0);
        let _ = ui.update(Message::SidebarEnd);
        let _ = ui.update(Message::SidebarMove(320.0));
        assert_eq!(ui.sidebar_width(), 200.0);
        let _ = ui.update(Message::SidebarStart(0.0));
        let _ = ui.update(Message::Resize(640.0));
        assert!(!ui.navigation_drag);
        let _ = ui.update(Message::SidebarStart(0.0));
        let _ = ui.update(Message::Escape);
        assert!(!ui.navigation_drag);
        assert_eq!(ui.generation, 0);
        assert!(!ui.busy);
        assert!(!ui.selected);
    }
    #[test]
    fn rail_restores_width_and_keeps_navigation_keyboard_accessible() {
        let mut ui = Desktop {
            surface: Surface::Editor,
            navigation_width: 340.0,
            ..Desktop::default()
        };
        let _ = ui.update(Message::Navigation);
        assert_eq!(ui.sidebar_width(), 52.0);
        assert!(
            Desktop::navigation_order()
                .iter()
                .all(|s| ui.controls().iter().any(|(id, _)| *id == s.id()))
        );
        let _ = ui.update(Message::Navigation);
        assert_eq!(ui.sidebar_width(), 340.0);
        let _ = ui.update(Message::Resize(640.0));
        assert_eq!(ui.sidebar_width(), 314.0);
        let _ = ui.update(Message::Resize(1366.0));
        assert_eq!(ui.sidebar_width(), 340.0);
        let _ = ui.update(Message::Navigation);
        let _ = ui.update(Message::SidebarAdjust(-24.0));
        assert!(ui.navigation_open);
        assert_eq!(ui.sidebar_width(), 316.0);
        ui.focus = Some(Surface::Skills.id());
        let _ = ui.update(Message::Navigation);
        assert_eq!(ui.focus, Some(Surface::Skills.id()));
    }
    #[test]
    fn focused_navigation_reveals_after_rail_width_and_window_changes() {
        let mut ui = Desktop {
            surface: Surface::Editor,
            focus: Some(Surface::Skills.id()),
            ..Desktop::default()
        };
        for change in [
            Message::Navigation,
            Message::Navigation,
            Message::SidebarAdjust(-24.0),
            Message::Resize(640.0),
        ] {
            let task = ui.update(change);
            assert!(
                task.units() > 0,
                "geometry changes must schedule actual-bounds reveal"
            );
            assert_eq!(ui.focus, Some(Surface::Skills.id()));
        }
        ui.focus = Some(212);
        assert_eq!(ui.update(Message::Navigation).units(), 0);
        ui.command_open = true;
        ui.focus = Some(Surface::Skills.id());
        assert_eq!(ui.update(Message::Resize(1366.0)).units(), 0);
    }
    #[test]
    fn navigation_groups_are_contiguous_without_changing_destination_ids() {
        let ordered = Desktop::navigation_order();
        let excluded: Vec<_> = Surface::ALL
            .into_iter()
            .filter(|s| !ordered.contains(s))
            .collect();
        assert_eq!(
            excluded,
            [
                Surface::Start,
                Surface::NewProject,
                Surface::Settings,
                Surface::Appearance,
                Surface::Problems,
                Surface::Tests,
                Surface::Trace,
                Surface::Terminal,
            ]
        );
        let mut seen = std::collections::HashSet::new();
        let mut group = "";
        for s in ordered {
            assert_eq!(Surface::ALL[s.id() - 100], s);
            if s.group() != group {
                assert!(seen.insert(s.group()));
                group = s.group();
            }
        }
    }
    #[test]
    fn folder_cancel_preserves_workspace_evidence_and_rejects_duplicates() {
        let mut ui = pending_ui();
        let _ = ui.update(Message::ChooseFolder);
        assert_eq!(ui.picker_serial, 5);
        let _ = ui.update(Message::FolderChosen(4, Ok(Some("/late".into()))));
        assert!(ui.picker.is_some());
        let _ = ui.update(Message::FolderChosen(5, Ok(None)));
        assert!(ui.picker.is_none());
        assert_eq!(ui.path, "/original");
        assert!(ui.selected);
        assert!(ui.result);
        assert_eq!(ui.status, "prior verification");
        assert_eq!(ui.workspace_error.as_deref(), Some("prior error"));
        assert_eq!(ui.focus, Some(273));
        assert_eq!(ui.generation, 8);
    }
    #[test]
    fn folder_error_is_recoverable_without_mutating_prior_selection() {
        let mut ui = pending_ui();
        let _ = ui.update(Message::FolderChosen(5, Err("desktop unavailable".into())));
        assert_eq!(ui.picker_error.as_deref(), Some("desktop unavailable"));
        assert!(ui.manual_path);
        assert_eq!(ui.focus, Some(2));
        assert!(ui.controls().iter().any(|(id, _)| *id == 2));
        assert_eq!(ui.reveal_scroller(2), "welcome-sidebar");
        assert_eq!(ui.path, "/original");
        assert!(ui.selected);
        assert!(ui.result);
        assert_eq!(ui.status, "prior verification");
        let _ = ui.update(Message::Path("/manual".into()));
        assert!(ui.picker_error.is_none());
    }

    #[test]
    fn folder_parent_error_keeps_the_existing_parent_input_available() {
        let mut ui = pending_ui();
        ui.surface = Surface::NewProject;
        ui.picker_parent = true;
        let _ = ui.update(Message::FolderChosen(5, Err("desktop unavailable".into())));
        assert!(!ui.manual_path);
        assert_eq!(ui.focus, Some(291));
        assert!(ui.controls().iter().any(|(id, _)| *id == 291));
        assert_eq!(ui.reveal_scroller(291), "main");
    }

    #[test]
    fn event_mapping_keeps_pointer_motion_in_the_drag_subscription() {
        let motion = iced::Event::Mouse(iced::mouse::Event::CursorMoved {
            position: iced::Point::new(240.0, 100.0),
        });
        assert!(map_event(motion.clone(), iced::event::Status::Ignored, true).is_none());
        assert!(matches!(
            map_drag(motion),
            Some(Message::SidebarMove(240.0))
        ));
        for event in [
            iced::Event::Mouse(iced::mouse::Event::CursorLeft),
            iced::Event::Mouse(iced::mouse::Event::ButtonReleased(
                iced::mouse::Button::Left,
            )),
            iced::Event::Window(iced::window::Event::Unfocused),
        ] {
            assert!(matches!(
                map_event(event, iced::event::Status::Captured, true),
                Some(Message::SidebarEnd)
            ));
        }
        assert!(matches!(
            map_event(
                iced::Event::Window(iced::window::Event::Resized(iced::Size::new(640.0, 480.0))),
                iced::event::Status::Ignored,
                true
            ),
            Some(Message::Resize(640.0))
        ));
    }

    #[test]
    fn navigation_shortcuts_respect_capture_and_visible_surface() {
        use iced::keyboard::{Event, Key, Location, Modifiers, key};
        for key in [
            Key::Character("b".into()),
            Key::Character("k".into()),
            Key::Named(key::Named::ArrowLeft),
            Key::Named(key::Named::ArrowRight),
        ] {
            let event = iced::Event::Keyboard(Event::KeyPressed {
                modified_key: key.clone(),
                key,
                physical_key: key::Physical::Code(key::Code::KeyB),
                location: Location::Standard,
                modifiers: Modifiers::CTRL | Modifiers::ALT,
                text: None,
                repeat: false,
            });
            assert!(map_event(event.clone(), iced::event::Status::Captured, true).is_none());
            assert!(map_event(event.clone(), iced::event::Status::Ignored, false).is_none());
            assert!(map_event(event, iced::event::Status::Ignored, true).is_some());
        }
    }

    #[test]
    fn reveal_selects_the_panel_that_contains_the_focused_control() {
        let mut ui = Desktop::default();
        for id in [2, 3, 273, 274] {
            assert_eq!(ui.reveal_scroller(id), "welcome-sidebar");
        }
        for id in [270, 275, 400, 401] {
            assert_eq!(ui.reveal_scroller(id), "main");
        }
        ui.surface = Surface::Settings;
        for id in 220..=224 {
            assert_eq!(ui.reveal_scroller(id), "main");
        }
    }
    #[test]
    fn folder_late_results_after_edit_navigation_or_close_have_no_effect() {
        for action in [
            Message::Path("/edited".into()),
            Message::Navigate(Surface::Tasks),
            Message::Close,
        ] {
            let mut ui = pending_ui();
            let flag = ui.picker.as_ref().unwrap().cancel.clone();
            let _ = ui.update(action);
            assert!(flag.load(Ordering::Relaxed));
            let path = ui.path.clone();
            let selected = ui.selected;
            let _ = ui.update(Message::FolderChosen(5, Ok(Some("/late".into()))));
            assert!(ui.picker.is_none());
            assert!(!ui.busy);
            assert_eq!(ui.path, path);
            assert_eq!(ui.selected, selected);
        }
    }
    #[test]
    fn folder_confirmation_enters_validation_without_executing_task() {
        let mut ui = pending_ui();
        let _ = ui.update(Message::FolderChosen(
            5,
            Ok(Some("/not-an-existing-folder-for-ox".into())),
        ));
        assert_eq!(ui.path, "/not-an-existing-folder-for-ox");
        assert!(ui.busy);
        assert!(!ui.result);
        assert!(!ui.selected);
        assert_eq!(ui.surface, Surface::Start);
