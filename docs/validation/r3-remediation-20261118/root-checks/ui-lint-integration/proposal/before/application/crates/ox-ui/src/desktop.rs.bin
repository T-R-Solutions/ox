use std::{
    fmt::Write as _,
    path::PathBuf,
    sync::{
        Arc, Mutex,
        atomic::{AtomicBool, Ordering},
    },
};
pub type Result = iced::Result;
mod chrome;
mod dock;
mod folder_picker;
mod hint;
mod icons;
mod identity;
