//! Keyboard focus labels use a true overlay and never change control geometry.
use super::Message;
use iced::advanced::{
    Clipboard, Layout, Shell, Widget, layout, mouse, overlay, renderer,
    widget::{Operation, Tree},
};
use iced::{Element, Length, Point, Rectangle, Size, Theme, Vector};
struct Hint<'a> {
    content: Element<'a, Message>,
    label: Element<'a, Message>,
    focused: bool,
}
pub(super) fn focus<'a>(
    content: Element<'a, Message>,
    label: Element<'a, Message>,
    focused: bool,
) -> Element<'a, Message> {
    Element::new(Hint {
        content,
        label,
        focused,
    })
}
impl Widget<Message, Theme, iced::Renderer> for Hint<'_> {
    fn size(&self) -> Size<Length> {
        self.content.as_widget().size()
    }
    fn children(&self) -> Vec<Tree> {
        vec![Tree::new(&self.content), Tree::new(&self.label)]
    }
    fn diff(&self, tree: &mut Tree) {
        tree.diff_children(&[&self.content, &self.label]);
    }
    fn layout(&mut self, tree: &mut Tree, r: &iced::Renderer, l: &layout::Limits) -> layout::Node {
        self.content
            .as_widget_mut()
            .layout(&mut tree.children[0], r, l)
    }
    fn operate(&mut self, t: &mut Tree, l: Layout<'_>, r: &iced::Renderer, o: &mut dyn Operation) {
        self.content
            .as_widget_mut()
            .operate(&mut t.children[0], l, r, o);
    }
    fn update(
        &mut self,
        t: &mut Tree,
        e: &iced::Event,
        l: Layout<'_>,
        c: mouse::Cursor,
        r: &iced::Renderer,
        b: &mut dyn Clipboard,
        s: &mut Shell<'_, Message>,
        v: &Rectangle,
    ) {
        self.content
            .as_widget_mut()
            .update(&mut t.children[0], e, l, c, r, b, s, v);
    }
    fn draw(
        &self,
        t: &Tree,
        r: &mut iced::Renderer,
        th: &Theme,
        s: &renderer::Style,
        l: Layout<'_>,
        c: mouse::Cursor,
        v: &Rectangle,
    ) {
        self.content
            .as_widget()
            .draw(&t.children[0], r, th, s, l, c, v);
    }
    fn mouse_interaction(
        &self,
        t: &Tree,
        l: Layout<'_>,
        c: mouse::Cursor,
        v: &Rectangle,
        r: &iced::Renderer,
    ) -> mouse::Interaction {
        self.content
            .as_widget()
            .mouse_interaction(&t.children[0], l, c, v, r)
    }
    fn overlay<'a>(
        &'a mut self,
        t: &'a mut Tree,
        l: Layout<'a>,
        r: &iced::Renderer,
        v: &Rectangle,
        tr: Vector,
    ) -> Option<overlay::Element<'a, Message, Theme, iced::Renderer>> {
        if self.focused {
            Some(overlay::Element::new(Box::new(Label {
                content: &mut self.label,
                tree: &mut t.children[1],
                anchor: Point::new(
                    l.bounds().x + tr.x,
                    l.bounds().y + l.bounds().height + tr.y + 6.0,
                ),
            })))
        } else {
            self.content
                .as_widget_mut()
                .overlay(&mut t.children[0], l, r, v, tr)
        }
    }
}
struct Label<'a, 'b> {
    content: &'a mut Element<'b, Message>,
    tree: &'a mut Tree,
    anchor: Point,
}
impl overlay::Overlay<Message, Theme, iced::Renderer> for Label<'_, '_> {
    fn layout(&mut self, r: &iced::Renderer, b: Size) -> layout::Node {
        let node =
            self.content
                .as_widget_mut()
                .layout(self.tree, r, &layout::Limits::new(Size::ZERO, b));
        let x = self
            .anchor
            .x
            .min((b.width - node.size().width - 4.0).max(4.0));
        let y = self
            .anchor
            .y
            .min((b.height - node.size().height - 4.0).max(4.0));
        node.move_to(Point::new(x, y))
    }
    fn draw(
        &self,
        r: &mut iced::Renderer,
        t: &Theme,
        s: &renderer::Style,
        l: Layout<'_>,
        c: mouse::Cursor,
    ) {
        self.content.as_widget().draw(
            self.tree,
            r,
            t,
            s,
            l,
            c,
            &Rectangle::with_size(Size::new(f32::MAX, f32::MAX)),
        );
    }
}
