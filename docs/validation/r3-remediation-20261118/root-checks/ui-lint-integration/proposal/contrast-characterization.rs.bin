#[derive(Clone,Copy)]struct Color{r:f32,g:f32,b:f32}
    fn before(a: Color, b: Color) -> f32 {
        let luminance = |c: Color| {
            let linear = |v: f32| {
                if v <= 0.04045 {
                    v / 12.92
                } else {
                    ((v + 0.055) / 1.055).powf(2.4)
                }
            };
            0.2126 * linear(c.r) + 0.7152 * linear(c.g) + 0.0722 * linear(c.b)
        };
        let (a, b) = (luminance(a), luminance(b));
        (a.max(b) + 0.05) / (a.min(b) + 0.05)
    }
    fn after(a: Color, b: Color) -> f32 {
        let luminance = |c: Color| {
            let linear = |v: f32| {
                if v <= 0.04045 {
                    v / 12.92
                } else {
                    ((v + 0.055) / 1.055).powf(2.4)
                }
            };
            0.0722_f32.mul_add(
                linear(c.b),
                0.7152_f32.mul_add(linear(c.g), 0.2126 * linear(c.r)),
            )
        };
        let (a, b) = (luminance(a), luminance(b));
        (a.max(b) + 0.05) / (a.min(b) + 0.05)
    }
