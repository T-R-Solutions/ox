from pathlib import Path
import re, textwrap, subprocess
base=Path('/tmp/ox-r3-ui-lint-proposal-hx9k2w90')
rel=Path('application/crates/ox-ui/src')
p=base/'after'/rel/'desktop/hint.rs'
s=p.read_text()
# Rename only identifier tokens, with Overlay theme/bounds distinct from Widget tree/clipboard.
head,tail=s.split("impl overlay::Overlay<Message, Theme, iced::Renderer> for Label<'_, '_> {")
for old,new in {'r':'renderer','l':'layout','c':'cursor','v':'viewport','o':'operation','tr':'translation','th':'theme','t':'tree','e':'event','b':'clipboard'}.items():
    head=re.sub(r'\b'+old+r'\b',new,head)
# Widget uses style in draw, shell in update.
start=head.index('    fn update('); end=head.index('    fn draw(',start)
head=head[:start]+re.sub(r'\bs\b','shell',head[start:end])+re.sub(r'\bs\b','style',head[end:])
for old,new in {'r':'renderer','l':'layout','c':'cursor','t':'theme','s':'style','b':'bounds','x':'anchor_x','y':'anchor_y'}.items():
    # x/y are fields too, so keep their original names instead.
    if old not in ('x','y'):
        tail=re.sub(r'\b'+old+r'\b',new,tail)
p.write_text(head+"impl overlay::Overlay<Message, Theme, iced::Renderer> for Label<'_, '_> {"+tail)
p=base/'after'/rel/'desktop.rs';s=p.read_text()
assert s.count('fn map_drag(event: iced::Event)')==1
s=s.replace('fn map_drag(event: iced::Event)', 'fn map_drag(event: &iced::Event)')
assert s.count('map_drag(event)')==1 and s.count('map_drag(motion)')==1
s=s.replace('map_drag(event)','map_drag(&event)').replace('map_drag(motion)','map_drag(&motion)');p.write_text(s)
p=base/'after'/rel/'design.rs';s=p.read_text();old='0.2126 * linear(c.r) + 0.7152 * linear(c.g) + 0.0722 * linear(c.b)'
assert s.count(old)==1
s=s.replace(old,'0.0722_f32.mul_add(\n                linear(c.b),\n                0.7152_f32.mul_add(linear(c.g), 0.2126 * linear(c.r)),\n            )')
assert s.split('#[cfg(test)]')[0]==(base/'before'/rel/'design.rs').read_text().split('#[cfg(test)]')[0]
p.write_text(s)
p=base/'after'/rel/'desktop/icons.rs';s=p.read_text()
def brace_end(text,start):
    depth=0
    for i in range(start,len(text)):
        if text[i]=='{':depth+=1
        elif text[i]=='}':
            depth-=1
            if not depth:return i
    raise ValueError('unbalanced')
# Extract the actual existing cog body, without rewriting any quad metadata.
cogbegin=s.index('            // One shared cog'); cogend=s.index('            return;',cogbegin)
cog=textwrap.dedent(s[cogbegin:cogend]).replace('for n in 0..8','for n in 0_u8..8').replace('n as f32','f32::from(n)').replace('origin.x + 6.8 + angle.cos() * 5.6','angle.cos().mul_add(5.6, origin.x + 6.8)').replace('origin.y + 6.8 + angle.sin() * 5.6','angle.sin().mul_add(5.6, origin.y + 6.8)').replace('style.text_color','color')
s=s[:cogbegin]+'            draw_cog(renderer, origin, style.text_color);\n'+s[cogend:]
# Extract the existing exhaustive Kind and Surface dispatches.
kindbegin=s.index('        match self.0 {');kindbrace=s.index('{',kindbegin);kindend=brace_end(s,kindbrace)
kind=textwrap.dedent(s[kindbegin:kindend+1]).replace('match self.0 {','match kind {',1)
destbegin=kind.index('Kind::Destination(surface) => match surface {');destbrace=kind.index('{',destbegin);destend=brace_end(kind,destbrace)
dest=textwrap.dedent(kind[destbrace+1:destend])
kind=kind[:destbegin]+'Kind::Destination(surface) => draw_destination(surface, shape)'+kind[destend+1:]
# Keep exhaustive dispatch and extract only enough of its longest primitive groups
# to meet the existing 100-line limit. Each extracted body is an exact copy.
dest=dest.replace('Surface::AgentSettings => unreachable!', 'Surface::AgentSettings | Surface::Settings => unreachable!')
dest=dest.replace('                Surface::Settings => unreachable!("settings use the shared cog"),\n','') if False else dest
# Dedented indentation is four spaces inside the match.
dest=re.sub(r'^\s*Surface::Settings => unreachable!\("settings use the shared cog"\),\n','',dest,flags=re.M)
arms=[]
for m in re.finditer(r'Surface::(\w+) => \{',dest):
    br=dest.index('{',m.start());en=brace_end(dest,br)
    arms.append((en-m.start(),m.start(),en,m.group(1),textwrap.dedent(dest[br+1:en]).strip()))
helpers=[]
while len(dest.splitlines())+4>94:
    _,st,en,name,body=max(arms,key=lambda a:a[0])
    snake=re.sub(r'(?<!^)(?=[A-Z])','_',name).lower()
    replacement=f'Surface::{name} => draw_{snake}(shape),'
    dest=dest[:st]+replacement+dest[en+1:]
    helpers.append(f'fn draw_{snake}(shape: &mut impl FnMut(f32, f32, f32, f32, bool)) {{\n'+textwrap.indent(body,'    ')+'\n}\n')
    arms=[]
    for m in re.finditer(r'Surface::(\w+) => \{',dest):
        br=dest.index('{',m.start());en=brace_end(dest,br)
        arms.append((en-m.start(),m.start(),en,m.group(1),textwrap.dedent(dest[br+1:en]).strip()))
s=s[:kindbegin]+'        draw_kind(self.0, &mut shape);'+s[kindend+1:]
helpers_text='\nfn draw_cog(renderer: &mut iced::Renderer, origin: Rectangle, color: Color) {\n    use iced::advanced::Renderer as _;\n'+textwrap.indent(cog,'    ')+'}\n\n'
helpers_text+='fn draw_kind(kind: Kind, shape: &mut impl FnMut(f32, f32, f32, f32, bool)) {\n'+textwrap.indent(kind,'    ')+'\n}\n\n'
helpers_text+='fn draw_destination(surface: Surface, shape: &mut impl FnMut(f32, f32, f32, f32, bool)) {\n    match surface {\n'+textwrap.indent(dest.strip(),'        ')+'\n    }\n}\n\n'+'\n'.join(helpers)
pos=s.index('pub(super) fn icon');s=s[:pos]+helpers_text+s[pos:];p.write_text(s)
for f in (base/'after').rglob('*.rs'):
    subprocess.run(['rustfmt','--edition','2024','--config','skip_children=true',str(f)],check=True)
print('proposal prepared outside checkout')
print('extracted glyph groups',len(helpers))
