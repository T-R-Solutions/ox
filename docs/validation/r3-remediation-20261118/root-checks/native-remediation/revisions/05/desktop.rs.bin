//! Real X11 integration. Run explicitly with --ignored on a graphical Linux host.
#![forbid(unsafe_code)]
use std::{
    process::{Child, Command},
    thread,
    time::{Duration, Instant},
};
use x11rb::{connection::Connection, protocol::xproto::*, rust_connection::RustConnection};

type Result<T = ()> = std::result::Result<T, Box<dyn std::error::Error>>;
struct App(Child, std::path::PathBuf, std::path::PathBuf);
impl Drop for App {
    fn drop(&mut self) {
        let _ = self.0.kill();
        let _ = self.0.wait();
    }
}
fn wait_until(mut check: impl FnMut() -> Result<bool>) -> Result {
    let deadline = Instant::now() + Duration::from_secs(15);
    while Instant::now() < deadline {
        if check()? {
            return Ok(());
        }
        thread::sleep(Duration::from_millis(50));
    }
    Err("desktop observation timed out after 15s".into())
}
fn find(conn: &RustConnection, root: Window, pid_atom: Atom, pid: u32) -> Result<Option<Window>> {
    let property = conn
        .get_property(false, root, pid_atom, AtomEnum::CARDINAL, 0, 1)?
        .reply()?;
    if property.value32().and_then(|mut v| v.next()) == Some(pid) {
        return Ok(Some(root));
    }
    for child in conn.query_tree(root)?.reply()?.children {
        if let Some(window) = find(conn, child, pid_atom, pid)? {
            return Ok(Some(window));
        }
    }
    Ok(None)
}
fn launch() -> Result<(App, RustConnection, Window)> {
    launch_binary(std::path::Path::new(env!("CARGO_BIN_EXE_ox")))
}
fn launch_binary(binary: &std::path::Path) -> Result<(App, RustConnection, Window)> {
    let workspace = fixture_directory("workspace")?;
    std::fs::write(workspace.join("sentinel"), b"user content")?;
    launch_in_workspace(binary, &workspace)
}
fn fixture_directory(label: &str) -> Result<std::path::PathBuf> {
    let serial = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)?
        .as_nanos();
    let path =
        std::env::temp_dir().join(format!("oxnative-{label}-{}-{serial}", std::process::id()));
    std::fs::create_dir(&path)?;
    Ok(path)
}
fn launch_in_workspace(
    binary: &std::path::Path,
    workspace: &std::path::Path,
) -> Result<(App, RustConnection, Window)> {
    use std::os::unix::fs::PermissionsExt as _;
    let state = fixture_directory("state")?;
    let fixture_bin = state.join("bin");
    std::fs::create_dir(&fixture_bin)?;
    let picker = fixture_bin.join("zenity");
    // Only the optional dialog provider is doubled. Native input, recovery,
    // canonical project validation, producer and verification stay real.
    std::fs::write(
        &picker,
        b"#!/bin/sh\nprintf invoked > \"$OX_NATIVE_PICKER_MARKER\"\nexit 2\n",
    )?;
    std::fs::set_permissions(&picker, std::fs::Permissions::from_mode(0o700))?;
    let path = std::env::join_paths(std::iter::once(fixture_bin).chain(std::env::split_paths(
        &std::env::var_os("PATH").unwrap_or_default(),
    )))?;
    let (conn, screen) = x11rb::connect(None)?;
    let root = conn.setup().roots[screen].root;
    let atom = conn.intern_atom(false, b"_NET_WM_PID")?.reply()?.atom;
    let mut app = App(
        Command::new(binary)
            .env_remove("WAYLAND_DISPLAY")
            .env("XDG_STATE_HOME", &state)
            .env("PATH", path)
            .env("OX_NATIVE_PICKER_MARKER", state.join("picker-invoked"))
            .current_dir(std::env::temp_dir())
            .spawn()?,
        workspace.canonicalize()?,
        state,
    );
    let mut window = None;
    wait_until(|| {
        if let Some(status) = app.0.try_wait()? {
            return Err(format!("app exited before window: {status}").into());
        }
        window = find(&conn, root, atom, app.0.id())?;
        Ok(window.is_some())
    })?;
    eprintln!(
        "Owned workspace {}, isolated XDG state {}",
        app.1.display(),
        app.2.display()
    );
    Ok((app, conn, window.ok_or("missing window")?))
}
fn title(conn: &RustConnection, window: Window) -> Result<String> {
    let atom = conn.intern_atom(false, b"_NET_WM_NAME")?.reply()?.atom;
    let value = conn
        .get_property(false, window, atom, AtomEnum::ANY, 0, 1024)?
        .reply()?
        .value;
    Ok(String::from_utf8(value)?)
}
fn click(conn: &RustConnection, window: Window, x: i16, y: i16) -> Result {
    use x11rb::protocol::xtest::ConnectionExt as _;
    let root = conn.get_geometry(window)?.reply()?.root;
    let pointer = conn.query_pointer(root)?.reply()?;
    conn.set_input_focus(InputFocus::POINTER_ROOT, window, x11rb::CURRENT_TIME)?
        .check()?;
    conn.configure_window(
        window,
        &ConfigureWindowAux::new().stack_mode(StackMode::ABOVE),
    )?
    .check()?;
    // Use the same XTEST input path for motion and clicks under XWayland.
    let target = conn.translate_coordinates(window, root, x, y)?.reply()?;
    let placement = wait_until(|| {
        conn.xtest_fake_input(
            MOTION_NOTIFY_EVENT,
            0,
            0,
            root,
            target.dst_x,
            target.dst_y,
            0,
        )?
        .check()?;
        conn.flush()?;
        thread::sleep(Duration::from_millis(80));
        let actual = conn.query_pointer(window)?.reply()?;
        Ok(actual.win_x == x && actual.win_y == y)
    });
    let actual = conn.query_pointer(window)?.reply()?;
    eprintln!(
        "pointer target=({x},{y}), actual=({},{}), same_screen={}",
        actual.win_x, actual.win_y, actual.same_screen
    );
    if placement.is_err() || actual.win_x != x || actual.win_y != y {
        conn.xtest_fake_input(
            MOTION_NOTIFY_EVENT,
            0,
            0,
            root,
            pointer.root_x,
            pointer.root_y,
            0,
        )?
        .check()?;
        return Err(
            "graphical session did not honor pointer placement; cannot validate button input"
                .into(),
        );
    }
    conn.xtest_fake_input(BUTTON_PRESS_EVENT, 1, 0, x11rb::NONE, 0, 0, 0)?
        .check()?;
    conn.flush()?;
    thread::sleep(Duration::from_millis(100));
    conn.xtest_fake_input(BUTTON_RELEASE_EVENT, 1, 0, x11rb::NONE, 0, 0, 0)?
        .check()?;
    conn.flush()?;
    thread::sleep(Duration::from_millis(80));
    conn.xtest_fake_input(
        MOTION_NOTIFY_EVENT,
        0,
        0,
        root,
        pointer.root_x,
        pointer.root_y,
        0,
    )?
    .check()?;
    conn.flush()?;
    Ok(())
}
fn capture(conn: &RustConnection, window: Window, name: &str) -> Result<Vec<u8>> {
    let geometry = conn.get_geometry(window)?.reply()?;
    let reply = conn
        .get_image(
            ImageFormat::Z_PIXMAP,
            window,
            0,
            0,
            geometry.width,
            geometry.height,
            u32::MAX,
        )?
        .reply()?;
    if let Ok(directory) = std::env::var("OX_DESKTOP_CAPTURE_DIR") {
        // This harness supports the observed little-endian 24-bit X11 framebuffer only.
        if reply.depth != 24
            || conn.setup().image_byte_order != ImageOrder::LSB_FIRST
            || reply.data.len() != usize::from(geometry.width) * usize::from(geometry.height) * 4
        {
            return Err("unsupported screenshot pixel layout".into());
        }
        let mut ppm = format!("P6\n{} {}\n255\n", geometry.width, geometry.height).into_bytes();
        for pixel in reply.data.as_chunks::<4>().0 {
            ppm.extend_from_slice(&[pixel[2], pixel[1], pixel[0]]);
        }
        std::fs::write(
            std::path::Path::new(&directory).join(format!(
                "{}--{name}.ppm",
                thread::current()
                    .name()
                    .unwrap_or("unnamed")
                    .replace("::", "--")
            )),
            ppm,
        )?;
    }
    Ok(reply.data)
}
fn successful_exit(app: &mut App) -> Result {
    wait_until(|| match app.0.try_wait()? {
        Some(status) if status.success() => Ok(true),
        Some(status) => Err(format!("shutdown failed: {status}").into()),
        None => Ok(false),
    })
}
fn scaled_dimension(logical: u16, scale: f32) -> Result<u16> {
    let scaled = (f32::from(logical) * scale).trunc();
    if !scaled.is_finite() || !(1.0..=f32::from(u16::MAX)).contains(&scaled) {
        return Err("scaled X11 dimension outside [1, 65535]".into());
    }
    #[expect(
        clippy::cast_possible_truncation,
        clippy::cast_sign_loss,
        reason = "Finite, integral, positive value checked against u16 bounds above"
    )]
    let pixels = scaled as u16;
    Ok(pixels)
}

fn type_ascii(conn: &RustConnection, value: &str) -> Result {
    use x11rb::protocol::xtest::ConnectionExt as _;
    let setup = conn.setup();
    let mapping = conn
        .get_keyboard_mapping(setup.min_keycode, setup.max_keycode - setup.min_keycode + 1)?
        .reply()?;
    for byte in value.bytes() {
        let index = mapping
            .keysyms
            .chunks(usize::from(mapping.keysyms_per_keycode))
            .position(|symbols| symbols.first() == Some(&u32::from(byte)))
            .ok_or("ASCII key unavailable in unshifted mapping")?;
        let key = setup.min_keycode + u8::try_from(index)?;
        conn.xtest_fake_input(KEY_PRESS_EVENT, key, 0, x11rb::NONE, 0, 0, 0)?
            .check()?;
        conn.xtest_fake_input(KEY_RELEASE_EVENT, key, 0, x11rb::NONE, 0, 0, 0)?
            .check()?;
        conn.flush()?;
        thread::sleep(Duration::from_millis(15));
    }
    Ok(())
}

fn key(conn: &RustConnection, keysym: u32) -> Result {
    use x11rb::protocol::xtest::ConnectionExt as _;
    let setup = conn.setup();
    let mapping = conn
        .get_keyboard_mapping(setup.min_keycode, setup.max_keycode - setup.min_keycode + 1)?
        .reply()?;
    let index = mapping
        .keysyms
        .chunks(usize::from(mapping.keysyms_per_keycode))
        .position(|symbols| symbols.first() == Some(&keysym))
        .ok_or("keysym unavailable")?;
    let code = setup.min_keycode + u8::try_from(index)?;
    for event in [KEY_PRESS_EVENT, KEY_RELEASE_EVENT] {
        conn.xtest_fake_input(event, code, 0, x11rb::NONE, 0, 0, 0)?
            .check()?;
    }
    conn.flush()?;
    Ok(())
}

fn window_pixels(conn: &RustConnection, window: Window) -> Result<Vec<u8>> {
    let g = conn.get_geometry(window)?.reply()?;
    Ok(conn
        .get_image(
            ImageFormat::Z_PIXMAP,
            window,
            0,
            0,
            g.width,
            g.height,
            u32::MAX,
        )?
        .reply()?
        .data)
}
fn wait_render_change(conn: &RustConnection, window: Window, before: &[u8]) -> Result {
    wait_until(|| Ok(window_pixels(conn, window)? != before))?;
    // Acknowledgement is pixel-based; this settling interval is driver-only,
    // never included in response samples.
    thread::sleep(Duration::from_millis(120));
    Ok(())
}
fn visible_key(conn: &RustConnection, window: Window, keysym: u32) -> Result {
    let before = window_pixels(conn, window)?;
    key(conn, keysym)?;
    wait_render_change(conn, window, &before)
}
fn file_anchor(conn: &RustConnection, window: Window) -> Result {
    let before = window_pixels(conn, window)?;
    click(conn, window, 220, 24)?;
    wait_render_change(conn, window, &before)?;
    visible_key(conn, window, 0xff1b)
}
fn key_state(conn: &RustConnection, keysym: u32, pressed: bool) -> Result {
    use x11rb::protocol::xtest::ConnectionExt as _;
    let setup = conn.setup();
    let mapping = conn
        .get_keyboard_mapping(setup.min_keycode, setup.max_keycode - setup.min_keycode + 1)?
        .reply()?;
    let index = mapping
        .keysyms
        .chunks(usize::from(mapping.keysyms_per_keycode))
        .position(|symbols| symbols.first() == Some(&keysym))
        .ok_or("keysym unavailable")?;
    let code = setup.min_keycode + u8::try_from(index)?;
    conn.xtest_fake_input(
        if pressed {
            KEY_PRESS_EVENT
        } else {
            KEY_RELEASE_EVENT
        },
        code,
        0,
        x11rb::NONE,
        0,
        0,
        0,
    )?
    .check()?;
    conn.flush()?;
    Ok(())
}
fn chord(conn: &RustConnection, modifier: u32, letter: u32) -> Result {
    key_state(conn, modifier, true)?;
    let action = key(conn, letter);
    let released = key_state(conn, modifier, false);
    action?;
    released
}
fn tabs(conn: &RustConnection, count: usize, backwards: bool) -> Result {
    let window = conn.get_input_focus()?.reply()?.focus;
    let before = window_pixels(conn, window)?;
    for _ in 0..count {
        if backwards {
            chord(conn, 0xffe1, 0xff09)?;
        } else {
            key(conn, 0xff09)?;
        }
        thread::sleep(Duration::from_millis(15));
    }
    if count > 0 {
        wait_render_change(conn, window, &before)?;
    }
    Ok(())
}
fn open_fixture_project(app: &App, conn: &RustConnection, window: Window) -> Result {
    wait_until(
        || Ok(conn.get_window_attributes(window)?.reply()?.map_state == MapState::VIEWABLE),
    )?;
    conn.set_input_focus(InputFocus::POINTER_ROOT, window, x11rb::CURRENT_TIME)?
        .check()?;
    conn.flush()?;
    // Welcome traversal starts at Preferences, New project, then Open folder.
    thread::sleep(Duration::from_millis(250));
    tabs(conn, 3, false)?;
    key(conn, 0xff0d)?;
    wait_until(|| Ok(app.2.join("picker-invoked").is_file()))?;
    thread::sleep(Duration::from_millis(150));
    capture(conn, window, "manual-recovery-focused")?;
    type_ascii(conn, app.1.to_str().ok_or("fixture path is not UTF-8")?)?;
    key(conn, 0xff0d)?;
    let project = app
        .1
        .file_name()
        .and_then(|name| name.to_str())
        .ok_or("missing project identity")?;
    let expected = format!("Tarefas — {project} — Ox");
    wait_until(|| Ok(title(conn, window)?.starts_with(&expected)))?;
    thread::sleep(Duration::from_millis(100));
    assert_eq!(std::fs::read(app.1.join("sentinel"))?, b"user content");
    Ok(())
}
fn navigate(conn: &RustConnection, window: Window, code: &str, expected: &str) -> Result {
    // Public menu traversal provides a stable anchor even when a text input
    // intentionally captures shortcuts: File -> Escape -> View -> Tools -> Go to.
    file_anchor(conn, window)?;
    tabs(conn, 3, false)?;
    visible_key(conn, window, 0xff0d)?;
    type_ascii(conn, code)?;
    visible_key(conn, window, 0xff0d)?;
    wait_until(|| Ok(title(conn, window)?.starts_with(expected)))?;
    thread::sleep(Duration::from_millis(100));
    Ok(())
}
fn task_action(conn: &RustConnection, window: Window, action: usize) -> Result {
    use ox_ui::workbench::Surface;
    navigate(conn, window, "s04", "Tarefas — ")?;
    // Driver selector, not a result oracle: public destination metadata defines
    // sidebar traversal. Each case retains only the initial Tasks document tab.
    let sidebar = Surface::ALL
        .iter()
        .filter(|s| {
            !matches!(
                s,
                Surface::Start
                    | Surface::NewProject
                    | Surface::Settings
                    | Surface::Appearance
                    | Surface::Problems
                    | Surface::Tests
                    | Surface::Trace
                    | Surface::Terminal
            )
        })
        .count();
    let offset = match action {
        4..=7 => action - 3,
        9 => 5,
        10 => 6,
        _ => return Err("unsupported task action".into()),
    };
    tabs(conn, 3 + sidebar + 2 + 2 + offset, false)?;
    key(conn, 0xff0d)
}
fn toggle_details(conn: &RustConnection, window: Window) -> Result {
    navigate(conn, window, "s04", "Tarefas — ")?;
    // Actual fixed-width Exibir menu in the maintained IDE chrome.
    let before = window_pixels(conn, window)?;
    click(conn, window, 312, 24)?;
    wait_render_change(conn, window, &before)?;
    tabs(conn, 6, false)?;
    visible_key(conn, window, 0xff0d)?;
    navigate(conn, window, "s04", "Tarefas — ")
}
fn quit_action(conn: &RustConnection, window: Window) -> Result {
    file_anchor(conn, window)?;
    visible_key(conn, window, 0xff0d)?; // Keyboard activation of the actual File trigger.
    tabs(conn, 3, false)?; // Central, New, Open, Quit.
    key(conn, 0xff0d)
}
fn native_close(conn: &RustConnection, window: Window) -> Result {
    let protocols = conn.intern_atom(false, b"WM_PROTOCOLS")?.reply()?.atom;
    let delete = conn.intern_atom(false, b"WM_DELETE_WINDOW")?.reply()?.atom;
    conn.send_event(
        false,
        window,
        EventMask::NO_EVENT,
        ClientMessageEvent::new(32, window, protocols, [delete, 0, 0, 0, 0]),
    )?
    .check()?;
    conn.flush()?;
    Ok(())
}
fn attempt(workspace: &std::path::Path) -> Result<std::path::PathBuf> {
    let mut result = None;
    wait_until(|| {
        result = std::fs::read_dir(workspace)?
            .filter_map(std::result::Result::ok)
            .map(|p| p.path())
            .find(|p| p.join("result.txt").is_file());
        Ok(result.is_some())
    })?;
    result.ok_or_else(|| "missing attempt".into())
}
fn oracle_pid(attempt: &std::path::Path) -> Result<u32> {
    let mut pid = None;
    wait_until(|| {
        pid = std::fs::read_to_string(attempt.join("oracle-ready"))
            .ok()
            .and_then(|p| p.parse().ok());
        Ok(pid.is_some())
    })?;
    pid.ok_or_else(|| "missing supervised oracle pid".into())
}
fn cancel_action(conn: &RustConnection, window: Window) -> Result {
    navigate(conn, window, "s04", "Tarefas — ")?;
    tabs(conn, 4, false)?; // Global Cancel follows Preferences while busy.
    key(conn, 0xff0d)
}
fn owned_producers(app: &App) -> Result<Vec<u32>> {
    let mut children = Vec::new();
    for task in std::fs::read_dir(format!("/proc/{}/task", app.0.id()))? {
        let task = task?;
        if let Ok(ids) = std::fs::read_to_string(task.path().join("children")) {
            for child in ids.split_whitespace() {
                if let Ok(cmd) = std::fs::read(format!("/proc/{child}/cmdline")) {
                    if cmd
                        .split(|b| *b == 0)
                        .next()
                        .is_some_and(|arg| arg.ends_with(b"/local-task"))
                    {
                        children.push(child.parse()?);
                    }
                }
            }
        }
    }
    children.sort_unstable();
    children.dedup();
    Ok(children)
}

#[test]
#[ignore = "requires a dedicated X11 graphical session; explicit desktop acceptance run"]
fn real_window_toggle_and_exit_button() -> Result {
    let (mut app, conn, window) = launch()?;
    open_fixture_project(&app, &conn, window)?;
    navigate(&conn, window, "s04", "Tarefas — ")?;
    let identity = title(&conn, window)?;
    let before = capture(&conn, window, "collapsed")?;
    toggle_details(&conn, window)?;
    let expanded = capture(&conn, window, "expanded")?;
    assert_ne!(
        before, expanded,
        "details action must change actual rendered pixels"
    );
    assert_eq!(
        title(&conn, window)?,
        identity,
        "details are not project/window identity"
    );
    toggle_details(&conn, window)?;
    let restored = capture(&conn, window, "recollapsed")?;
    assert_ne!(
        expanded, restored,
        "second action must collapse the detail content"
    );
    quit_action(&conn, window)?;
    successful_exit(&mut app)
}
#[test]
#[ignore = "requires a dedicated X11 graphical session; explicit desktop acceptance run"]
fn native_close_returns_success() -> Result {
    let (mut app, conn, window) = launch()?;
    native_close(&conn, window)?;
    successful_exit(&mut app)
}
#[test]
#[ignore = "requires dedicated X11 keyboard input and visual focus inspection"]
fn keyboard_focus_activation_and_exit() -> Result {
    let (mut app, conn, window) = launch()?;
    open_fixture_project(&app, &conn, window)?;
    file_anchor(&conn, window)?;
    let before = capture(&conn, window, "keyboard-before-focus")?;
    tabs(&conn, 1, false)?; // File -> View by actual keyboard traversal.
    thread::sleep(Duration::from_millis(100));
    let focused = capture(&conn, window, "keyboard-view-focus")?;
    assert_ne!(
        before, focused,
        "native keyboard traversal must render its focus"
    );
    visible_key(&conn, window, 0xff0d)?;
    let opened = capture(&conn, window, "keyboard-view-menu")?;
    assert_ne!(focused, opened, "Return must activate the focused menu");
    visible_key(&conn, window, 0xff1b)?;
    quit_action(&conn, window)?;
    successful_exit(&mut app)
}
#[test]
#[ignore = "requires dedicated X11; measures input-to-observed-pixel response, not compositor presentation"]
fn visual_response_and_window_matrix() -> Result {
    let scale: f32 = std::env::var("WINIT_X11_SCALE_FACTOR")
        .ok()
        .and_then(|s| s.parse().ok())
        .unwrap_or(1.0);
    let (mut app, conn, window) = launch()?;
    open_fixture_project(&app, &conn, window)?;
    navigate(&conn, window, "s04", "Tarefas — ")?;
    let pixels = || -> Result<Vec<u8>> {
        Ok(conn
            .get_image(
                ImageFormat::Z_PIXMAP,
                window,
                0,
                0,
                scaled_dimension(400, scale)?,
                scaled_dimension(200, scale)?,
                u32::MAX,
            )?
            .reply()?
            .data)
    };
    let root_window = conn.get_geometry(window)?.reply()?.root;
    let target = conn
        .translate_coordinates(window, root_window, 28, 24)?
        .reply()?;
    {
        use x11rb::protocol::xtest::ConnectionExt as _;
        conn.xtest_fake_input(
            MOTION_NOTIFY_EVENT,
            0,
            0,
            root_window,
            target.dst_x,
            target.dst_y,
            0,
        )?
        .check()?;
        conn.flush()?;
    }
    wait_until(|| {
        let pointer = conn.query_pointer(window)?.reply()?;
        Ok(pointer.win_x == 28 && pointer.win_y == 24)
    })?;
    thread::sleep(Duration::from_millis(200));
    for iteration in 0..23 {
        let before = pixels()?;
        let start = Instant::now();
        {
            use x11rb::protocol::xtest::ConnectionExt as _;
            conn.xtest_fake_input(BUTTON_PRESS_EVENT, 1, 0, root_window, 0, 0, 0)?
                .check()?;
            conn.xtest_fake_input(BUTTON_RELEASE_EVENT, 1, 0, root_window, 0, 0, 0)?
                .check()?;
            conn.flush()?;
        }
        loop {
            if pixels()? != before {
                break;
            }
            if start.elapsed() > Duration::from_secs(2) {
                return Err("no rendered response".into());
            }
            thread::sleep(Duration::from_millis(2));
        }
        assert!(
            start.elapsed() <= Duration::from_secs(2),
            "observed response exceeded two seconds"
        );
        if iteration >= 3 {
            eprintln!(
                "VISUAL_RESPONSE_MS={:.6}",
                start.elapsed().as_secs_f64() * 1000.0
            );
        }
        thread::sleep(Duration::from_millis(30));
    }
    for (logical_width, logical_height) in [(640_u16, 480_u16), (900, 700)] {
        let width = u32::from(scaled_dimension(logical_width, scale)?);
        let height = u32::from(scaled_dimension(logical_height, scale)?);
        conn.configure_window(
            window,
            &ConfigureWindowAux::new().width(width).height(height),
        )?
        .check()?;
        conn.flush()?;
        wait_until(|| {
            let g = conn.get_geometry(window)?.reply()?;
            Ok(u32::from(g.width) == width && u32::from(g.height) == height)
        })?;
        thread::sleep(Duration::from_millis(200));
        capture(&conn, window, &format!("size-{width}-{height}"))?;
        let before = capture(&conn, window, &format!("scroll-before-{width}-{height}"))?;
        key(&conn, 0xff56)?;
        thread::sleep(Duration::from_millis(100));
        let after = capture(&conn, window, &format!("scroll-after-{width}-{height}"))?;
        if logical_height == 480 {
            assert!(
                before != after,
                "keyboard scrolling must expose hidden content"
            );
        }
        key(&conn, 0xff55)?;
        thread::sleep(Duration::from_millis(100));
    }
    eprintln!(
        "GUI_PROC_STATUS_BEGIN\n{}GUI_PROC_STATUS_END",
        std::fs::read_to_string(format!("/proc/{}/status", app.0.id()))?
    );
    let idle_before = std::fs::read_to_string(format!("/proc/{}/stat", app.0.id()))?;
    let idle_start = Instant::now();
    thread::sleep(Duration::from_secs(1));
    let idle_after = std::fs::read_to_string(format!("/proc/{}/stat", app.0.id()))?;
    eprintln!(
        "GUI_IDLE_SECONDS={}\nGUI_STAT_BEFORE={}\nGUI_STAT_AFTER={}",
        idle_start.elapsed().as_secs_f64(),
        idle_before.trim(),
        idle_after.trim()
    );
    quit_action(&conn, window)?;
    successful_exit(&mut app)
}
#[test]
#[ignore = "requires dedicated X11 and built held-task-oracle fixture"]
fn cancel_verification_observes_oracle_exit_in_ui() -> Result {
    let workspace = fixture_directory("held")?;
    std::fs::write(workspace.join("sentinel"), b"user content")?;
    let bins = workspace.join("bins");
    std::fs::create_dir(&bins)?;
    let built = std::path::Path::new(env!("CARGO_BIN_EXE_ox"))
        .parent()
        .ok_or("bin parent")?;
    for (source, target) in [
        ("ox", "ox"),
        ("local-task", "local-task"),
        ("held-task-oracle", "task-oracle"),
    ] {
        std::fs::copy(built.join(source), bins.join(target))?;
    }
    let (mut app, conn, window) = launch_in_workspace(&bins.join("ox"), &workspace)?;
    open_fixture_project(&app, &conn, window)?;
    task_action(&conn, window, 4)?;
    let attempt = attempt(&workspace)?;
    thread::sleep(Duration::from_millis(150));
    task_action(&conn, window, 9)?;
    let pid = oracle_pid(&attempt)?;
    assert!(
        std::path::Path::new(&format!("/proc/{pid}")).exists(),
        "held oracle must be alive before UI interaction"
    );
    navigate(&conn, window, "s04", "Tarefas — ")?;
    let before = capture(&conn, window, "held-before-responsive")?;
    toggle_details(&conn, window)?;
    let after = capture(&conn, window, "held-verification-responsive")?;
    assert_ne!(
        before, after,
        "rendered UI must respond while verification is held"
    );
    assert!(
        std::path::Path::new(&format!("/proc/{pid}")).exists(),
        "responsiveness must be observed before oracle termination"
    );
    cancel_action(&conn, window)?;
    wait_until(|| Ok(!std::path::Path::new(&format!("/proc/{pid}")).exists()))?;
    thread::sleep(Duration::from_millis(150));
    capture(&conn, window, "cancelled-verification")?;
    std::fs::remove_file(attempt.join("oracle-ready"))?;
    task_action(&conn, window, 9)?;
    let second = oracle_pid(&attempt)?;
    assert!(
        std::path::Path::new(&format!("/proc/{second}")).exists(),
        "second held oracle must be alive immediately before native close"
    );
    native_close(&conn, window)?;
    successful_exit(&mut app)?;
    assert!(!std::path::Path::new(&format!("/proc/{second}")).exists());
    assert_eq!(std::fs::read(workspace.join("sentinel"))?, b"user content");
    Ok(())
}
#[test]
#[ignore = "requires dedicated X11 input and visual review of captured frames"]
fn local_task_rendered_flow() -> Result {
    let (mut app, conn, window) = launch()?;
    open_fixture_project(&app, &conn, window)?;
    task_action(&conn, window, 4)?;
    let attempt = attempt(&app.1)?;
    let mut expected = std::fs::read(attempt.join("request.txt"))?;
    expected.extend_from_slice(b"result=42\n");
    assert_eq!(std::fs::read(attempt.join("result.txt"))?, expected);
    thread::sleep(Duration::from_millis(150));
    task_action(&conn, window, 9)?;
    thread::sleep(Duration::from_millis(300));
    capture(&conn, window, "correct-verdict")?;
    std::fs::write(attempt.join("result.txt"), b"incorrect controlled result")?;
    task_action(&conn, window, 10)?;
    thread::sleep(Duration::from_millis(200));
    capture(&conn, window, "stale-verdict")?;
    task_action(&conn, window, 9)?;
    thread::sleep(Duration::from_millis(200));
    capture(&conn, window, "incorrect-verdict")?;
    task_action(&conn, window, 7)?;
    let mut producers = Vec::new();
    wait_until(|| {
        producers = owned_producers(&app)?;
        Ok(!producers.is_empty())
    })?;
    navigate(&conn, window, "s04", "Tarefas — ")?;
    let before = capture(&conn, window, "before-responsive-during-task")?;
    assert!(
        producers
            .iter()
            .all(|pid| std::path::Path::new(&format!("/proc/{pid}")).exists())
    );
    toggle_details(&conn, window)?;
    let responsive = capture(&conn, window, "responsive-during-task")?;
    assert_ne!(
        before, responsive,
        "rendered content must respond during active execution"
    );
    assert!(
        producers
            .iter()
            .all(|pid| std::path::Path::new(&format!("/proc/{pid}")).exists())
    );
    native_close(&conn, window)?;
    successful_exit(&mut app)?;
    assert!(
        producers
            .iter()
            .all(|pid| !std::path::Path::new(&format!("/proc/{pid}")).exists())
    );
    assert_eq!(std::fs::read(app.1.join("sentinel"))?, b"user content");
    Ok(())
}
