from pathlib import Path
import subprocess, os, json, hashlib, time
root = Path("/home/rodrigo/Projetos/ox")
snapshot = Path("/tmp/ox-r3-doc-render-png-01")
expected = json.loads((snapshot / "inputs-before.json").read_text())
for rel, sha in expected.items():
    assert hashlib.sha256((root / rel).read_bytes()).hexdigest() == sha
    assert hashlib.sha256((snapshot / rel).read_bytes()).hexdigest() == sha
report = snapshot / "docs/validation/documentation-png-20261119"
assert not report.exists()
report.mkdir(parents=True)
report.chmod(0o777)
cmd = ["docker", "run", "--rm", "--pull=never", "--network", "none", "--read-only", "--user", "1000:1000", "--shm-size", "1g", "--tmpfs", "/tmp:rw,mode=1777", "-e", "HOME=/tmp", "-e", "XDG_CACHE_HOME=/tmp/cache", "-e", "OX_DOC_TOOLS=/tools", "-e", "PLAYWRIGHT_BROWSERS_PATH=/opt/browsers", "-e", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1", "-v", str(snapshot) + ":/work:rw,z", "-v", "/tmp/ox-r3-doc-tools-vqfy7qf3:/tools:ro,z", "--entrypoint", "node", "sha256:003685704fc47891bc21b70fbb95ae3794963d9efe046ace1e90eaf770f56f9e", "/work/docs/assets/render-png.mjs"]
start = time.monotonic()
with (snapshot / "stdout.log").open("wb") as out, (snapshot / "stderr.log").open("wb") as err:
    run = subprocess.run(cmd, stdout=out, stderr=err, check=False)
after = {rel: hashlib.sha256((root / rel).read_bytes()).hexdigest() for rel in expected}
snapshot_after = {rel: hashlib.sha256((snapshot / rel).read_bytes()).hexdigest() for rel in expected}
(snapshot / "result.json").write_text(json.dumps({"command": cmd, "exit_code": run.returncode, "seconds": time.monotonic() - start, "inputs_before": expected, "inputs_after": after, "snapshot_inputs_after": snapshot_after, "inputs_unchanged": expected == after == snapshot_after, "executor_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}, indent=2) + "\n")
print("render exit", run.returncode, "inputs unchanged", expected == after == snapshot_after)
raise SystemExit(run.returncode if run.returncode else int(expected != after or expected != snapshot_after))
