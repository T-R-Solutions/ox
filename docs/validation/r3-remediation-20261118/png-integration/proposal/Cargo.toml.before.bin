[workspace]
exclude = ["vendor/cryoglyph-0.1.0"]
resolver = "3"
members = [
    "crates/ox-app",
    "crates/ox-ui",
    "crates/ox-core",
    "crates/ox-agent",
    "crates/ox-plugin",
    "crates/ox-policy",
    "crates/ox-task",
    "crates/ox-workspace",
    "crates/ox-storage",
    "crates/ox-context",
    "crates/ox-graph",
    "crates/ox-output",
    "crates/ox-verification",
    "crates/ox-observability",
    "crates/ox-sdd",
    "crates/ox-skills",
]

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.99"
license = "GPL-3.0-only"
publish = false

[workspace.dependencies]
iced = { version = "=0.14.0", default-features = false, features = ["tiny-skia", "x11", "wayland", "fira-sans", "thread-pool", "advanced", "image-without-codecs"] }
ox-ui = { path = "crates/ox-ui", version = "=0.1.0" }

[workspace.lints.rust]
unsafe_code = "forbid"

[profile.dev]
debug = 0

# Keep software rasterization responsive while first-party dev code stays unoptimized.
[profile.dev.package.tiny-skia]
opt-level = 3

# Backport the upstream lru security dependency bump without changing Iced/wgpu.
[patch.crates-io]
cryoglyph = { path = "vendor/cryoglyph-0.1.0" }
