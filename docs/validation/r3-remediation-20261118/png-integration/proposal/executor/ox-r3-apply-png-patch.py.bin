from pathlib import Path
import hashlib, json, shutil
root = Path("/home/rodrigo/Projetos/ox")
proposal = Path("/tmp/ox-r3-dependency-dedup-proposal")
receipt = root / "docs/validation/r3-remediation-20261118/png-integration"
assert not receipt.exists(), "receipt already exists"
for name in ("Cargo.toml", "Cargo.lock"):
    assert (root / "application" / name).read_bytes() == (proposal / (name + ".before.bin")).read_bytes(), name + " changed"
new_test = root / "application/crates/ox-ui/tests/png_assets.rs"
new_vendor = root / "application/vendor/png-0.18.1"
assert not new_test.exists() and not new_vendor.exists(), "new path already exists"
expected = json.loads((proposal / "installation-proposal.json").read_text())
source = proposal / "vendor-install/png-0.18.1"
actual = {str(p.relative_to(source)): hashlib.sha256(p.read_bytes()).hexdigest() for p in source.rglob("*") if p.is_file()}
assert actual == expected["vendor_files"], "vendor proposal drift"
assert hashlib.sha256((proposal / "png_assets.rs").read_bytes()).hexdigest() == expected["test_sha256"]
for name, key in (("Cargo.toml", "workspace_manifest_sha256"), ("Cargo.lock", "workspace_lock_sha256")):
    assert hashlib.sha256((proposal / "workspace" / name).read_bytes()).hexdigest() == expected[key], name + " proposal drift"
receipt.mkdir()
for name in ("Cargo.toml", "Cargo.lock"):
    shutil.copy2(root / "application" / name, receipt / (name + ".before.bin"))
shutil.copytree(source, new_vendor)
shutil.copy2(proposal / "png_assets.rs", new_test)
for name in ("Cargo.toml", "Cargo.lock"):
    shutil.copy2(proposal / "workspace" / name, root / "application" / name)
changed = [root / "application/Cargo.toml", root / "application/Cargo.lock", new_test, *[p for p in new_vendor.rglob("*") if p.is_file()]]
(receipt / "integration.json").write_text(json.dumps({"preconditions": "all old bytes and all new proposal hashes checked before first write", "files": {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in changed}, "hashbrown": "still an acceptance blocker; no exception or indexmap acquisition"}, indent=2) + "\n")
print(receipt)
