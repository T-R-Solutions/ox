{
  "schema_version": 2,
  "environment": "Linux local checkout (development, dirty tree preserved); Rust offline build; isolated headless Mutter for captures",
  "requirements": [
    {
      "id": "AC-01",
      "criterion": "tokens.json and tokens.rs agree (build_design --check exit 0); check_contrast reports 0 failures; design.rs focus/contrast tests pass for Menu and Tab roles in every theme.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "E-TOKENS",
        "E-RUST"
      ],
      "reason": "Observed by the implementing agent only; independent review/validation not performed in this session, so no criterion is approved here."
    },
    {
      "id": "AC-02",
      "criterion": "menu traversal is modal; Escape and outside click close and return focus to the trigger without executing an item; items dispatch existing messages; title omits theme/density; captures show the bar at 1024, 1600 and 2560 widths.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "E-RUST",
        "E-NATIVE"
      ],
      "reason": "Observed by the implementing agent only; independent review/validation not performed in this session, so no criterion is approved here."
    },
    {
      "id": "AC-03",
      "criterion": "tabs open/activate/close, the last tab is not closable, at most 8; dock navigation keeps the document and execution state; Ctrl+J toggles; every Surface is reachable through sidebar, menus or palette.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "E-RUST",
        "E-NATIVE"
      ],
      "reason": "Observed by the implementing agent only; independent review/validation not performed in this session, so no criterion is approved here."
    },
    {
      "id": "AC-04",
      "criterion": "the dependency notice appears once; the badge shows only on task surfaces; the measured page content is ≤ 1200 units at 2560 while the editor uses the full width.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "E-RUST",
        "E-NATIVE"
      ],
      "reason": "Observed by the implementing agent only; independent review/validation not performed in this session, so no criterion is approved here."
    },
    {
      "id": "AC-05",
      "criterion": "filtered recents keep MRU order and ids; filter is in traversal only with recents; captures show tiles, \"Em breve\" tag and empty state.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "E-RUST",
        "E-NATIVE"
      ],
      "reason": "Observed by the implementing agent only; independent review/validation not performed in this session, so no criterion is approved here."
    },
    {
      "id": "AC-06",
      "criterion": "cargo fmt, default clippy and workspace tests pass; the complete Toolbox run is executed and its result recorded; pre-existing failures are distinguished from new ones.",
      "status": "INCONCLUSIVE",
      "evidence_ids": [
        "E-RUST",
        "E-PEDANTIC"
      ],
      "reason": "Complete Toolbox run executed (exit 2): governance-tests, scripts-tests, pedantic clippy, deny, audit, osv and geiger did not pass; none of their inputs was changed by this task except clippy, whose findings are in unchanged code. Not approved."
    },
    {
      "id": "AC-07",
      "criterion": "maintainer visual acceptance of the captures or the running app.",
      "status": "APPROVED",
      "evidence_ids": [
        "E-R3-MAINTAINER-VISUAL"
      ],
      "reason": "Maintainer explicitly approved the captured set identified by the immutable visual index. This decision applies only to visual judgment; technical criteria remain independently assessed."
    }
  ],
