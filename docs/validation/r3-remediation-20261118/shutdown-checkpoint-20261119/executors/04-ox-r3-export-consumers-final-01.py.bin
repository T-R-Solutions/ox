import datetime,hashlib,json,os,subprocess,sys,time
from pathlib import Path
origin=Path('/home/rodrigo/Projetos/ox')
root=Path('/var/tmp/ox-r3-final-verification-XltM2HKX/export-final-01')
out=Path('/tmp/ox-r3-export-consumers-final-01');out.mkdir(exist_ok=False)
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
if not root.is_dir() or root.is_symlink() or root.stat().st_uid!=os.getuid():raise SystemExit('Expected owned fresh export')
export_manifest=root/'export-manifest.json'
assert export_manifest.is_file()
observer_identity=sha(Path(__file__)); export_manifest_identity=sha(export_manifest)
(out/'observation-inputs-before.json').write_text(json.dumps({'observer_sha256':observer_identity,'export_manifest_sha256':export_manifest_identity,'python':sys.version,'executable':sys.executable},indent=2)+'\n')
manifest=json.loads(export_manifest.read_text())
assert {str(p.relative_to(root)) for p in root.rglob('*') if p.is_file()} - {'export-manifest.json'} == set(manifest),'Extra or missing export paths before baseline'
assert all((root/name).is_file() and sha(root/name)==value for name,value in manifest.items()),'Export changed before demonstration'
project=root/'sdd/project.md';log=root/'task_finalizada.md'
original_project=project.read_bytes();original_log=log.read_bytes()
(out/'project-before.bin').write_bytes(original_project);(out/'log-before.bin').write_bytes(original_log)
inputs={name:sha(root/name) for name in manifest}
(out/'inputs-before.json').write_text(json.dumps(inputs,indent=2)+'\n')
rows=[]
def observe(name,valid,diagnostic=None):
 cmd=[sys.executable,'tools/governance/scripts/isolated-run.py',str(origin),'tools/governance/scripts/check-ox.py']
 start=time.monotonic()
 with (out/(name+'.stdout.log')).open('wb') as stdout,(out/(name+'.stderr.log')).open('wb') as stderr:
  run=subprocess.run(cmd,cwd=root,env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1'),stdout=stdout,stderr=stderr,check=False)
 text=(out/(name+'.stdout.log')).read_text(errors='replace')+(out/(name+'.stderr.log')).read_text(errors='replace')
 passed=(run.returncode==0 and 'PASS: local profile' in text) if valid else (run.returncode in (1,2) and diagnostic in text)
 row={'name':name,'command':cmd,'cwd':str(root),'exit_code':run.returncode,'expected':'valid' if valid else 'rejected','specific_diagnostic':diagnostic,'oracle_satisfied':passed,'seconds':time.monotonic()-start,'project_sha256':sha(project),'log_sha256':sha(log)}
 rows.append(row);(out/'partial-results.json').write_text(json.dumps(rows,indent=2)+'\n');print(json.dumps(row),flush=True)
 if not passed:raise RuntimeError('Oracle failed: '+name)
try:
 observe('01-baseline',True)
 project.write_bytes(original_project+b'\n## Authorized disposable distribution verification\n\nContextual authorization example confined to this exported fixture.\n')
 observe('02-legitimate-authorization',True)
 log.write_bytes(original_log+b'\n## Disposable exported verification observation\n\nAppend-only demonstration entry in exported fixture only.\n')
 assert log.read_bytes().startswith(original_log)
 observe('03-append-only-log',True)
 legitimate=project.read_bytes();assert b'## Authorities' in legitimate
 project.write_bytes(legitimate.replace(b'## Authorities',b'## Missing authorities',1))
 observe('04-protected-contract-rejected',False,'Authority protected section changed/missing: sdd/project.md: Authorities')
 project.write_bytes(legitimate)
 observe('05-restored-legitimate',True)
finally:
 project.write_bytes(original_project);log.write_bytes(original_log)
 changes=[name for name,value in inputs.items() if not (root/name).is_file() or sha(root/name)!=value]
 actual_names={str(p.relative_to(root)) for p in root.rglob('*') if p.is_file()} - {'export-manifest.json'}
 changes += sorted(actual_names.symmetric_difference(inputs))
 if sha(Path(__file__))!=observer_identity:changes.append('external observer changed')
 if sha(export_manifest)!=export_manifest_identity:changes.append('export-manifest.json changed')
 (out/'result.json').write_text(json.dumps({'time_utc':datetime.datetime.now(datetime.UTC).isoformat(),'script_sha256':observer_identity,'script_after_sha256':sha(Path(__file__)),'source_export_manifest_sha256':export_manifest_identity,'source_export_manifest_after_sha256':sha(export_manifest),'results':rows,'restored_input_changes':changes,'all_oracles_satisfied':len(rows)==5 and all(r['oracle_satisfied'] for r in rows) and not changes,'limitations':['Only the exported copy was mutated; root source and log remain untouched.','Python audit-hook independence is the maintained copy boundary, not an OS sandbox.','Manifest equality is observed before/after, not a hostile-writer atomic snapshot.']},indent=2)+'\n')

if changes or len(rows)!=5 or not all(r['oracle_satisfied'] for r in rows):raise SystemExit(1)
