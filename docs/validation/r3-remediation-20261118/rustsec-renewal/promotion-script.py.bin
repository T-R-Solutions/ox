from pathlib import Path
import fcntl
import hashlib
import json
import os
import shutil
import subprocess

root = Path('/home/rodrigo/Projetos/ox')
record = Path('/tmp/ox-r3-rustsec-renewal-proposal')
base = root / '.cache/ox/security'
registry = base / 'datasets.json'
before = (record / 'datasets-before.json').read_bytes()
assert hashlib.sha256(before).hexdigest() == 'ed77fa460e45783356f5b0175b034b6aa8ceeb15e94d3ce0301b8f40c19a38d9'
prepared_root = record / 'preparation-root'
prepared = json.loads((prepared_root / '.cache/ox/security/datasets.json').read_bytes())
old = json.loads(before)
row = prepared['rustsec']
source = (prepared_root / row['path']).parent
target = base / 'generations/prepared-r3-20261118-472a4c9a'

def identity(path):
    result = subprocess.run(['/bin/bash', '-c',
        'source scripts/lib/common.sh; source scripts/lib/files.sh; tree_identity "$1"',
        'ox-rustsec-identity', str(path)], cwd=root, capture_output=True, check=True)
    return result.stdout.decode().strip()

for path in (base, base / 'generations', registry, base / 'prepare.lock'):
    assert not path.is_symlink(), str(path)
fd = os.open(base / 'prepare.lock', os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, 'w') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    assert registry.read_bytes() == before, 'registry changed since authorized proposal'
    old_path = root / old['rustsec']['path']
    old_identity = identity(old_path)
    assert old_identity == old['rustsec']['sha256'], 'old generation drift'
    assert not target.exists() and not target.is_symlink()
    assert identity(source / 'rustsec') == row['sha256']
    shutil.copytree(source, target, symlinks=False)
    assert identity(target / 'rustsec') == row['sha256']
    assert identity(old_path) == old_identity
    updated = json.loads(before)
    updated['rustsec'] = dict(row, path=str((target / 'rustsec').relative_to(root)))
    temp = base / 'datasets-r3-20261118.next'
    data = (json.dumps(updated, indent=2) + '\n').encode()
    with temp.open('xb') as output:
        output.write(data)
        output.flush()
        os.fsync(output.fileno())
    assert registry.read_bytes() == before
    os.replace(temp, registry)
    (record / 'datasets-after.json').write_bytes(registry.read_bytes())
    (record / 'promotion.json').write_text(json.dumps({
        'registry_before_sha256': hashlib.sha256(before).hexdigest(),
        'registry_after_sha256': hashlib.sha256(data).hexdigest(),
        'old_generation': old['rustsec'], 'old_generation_unchanged': identity(old_path) == old_identity,
        'new_generation': updated['rustsec'], 'new_identity_confirmed': identity(target / 'rustsec') == row['sha256'],
        'scope': 'Only one local RustSec generation and registry entry. No old generation deletion, no TTL or central changes.'
    }, indent=2) + '\n')
print('Promoted exact authorized RustSec generation; old generation preserved.')
