import hashlib,json,sys,time
from pathlib import Path
root=Path('/home/rodrigo/Projetos/ox')
sys.path.insert(0,str(root/'tools/governance/tests'))
sys.path.insert(0,str(root/'tools/governance/scripts'))
from test_instruction_succession import InstructionSuccessionTests
import document_ledger as ledger
import instruction_revision as instruction
import audit_revision as audit
out=Path('/tmp/ox-r3-consumer-demonstration-final-03')
out.mkdir(exist_ok=False)
fixture=InstructionSuccessionTests('test_exact_transition_and_unknown_mutation');fixture.setUp()
copy=fixture.root
(copy/'task_finalizada.md').write_bytes((root/'task_finalizada.md').read_bytes())
initial={str(p.relative_to(copy)):hashlib.sha256(p.read_bytes()).hexdigest() for p in copy.rglob('*') if p.is_file()}
(out/'initial-inputs.json').write_text(json.dumps(initial,indent=2)+'\n')
rows=[]
def observe(name,expected):
 start=time.time();errors=[]
 errors+=instruction.errors(copy)
 errors+=audit.errors(copy)
 for authority in ledger.AUTHORITIES:
  try:ledger.predecessor(copy,authority,(copy/authority).read_bytes())
  except ValueError as e:errors.append(str(e))
 passed=not errors
 expected_diagnostic = {'protected-authority-removal':'Authority protected section changed/missing: sdd/project.md: Authorities','historical-evidence-corruption':'Authority historical terminal changed: sdd/project.md','historical-project-downgrade':'Document ledger predecessor downgrade: sdd/project.md'}.get(name)
 diagnostic_confirmed = expected_diagnostic is None or any(expected_diagnostic in error for error in errors)
 rows.append(dict(name=name,expected=expected,observed='valid' if passed else 'rejected',oracle_satisfied=passed==(expected=='valid') and diagnostic_confirmed,expected_diagnostic=expected_diagnostic,duration=time.time()-start,diagnostics=errors,project_sha256=hashlib.sha256((copy/'sdd/project.md').read_bytes()).hexdigest(),log_sha256=hashlib.sha256((copy/'task_finalizada.md').read_bytes()).hexdigest()))
 print(name,rows[-1]['observed'],flush=True)
try:
 observe('baseline','valid')
 p=copy/'sdd/project.md';original=p.read_bytes();allowed=original+b'\n## Authorized isolated verification experiment\n\nAuthorization statement in disposable fixture only.\n';p.write_bytes(allowed)
 observe('legitimate-authorization-section','valid')
 log=copy/'task_finalizada.md';prefix=log.read_bytes();log.write_bytes(prefix+b'\n## Isolated append-only verification observation\n\nDisposable fixture record, no product permission.\n');assert log.read_bytes().startswith(prefix)
 observe('append-only-log-entry','valid')
 p.write_bytes(allowed.replace(b'## Authorities',b'## Missing authorities',1));observe('protected-authority-removal','rejected');p.write_bytes(allowed)
 terminal=copy/ledger.AUTHORITY_TERMINALS/'sdd/project.md.bin';saved=terminal.read_bytes();terminal.write_bytes(saved+b'corrupt evidence');observe('historical-evidence-corruption','rejected');terminal.write_bytes(saved)
 p.write_bytes((copy/ledger.records(copy)['sdd/project.md']['previous']).read_bytes());observe('historical-project-downgrade','rejected');p.write_bytes(allowed)
 observe('restored-valid-copy','valid')
 result={'fixture':str(copy),'kind':'compact physical consumer fixture; not a governance export/package','files':len(initial),'bytes':sum(p.stat().st_size for p in copy.rglob('*') if p.is_file()),'oracles':['instruction_revision.errors','audit_revision.errors','document_ledger.predecessor (three authorities)'],'results':rows,'all_oracles_satisfied':all(r['oracle_satisfied'] for r in rows),'limitations':['Does not replace full check-ox, distribution, package extraction or feature acceptance.','Only disposable copies were edited; live authorization and task log were not changed.']}
 (out/'result.json').write_text(json.dumps(result,indent=2)+'\n')
finally:fixture.doCleanups()

raise SystemExit(0 if result["all_oracles_satisfied"] else 1)
