"""Focused producer/parser failure characterization; no scanner execution."""
import hashlib
import json
import os
import subprocess
import tempfile
from pathlib import Path

ROOT = Path.cwd()
LINE = b'FAIL: Broken/escaping link: docs/source.md: ../target.md\n'
rows = []
for fail in ('none', 'head_initial', 'head_bounded', 'mv', 'sha256sum', 'jq'):
    with tempfile.TemporaryDirectory(prefix='ox-bandit-repair-') as temporary:
        root = Path(temporary)
        directory = root / 'run'
        directory.mkdir()
        (root / 'docs').mkdir()
        (root / 'docs/source.md').write_text('[target](../target.md)\n')
        (directory / 'stdout.log').write_bytes(LINE)
        (directory / 'stderr.log').write_bytes(b'')
        (directory / 'result.json').write_text('{"state":"failed","exit_code":37}')
        (directory / 'assessment.json').write_text('{"state":"findings","tool_exit_code":37}')
        authorities = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
                       for p in directory.iterdir()}
        command = r'''
source "$1/scripts/lib/common.sh"
source "$1/scripts/lib/process.sh"
source "$1/scripts/lib/progress.sh"
ROOT=$3
head() {
    if [[ $FAIL == head_initial && $2 == 65537 ]] || [[ $FAIL == head_bounded && $2 == 65536 ]]; then
        printf 'injected head failure\n' >&2; return 71
    fi
    command head "$@"
}
mv() { if [[ $FAIL == mv ]]; then return 72; fi; command mv "$@"; }
sha256sum() { if [[ $FAIL == sha256sum ]]; then return 73; fi; command sha256sum "$@"; }
jq() { if [[ $FAIL == jq && $1 == -Rsc ]]; then return 74; fi; command jq "$@"; }
progress_governance_project "$2"
'''
        result = subprocess.run(['/bin/bash', '-c', command, '_', str(ROOT), str(directory), str(root)],
                                env=dict(os.environ, FAIL=fail), capture_output=True, timeout=5)
        expected = 0 if fail == 'none' else 2
        assert result.returncode == expected, (fail, result.returncode, result.stderr)
        assert {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
                for p in directory.iterdir() if p.name in authorities} == authorities
        if fail == 'none':
            projection = json.loads(result.stdout)
            assert projection['streams'][0]['recognized'] == 1
            assert not list(directory.glob('*.bounded'))
        rows.append({'case': fail, 'expected_exit': expected, 'actual_exit': result.returncode,
                     'raw_result_assessment_unchanged': True})
print(json.dumps({'cases': rows}, indent=2))
