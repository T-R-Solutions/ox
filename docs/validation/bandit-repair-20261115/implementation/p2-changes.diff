+    def test_sample_hashes_ignore_directory_filename_escaping(self):
+        raw = LINE * 2
+        expected_hash = hashlib.sha256(raw).hexdigest()
+        for name in ('ordinary', 'back\\slash', 'line\nbreak'):
+            with self.subTest(directory=name):
+                self.directory = self.root / name
+                self.directory.mkdir()
+                projection = self.project(raw)
+                self.assertEqual(projection['selected'], ['stdout'])
+                out = projection['streams'][0]
+                self.assertEqual(out['recognized'], 2)
+                self.assertEqual(sum(group['count'] for group in out['groups']), 2)
+                self.assertFalse(out['truncated'])
+                self.assertEqual(out['raw_sha256'], expected_hash)
+                self.assertEqual(out['sample_sha256'], expected_hash)
+                self.assertEqual((self.directory / 'stdout.log').read_bytes(), raw)
 
 
