# Entrada do projeto: triagem Sol; execução no orquestrador Astra selecionado.
# Uso e limites: docs/development/codex-agents.md.
model = "gpt-6.1-sol"
model_reasoning_effort = "medium"
developer_instructions = """
Leia e siga obrigatoriamente docs/development/codex-agents.md, procedimento
canônico de entrada, triagem, delegação, capacidades e retomada.
A sessão raiz é a entrada Sol médio e aplica diretamente ec_triador; não crie
outro triador para repetir a análise. Encaminhe execução ao orquestrador do perfil
selecionado, dentro das capacidades e permissões reais. Após a entrega, acompanhe
e encaminhe mensagens como ponte, conforme o procedimento canônico.
"""
[agents]
enabled = true
max_concurrent_threads_per_session = 3
default_subagent_model = "gpt-6.1-sol"
default_subagent_reasoning_effort = "high"
