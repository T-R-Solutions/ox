"""Real shell/filesystem tests of lifecycle boundaries; no scanner mocks needed."""
from pathlib import Path
import fcntl
import os
import shutil
from types import SimpleNamespace
import support as S
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[2]
ENTRY = ROOT / 'scripts/local.sh'


class LocalLifecycleTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix='ox-local-')
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.runs = self.root / '.local/checks'
        self.runs.mkdir(parents=True)
        self.run = self.runs / 'run-fixture'
        self.run.mkdir()
        (self.run / '.owner').write_text('ox-local-v1\n')
        (self.run / '.state').write_text('complete\n')
        (self.run / '.lease').touch()
        (self.run / 'raw.log').write_bytes(b'raw\x00failure\n')
        (self.run / 'source').mkdir()
        (self.run / 'source/input').write_text('unique input')
        self.keep = self.root / 'docs/validation/retained'
        self.keep.parent.mkdir(parents=True)
        shutil.copytree(self.run, self.keep)

    def cli(self, *args, ok=True):
        with tempfile.TemporaryDirectory(dir=self.root) as output:
            process = S.execute(['/bin/bash', str(ENTRY), '--root', str(self.root), *args], self.root, os.environ, output)
            result = SimpleNamespace(returncode=process['exit_code'],
                                     stdout=(Path(output) / 'stdout.log').read_text(),
                                     stderr=(Path(output) / 'stderr.log').read_text())
        if ok:
            self.assertEqual(result.returncode, 0, result.stderr)
        else:
            self.assertNotEqual(result.returncode, 0)
        return result

    def release(self):
        return self.cli('--release', self.run.name, '--retained', 'docs/validation/retained')

    def test_dry_run_then_real_delete_and_repeat(self):
        self.release()
        result = self.cli()
        self.assertIn('eligible-retained-copy', result.stdout)
        self.assertTrue(self.run.exists())
        self.assertFalse((self.root / '.local/records').exists())
        self.cli('--apply')
        self.assertFalse(self.run.exists())
        self.assertEqual((self.keep / 'raw.log').read_bytes(), b'raw\x00failure\n')
        self.cli('--apply')
        self.cli('--apply')
        self.assertEqual(len(list((self.root / '.local/records').glob('cleanup*.json'))), 2)

    def test_pinned_and_unrecognized_are_preserved(self):
        self.cli('--apply')
        self.assertTrue(self.run.exists())
        (self.run / '.owner').unlink()
        self.cli('--apply')
        self.assertTrue(self.run.exists())

    def test_retained_difference_prevents_release(self):
        (self.keep / 'raw.log').write_text('different')
        self.release_failure()

    def release_failure(self):
        self.cli('--release', self.run.name, '--retained', 'docs/validation/retained', ok=False)
        self.assertTrue(self.run.exists())

    def test_changed_payload_or_retained_blocks_deletion(self):
        self.release()
        (self.keep / 'raw.log').write_text('changed after release')
        self.assertIn('protected-retention-mismatch', self.cli('--apply').stdout)
        self.assertTrue(self.run.exists())

    def test_active_run_blocks_release_and_collection(self):
        self.release()
        with (self.run / '.lease').open('w') as lease:
            fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.release_failure()
            self.assertIn('protected-active', self.cli('--apply').stdout)
            self.assertTrue(self.run.exists())

    def test_symlinks_and_special_files_are_preserved(self):
        self.release()
        (self.run / 'escape').symlink_to(self.keep, target_is_directory=True)
        self.assertIn('protected-nonregular', self.cli('--apply').stdout)
        self.assertTrue(self.run.exists())
        self.assertTrue((self.keep / 'raw.log').exists())

    def test_symlinked_parent_refused(self):
        shutil.rmtree(self.runs)
        self.runs.symlink_to(self.keep, target_is_directory=True)
        self.cli('--apply', ok=False)
        self.assertTrue((self.keep / 'raw.log').exists())

    def test_traversal_release_refused(self):
        self.cli('--release', '../run-fixture', '--retained', 'docs/validation/retained', ok=False)
        self.cli('--release', self.run.name, '--retained', 'docs/validation/../../../escape', ok=False)

    def test_incomplete_run_refused(self):
        (self.run / '.state').write_text('pinned')
        self.release_failure()

    def test_repeat_release(self):
        self.release()
        self.release()
        self.cli('--apply')
        self.assertFalse(self.run.exists())

    def test_partial_trash_recovery(self):
        self.release()
        trash = self.root / '.local/records/trash'
        trash.mkdir(parents=True)
        shutil.copyfile(self.run / '.release.json', trash / '.ticket-run-fixture.json')
        target = trash / self.run.name
        self.run.rename(target)
        (target / 'raw.log').unlink()
        (target / '.owner').unlink()
        self.assertIn('eligible-trash-resume', self.cli().stdout)
        self.assertTrue(target.exists())
        self.cli('--apply')
        self.assertFalse(target.exists())
        self.assertTrue((self.keep / 'raw.log').exists())

    def test_pre_rename_interruption_recovery(self):
        self.release()
        trash = self.root / '.local/records/trash'
        trash.mkdir(parents=True)
        shutil.copyfile(self.run / '.release.json', trash / '.ticket-run-fixture.json')
        self.cli('--apply')
        self.assertFalse(self.run.exists())

    def test_collector_lock(self):
        self.release()
        with (self.root / '.local/.maintenance.lock').open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.cli('--apply', ok=False)
            self.assertTrue(self.run.exists())

    def test_unowned_trash_is_never_removed(self):
        trash = self.root / '.local/records/trash/run-unknown'
        trash.mkdir(parents=True)
        (trash / 'unique').write_text('preserve')
        self.cli('--apply')
        self.assertTrue((trash / 'unique').exists())

    def test_new_producer_metadata_and_lease(self):
        code = 'source "$1/scripts/lib/common.sh"; ROOT=$2; d=$(new_run run); run_lease "$d"; run_complete "$d"; printf "%s" "$d"'
        run = Path(S.shell(code, ROOT, self.root).decode())
        self.assertEqual(run.parent, self.runs)
        self.assertEqual((run / '.owner').read_text().strip(), 'ox-local-v1')
        self.assertEqual((run / '.state').read_text().strip(), 'complete')

    def test_empty_directory_difference_prevents_release(self):
        (self.run / 'unique-empty-directory').mkdir()
        self.release_failure()

    def test_special_fifo_prevents_cleanup(self):
        self.release()
        os.mkfifo(self.run / 'fifo')
        self.assertIn('protected-nonregular', self.cli('--apply').stdout)
        self.assertTrue(self.run.exists())

    def test_partial_trash_changed_bytes_are_protected(self):
        self.release()
        trash = self.root / '.local/records/trash'
        trash.mkdir(parents=True)
        shutil.copyfile(self.run / '.release.json', trash / '.ticket-run-fixture.json')
        target = trash / self.run.name
        self.run.rename(target)
        (target / 'raw.log').write_text('unexpected concurrent bytes')
        self.assertIn('protected-retention-mismatch', self.cli('--apply').stdout)
        self.assertTrue(target.exists())

    def test_symlinked_audit_destination_refused(self):
        records = self.root / '.local/records'
        records.mkdir()
        (records / 'cleanup.json').symlink_to(self.keep / 'raw.log')
        self.cli('--apply', ok=False)
        self.assertEqual((self.keep / 'raw.log').read_bytes(), b'raw\x00failure\n')

    def test_query_path_does_not_create_runtime_state(self):
        result = self.cli('--path', 'records')
        self.assertEqual(result.stdout.strip(), str(self.root / '.local/records'))
        self.assertFalse((self.root / '.local/.maintenance.lock').exists())
        self.assertFalse((self.root / '.local/records').exists())
