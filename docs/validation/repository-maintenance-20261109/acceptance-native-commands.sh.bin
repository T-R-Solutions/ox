#!/bin/bash
export TOOLBOX_BIN=/home/rodrigo/Projetos/dev_audit/shared-toolbox/bin/toolbox
export TOOLBOX_SELINUX_LABEL=shared
result=0
bash scripts/toolbox.sh exec --tool ruff --project-root /tmp/ox-maintenance-native --timeout 120 --diagnostic-file /tmp/ox-maintenance-harness-ruff-diagnostic.json -- check --config /project/scripts/config/ruff.toml --ignore-noqa --no-fix --no-cache --output-format json /project/docs/validation/repository-maintenance-20261109/acceptance.py > /tmp/ox-maintenance-harness-ruff.txt 2> /tmp/ox-maintenance-harness-ruff.stderr
code=$?
printf 'ruff exit: %s\n' "$code"
if ((code)); then result=$code; fi
bash scripts/toolbox.sh exec --tool bandit --project-root /tmp/ox-maintenance-native --timeout 120 --diagnostic-file /tmp/ox-maintenance-harness-bandit-diagnostic.json -- --configfile /project/scripts/config/bandit.yaml --ini /project/scripts/config/bandit.ini --ignore-nosec --baseline /project/scripts/config/bandit-baseline.json -f json /project/docs/validation/repository-maintenance-20261109/acceptance.py > /tmp/ox-maintenance-harness-bandit.txt 2> /tmp/ox-maintenance-harness-bandit.stderr
code=$?
printf 'bandit exit: %s\n' "$code"
if ((code)); then result=$code; fi
exit "$result"
