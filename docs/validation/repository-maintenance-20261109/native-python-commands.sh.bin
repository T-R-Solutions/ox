#!/bin/bash
export TOOLBOX_BIN=/home/rodrigo/Projetos/dev_audit/shared-toolbox/bin/toolbox
export TOOLBOX_SELINUX_LABEL=shared
result=0
bash scripts/toolbox.sh exec --tool ruff --project-root /tmp/ox-maintenance-native --timeout 120 --diagnostic-file /tmp/ox-maintenance-ruff-diagnostic.json -- check --config /project/scripts/config/ruff.toml --ignore-noqa --no-fix --no-cache --output-format json /project/scripts/tests/test_local_lifecycle.py /project/tools/governance/scripts/closure_revision.py /project/tools/governance/tests/test_maintenance_succession.py /project/tools/governance/tests/test_task_closure.py /project/tools/governance/tests/test_native_exec_succession.py /project/tools/governance/tests/test_readme_skill_integration.py /project/tools/governance/tests/test_scanner_succession.py > /tmp/ox-maintenance-ruff.txt 2> /tmp/ox-maintenance-ruff.stderr
code=$?
printf 'ruff exit: %s\n' "$code"
if ((code)); then result=$code; fi
bash scripts/toolbox.sh exec --tool bandit --project-root /tmp/ox-maintenance-native --timeout 120 --diagnostic-file /tmp/ox-maintenance-bandit-diagnostic.json -- --configfile /project/scripts/config/bandit.yaml --ini /project/scripts/config/bandit.ini --ignore-nosec --baseline /project/scripts/config/bandit-baseline.json -f json /project/scripts/tests/test_local_lifecycle.py /project/tools/governance/scripts/closure_revision.py /project/tools/governance/tests/test_maintenance_succession.py /project/tools/governance/tests/test_task_closure.py /project/tools/governance/tests/test_native_exec_succession.py /project/tools/governance/tests/test_readme_skill_integration.py /project/tools/governance/tests/test_scanner_succession.py > /tmp/ox-maintenance-bandit.txt 2> /tmp/ox-maintenance-bandit.stderr
code=$?
printf 'bandit exit: %s\n' "$code"
if ((code)); then result=$code; fi
exit "$result"
