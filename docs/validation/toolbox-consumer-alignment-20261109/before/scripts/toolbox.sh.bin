#!/usr/bin/env bash
set -euo pipefail
((BASH_VERSINFO[0]>4 || (BASH_VERSINFO[0]==4 && BASH_VERSINFO[1]>=4))) || { echo "Bash 4.4+ required" >&2; exit 125; }
# Shared labels permit concurrent readers of tool-owned databases and caches.
# Explicit empty/private overrides remain available to callers.
if [[ ${1-} == exec && ! ${TOOLBOX_SELINUX_LABEL+x} ]]; then
    export TOOLBOX_SELINUX_LABEL=shared
fi
if [[ ${TOOLBOX_BIN+x} ]]; then
    [[ -x "$TOOLBOX_BIN" && ! -d "$TOOLBOX_BIN" ]] || { echo 'TOOLBOX_BIN must name an executable' >&2; exit 125; }
    exec "$TOOLBOX_BIN" "$@"
fi
command -v toolbox >/dev/null || { echo 'Set TOOLBOX_BIN or add toolbox to PATH' >&2; exit 125; }
exec toolbox "$@"
