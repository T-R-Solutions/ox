# No license grants have been adopted for third-party distribution.
# An empty allowlist is intentional: identify all licenses needing review.
[graph]
targets = ["x86_64-unknown-linux-gnu"]
[licenses]
allow = []
confidence-threshold = 0.95
[licenses.private]
ignore = false
[bans]
multiple-versions = "deny"
wildcards = "deny"
highlight = "all"
[sources]
unknown-registry = "deny"
unknown-git = "deny"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
allow-git = []
